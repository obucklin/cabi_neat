ELSE
_EXECUTELEADINOUT := 0
END
IF _EXECUTELEADINOUT=1
WZF (9999,_VE,_V,_VA,_SD,_ANF,'1')
CALL LeadInOutKontur_V7 ()
/CALL _Kreisbahn_V5 ( VAL X_MITTE:=-50,Y_MITTE:=Y_Pos,TIEFE:=1,ZUTIEFE:=0,RADIUS:=50,RADIUSKORREKTUR:=1,AB:=0,AUFMASS:=0,BEARB_UMKEHREN:=0,WINKEL:=180,ANF:=_ANF,ABF:=_ANF,RAMPE:=0,INTERPOL:=1,ESXY:=1,ESMD:=0,LASER:=0)
CALL _Kreisbahn_V5 ( VAL X_MITTE:=-18.5,Y_MITTE:=Y_Pos,TIEFE:=1,ZUTIEFE:=0,RADIUS:=18.5,RADIUSKORREKTUR:=1,AB:=0,AUFMASS:=0,BEARB_UMKEHREN:=0,WINKEL:=180,ANF:=_ANF,ABF:=_ANF,RAMPE:=0,INTERPOL:=1,ESXY:=1,ESMD:=0,LASER:=0)
END
WZB (501,_VE,_V,_VA,_SD,_ANF,'51')
Bohrung (-18.5,Y_Pos,35,-2,30,0,0,1,1,0,0,0)
WZF (1,_VE,_V,_VA,_SD,_ANF,'1')
SP (-18.5,Y_Pos,_Rz / 2,0,0,_ANF,0,0,0,1,1,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (Tiefe,0,0,0,10,2)
G01 (- Tiefe,0,0,0,10,2)
EP (0,_ANF,0)
