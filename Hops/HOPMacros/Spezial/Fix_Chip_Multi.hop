   CB10 :=0;*VAR*FixChip10 On/Off
   CB11 :=0;*VAR*FixChip11 On/Off
   CB12 :=0;*VAR*FixChip11 On/Off
   X1 :=DZ/2;*VAR*
   Y1 :=60.00;*VAR*
   X2 :=DZ/2;*VAR*
   Y2 :=0.00;*VAR*
   X3 :=DZ/2;*VAR*
   Y3 :=60.00;*VAR*
   X4 :=60.00;*VAR*
