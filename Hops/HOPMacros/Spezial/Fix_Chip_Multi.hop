G01 ((Tiefe+1),0,0,0,10,2)
G01 (- (Tiefe+1),0,0,0,10,2)
EP (0,_ANF,0)
IF MassL= -1
CALL B2Punkte_V7 ( VAL P1X:=0,P1Y:=0,P2X:=0,P2Y:=Y1,ABSTAND:=-20,FARBE:=0,TEXT:='',TEXTHOEHE:=20,PFEILLAENGE:=20,PFEILEINNERHALB:=0,WCS:=1,ESXY1:=1,ESXY2:=1)
