;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   DX := 600;Dimension X
   DY := 400;Dimension Y
   DZ := 19;Dimension Z
   Stirn_Wkz :=1;*VAR*Wkz zur Kantenbearbeitung
   Vert_Wkz :=6;*VAR*Wkz zur flachseitigen Bearbeitung
   VorB_Wkz :=501;*VAR*Wkz Vorbohren
   Maschine :=1;*VAR*Maschine 0= Normale 1= Nesting
   Art :=1;*VAR*0= Stirnseitig / 1=Flachseitig
   Tiefe :=13.00;*VAR*Tiefe FixChip horizontal
   V_Tiefe :=13.00;*VAR*Tiefe FixChip vertikal
   Z_Hoehe :=DZ / 2;*VAR*Höhe FixChip
   Tiefe_VB :=DZ -1;*VAR*Tiefe Vorbohren FixChip
   Z_Zu :=5.00;*VAR*Zustellung in Z
   Bohren := 1;35 mm Bohren 1= ja / 0= Nein
   MassL :=-1;*VAR*Masslinien anzeigen
   EXECUTELEADINOUT := 0;
   CB1 :=0;*VAR*FixChip1 On/Off
   CB2 :=0;*VAR*FixChip2 On/Off
   CB3 :=0;*VAR*FixChip3 On/Off
   CB4 :=0;*VAR*FixChip4 On/Off
   CB5 :=0;*VAR*FixChip5 On/Off
   CB6 :=0;*VAR*FixChip6 On/Off
   CB7 :=0;*VAR*FixChip7 On/Off
   CB8 :=0;*VAR*FixChip8 On/Off
