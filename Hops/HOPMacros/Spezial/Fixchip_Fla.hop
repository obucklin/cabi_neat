VARS
   DX := 600;Dimension X
   DY := 400;Dimension Y
   DZ := 19;Dimension Z
   ToolID := 3;*VAR*
   X_Pos := 0;*VAR*X Position
   Y_Pos := 0;*VAR*Y-Wert
   Tiefe := 13;Nuttiefe
   ZuS := 3;*VAR*Z Zustellung
   Seite := 4;*VAR*1= Vorne / 2=Links /3= hinten / 4= Rechts
START
Fertigteil (DX,DY,DZ,0,0,0,0,0,'',0,0,0)
;Weinig Holzher Schweiz AG B. Achermann
WZF (ToolID,_VE,_V,_VA,_SD,_ANF,'1')
IF Seite = 1
;Vorne
SP (X_Pos,Y_Pos,0,0,0,_ANF,0,0,0,0,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (17,0,-2.5,0,10,2)
G01 (-34,0,-2.5,0,10,2)
G01 (34,0,-2.5,0,10,2)
G01 (-34,0,-2.5,0,10,2)
G01 (34,0,-2.5,0,10,2)
G01 (-34,0,-0.5,0,10,2)
G01 (34,0,0,0,10,2)
G01 (-17,0,0,0,10,2)
