G01 (-34,0,-0.5,0,10,2)
G01 (34,0,0,0,10,2)
G01 (-17,0,0,0,10,2)
EP (0,_ANF,0)
END
IF Seite = 2
;Links
SP (X_Pos,Y_Pos,0,0,0,_ANF,0,0,0,0,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (0,17,-2.5,0,10,2);BREAKPOINT
G01 (0,-34,-2.5,0,10,2)
G01 (0,34,-2.5,0,10,2)
G01 (0,-34,-2.5,0,10,2)
G01 (0,34,-2.5,0,10,2)
G01 (0,-34,-0.5,0,10,2)
G01 (0,34,0,0,10,2)
G01 (0,-17,0,0,10,2)
EP (0,_ANF,0)
END
IF Seite = 3
;Hinten
SP (X_Pos,Y_Pos,0,0,0,_ANF,0,0,0,0,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (17,0,-2.5,0,10,2)
G01 (-34,0,-2.5,0,10,2)
G01 (34,0,-2.5,0,10,2)
G01 (-34,0,-2.5,0,10,2)
G01 (34,0,-2.5,0,10,2)
G01 (-34,0,-0.5,0,10,2)
G01 (34,0,0,0,10,2)
G01 (-17,0,0,0,10,2)
