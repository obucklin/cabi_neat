END
IF Seite = 4
;Rechts
SP (X_Pos,Y_Pos,0,0,0,_ANF,0,0,0,0,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (0,17,-2.5,0,10,2)
G01 (0,-34,-2.5,0,10,2)
G01 (0,34,-2.5,0,10,2)
