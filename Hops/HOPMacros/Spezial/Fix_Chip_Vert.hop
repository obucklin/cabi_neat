VARS
   DX := 600;*VAR*Dimension X
   DY := 400;*VAR*Dimension Y
   DZ := 19;*VAR*Dimension Z
   X_Pos := _RZ / 2;*VAR*X Position
   Y_Pos := 60;*VAR*Y-Position
START
Fertigteil (DX,DY,DZ,0,0,0,0,0,'',0,0,0)
WZF (6,_VE,_V,_VA,_SD,_ANF,'1')
SP (X_Pos,Y_Pos,0,0,0,_ANF,0,0,0,1,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
