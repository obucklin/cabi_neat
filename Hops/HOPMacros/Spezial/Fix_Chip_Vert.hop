G01 (X_Pos,(Y_Pos  + (20 -  _WzR)),-10,0,1,0)
G01 (X_Pos,(Y_Pos  - (20 -  _WzR)),-10,0,1,0)
G01 (X_Pos,(Y_Pos  + (20 -  _WzR)),-13,0,1,0)
G01 (X_Pos,(Y_Pos  - (20 -  _WzR)),-13,0,1,0)
