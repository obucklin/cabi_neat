;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.8.0.2[Hops.exe]
;BILD=DRILL_H_PIN_HH.WMF
;INFO=
;WZGV=7405_967
;WZGVCONFIG=
;MASCHINE=HolzHer
;NCNAME=DRILL_H_PIN_HH
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0.000
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   x := 0;*VAR*X Position
   y := 0;*VAR*Y Position
   z := 0;*VAR*Z Position von Unterkante
   d := 0;*VAR*Durchmesser
   Tiefe := 0;*VAR*Negativ Wert
   KW_BO := 0;*VAR*Kippwinkel Bohrung
   DREHWINKEL := 90;*VAR*Drehwinkel / Seite1(vorne)=90° / Seite2(links)=0° / Seite3(hinten)=270° / Seite4(rechts)=180°
   Seite_L_R := 0;*VAR*Seite 0=links 1=rechts
   Leim := 1;*VAR*Leim 1=ja
   Pin := 1;*VAR*Pin 1=ja
   Bohren := 1;*VAR*Bohren 1=ja
   ausstand := 15;*VAR*Dübelausstand
   time := 500;*VAR*Zeit Leim c.a. 500
   PIN_L := 40;*VAR*Dübellänge 30/35/40
   Par1 := 0;*VAR*Parameter 1
   Par2 := 0;*VAR*Parameter 2
   STRPar := '';*VAR*Parameter 2
START
;HOLZHER GmbH
;Copyright 15.02.2021
;Version 15.02.2021 (Freigabe HH)
;---------Änderungen hier reinschreiben: ----------***
;Version 15.02.2021
IF _pVar_NoDrillingH=1
;Prozessvariable - Keine horizontale Bohrungen aktiv
ELSE
_pVar_PCount := _pVar_PCount+1
IF (KW_BO=0) &((DREHWINKEL=0)|(DREHWINKEL=90) | (DREHWINKEL=180)| (DREHWINKEL=270))
WZB (_Drill_Standard_ID,_VE,_V,_VA,_SD,_ANF,'51')
/HorzB (X,Y,Z,d,Tiefe,0,KW_BO,DREHWINKEL,0,0,0,0)
ZText ('PIN',x,y,20,0,2,0,'Times New Roman',0,0,0,0,0,1)
CALL HH_DowelGr_HY ( VAL BIY:=y,BIIY:=0,BIIIY:=0,BIIIIY:=0,Z:=z,SPIEGELN:=0,T:=Tiefe,D:=d,EBENE:=Seite_L_R,INKREMENT:=0,ESY:=3,ESZ:=0,USE2:=0,USE3:=0,USE4:=0,BAKTIV:=Bohren,LAKTIV:=Leim,DAKTIV:=Pin,DUEBA:=ausstand,LEIMZ:=time,DUEBL:=PIN_L,NUM1:=Par1,NUM2:=Par2,STR1:=STRPar)
ELSE
WZB (_Drill_Special_ID,_VE,_V,_VA,_SD,_ANF,'51')
HorzB (X,Y,Z,d,Tiefe,0,KW_BO,DREHWINKEL,0,0,0,0)
END
END
