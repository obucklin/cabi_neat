;MAKROTYP=1
;INSTVERSION=
;EXEVERSION=7.10.0.57[Hops.exe]
;BILD=GROOVE_HH.WMF
;INFO=
;WZGV=7235K_116
;WZGVCONFIG=
;MASCHINE=BetterSIM
;NCNAME=GROOVE_HH
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   nutsx := 20;*VAR*X- Startpunkt NUT
   nutex := 991;*VAR*X- Endpunkt NUT
   nuty := 669;*VAR*Y- Position NUT (Vorderkante Werkstück bis Vorderkante NUT)
   nutz := -10;*VAR*Tiefe NUT negativ
   nutd := 7;*VAR*BREITE NUT
   NutOffset := 0;Zugabe NUT Länge
   nutlage := 1;*VAR*0=X ; 1=Y ;2=frei; 10=X Fräsen ; 11=y Fräsen
START
;HOLZHER GmbH
;Copyright 15.02.2021
;Version 15.02.2021 (Freigabe HH)
;---------Änderungen hier reinschreiben: ----------***
;Version 15.02.2021
;Nutfräsen = Nutlage10/11
;Tasche +_WZD
;Version 03.08.2021
IF _pVar_NoProcessV=1
;Prozessvariable - Keine vertikale Bearbeitungen aktiv
ELSE
_pVar_PCount := _pVar_PCount+1
IF (NUTD>8) | (_Saw_Standard_ID=9999)|(nutlage=10)|(nutlage=11)
WZF (_Router_Groove_ID,_VE,_V,_VA,_SD,_ANF,'1')
;Tasche +_WZD
NutOffset := _WZD
/ChangeVar (NutOffset)
IF (nutlage=0)|(nutlage=10)
CALL _RechteckTasche_V5 ( VAL X_MITTE:=(NUTEX-NUTSX)/2+NUTSX,Y_MITTE:=NUTY+NUTD/2,TASCHENLAENGE:=NUTEX-NUTSX,TASCHENBREITE:=NUTD,RADIUS:=0,WINKEL:=0,TIEFE:=NUTZ,ZUSTELLUNG:=0,AB:=1,ABF:=_ANF,INTERPOL:=0,UMKEHREN:=0,ESXY:=0,ESMD:=0,LASER:=0)
ELSE
END
IF (nutlage=1)|(nutlage=11)
CALL _RechteckTasche_V5 ( VAL X_MITTE:=NUTY+NUTD/2,Y_MITTE:=((NUTEX-NUTSX)/2+NUTSX),TASCHENLAENGE:=NUTD,TASCHENBREITE:=NUTEX-NUTSX,RADIUS:=0,WINKEL:=0,TIEFE:=NUTZ,ZUSTELLUNG:=0,AB:=1,ABF:=_ANF,INTERPOL:=0,UMKEHREN:=0,ESXY:=0,ESMD:=0,LASER:=0)
ELSE
END
IF nutlage=2
Fehlermeldung ('Error nutlage=2 nicht zulässig')
ELSE
END
ELSE
WZS (_Saw_Standard_ID,_VE,_V,_VA,_SD,_ANF,'1')
IF nutlage=0
CALL _Nuten_X_V5 ( VAL NB:=nutd,NT:=nutz,EBENE:=0,ARAND:=_ry-nuty-nutd,ALINKS:=nutsx,ARECHTS:=_lx-nutex,RK:=0,ESMD:=0)
ELSE
END
IF nutlage=1
CALL _Nuten_Y_V5 ( VAL NB:=nutd,NT:=nutz,EBENE:=1,ARAND:=_rx-nuty-nutd,AUNTEN:=nutsx,AOBEN:=_ly-nutex,RK:=0,ESMD:=0)
ELSE
END
IF nutlage=2
Fehlermeldung ('Error nutlage=2 nicht zulässig')
ELSE
END
IF (_MaschinenTyp=3) | (_MaschinenTyp=4)
WZF (9999,_VE,_V,_VA,_SD,_ANF,'110')
CALL LeadInOutKontur_V7 ()
CALL _Rechteck_V5 ( VAL X_MITTE:=nutsx+(nutex-nutsx)/2,Y_MITTE:=nuty+(nutd/2),LAENGE:=nutex-nutsx+70,BREITE:=nutd+10,RADIUS:=0,WINKEL:=0,TIEFE:=1,ZUTIEFE:=0,RADIUSKORREKTUR:=2,AB:=2,AUFMASS:=0,ANF:=_ANF,ABF:=_ANF,UMKEHREN:=0,RAMPE:=0,RAMPENLAENGE:=50,QUADRANT:=1,INTERPOL:=0,ESXY:=0,ESMD:=0,LASER:=0)
END
END
END
