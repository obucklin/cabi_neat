;Bei Winkel wird FIX --> P10 verwendet.
/Typ := 1
IF _pVar_NoLamello_Winkel=0
IF _wr<0
;(CCTools = WZ P-Sys Nuter Winkel)
;WZ 136 benötigt eine 2 Schneide mit ID 135
;%%%%%%%%%%%%%%NEGATIV Winkel%%%%%%%%%%%%%%
_Z_POS_Winkel_NEG := _Z_POS_Winkel_RE
IF Typ=0
CALL P_S_RE_LI_NEG_CC ( VAL F_TOOL:=_Clamex_Nutfraeser_D7_ID,B_TOOL:=_Clamex_Bohrer_ID,BOHREN_L:=0,BOHREN_R:=-1,CL_BOPOS:=5.50,B_DM:=6,WINKEL_L:=90+_wr,WINKEL_R:=90+_wr,X1:=00.00,Y1:=60.00,X2:=00.00,Y2:=00.00,X3:=00.00,Y3:=Y,X4:=00.00,Y4:=60.00,X5:=00.00,Y5:=00.00,X6:=00.00,Y6:=Y,C1:=0,C2:=0,C3:=0,C4:=0,C5:=0,C6:=-1,C_TIEFE:=10.00,CL_TYP:=2,POS1:=0,POS2:=0)
