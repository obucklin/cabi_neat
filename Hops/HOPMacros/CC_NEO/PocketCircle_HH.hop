;MAKROTYP=1
;INSTVERSION=
;EXEVERSION=7.5.1.14[Hops.exe]
;BILD=POCKETCIRCLE_HH.WMF
;INFO=
;WZGV=ActiveMachine
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=PocketCircle_HH
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   X := 0;*VAR*X-POSITION
   Y := 0;*VAR*Y-Position
   R := 30;*VAR*Radius
   T := -13;*VAR*Tiefe
   Abfahren := 0;*VAR*Abfahren 0=ohne 1=linear 2=radial
   Z_inter := 1;*VAR*Z Interpolierend
   Zu_pro_Schritt := _AT_MAXDEPTH;*VAR*zustellung pro schritt Standart ( _AT_MAXDEPTH )
   Ri := 0;*VAR*Fräsrichtung 0=Rechts 1=Links
   laser := 0;*VAR*Laserbahn 0=aus 1=ein
   res1 := 0;reserve1
   res2 := 0;reserve2
START
;HOLZHER GmbH
;Copyright 15.02.2021
;Version 15.02.2021 (Freigabe HH)
;---------Änderungen hier reinschreiben: ----------***
;Version 15.02.2021
IF _pVar_NoProcessV=1
;Prozessvariable - Keine Bearbeitung aktiv
ELSE
WZF (_Router_Standard_ID,_VE,_V,_VA,_SD,_ANF,'1')
CALL _Kreistasche_V5 ( VAL X_MITTE:=x,Y_MITTE:=y,RADIUS:=R,TIEFE:=T,ZUSTELLUNG:=Zu_pro_Schritt,AB:=Abfahren,ABF:=_ANF,INTERPOL:=Z_inter,UMKEHREN:=Ri,ESXY:=0,ESMD:=0,LASER:=Laser)
END
