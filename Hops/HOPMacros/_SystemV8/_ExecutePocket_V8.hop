;MAKROTYP=1
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=Show_EXECUTEPOCKET_V8Dialog
;AUTOSCRIPTSTART=0
VARS
   Namen := '';*VAR*Konturnamen
   AA := 0;*VAR*Abstand Außen/Insel
   Ueberlappung := 67;*VAR*Überlappung in % vom Werkzeugdurchmesser
   Mode := 0;*VAR*0 = Spiral; 1 = Konturparallel; 2 = Parallel
   Angle := 0;*VAR*Winkel Mode=3
   Tiefe := ;*VAR*Tiefe
   esmd := 0;*VAR*
   Anzahl := 0;*VAR*Anzahl Zustellungen
   MaxZ := 0;*VAR*Maximale Zustelltiefe
   RD := 0;*VAR*Richtung umkehren
   FliegendEintauchen := 0;*VAR*
   MaxEintauchLaenge := 20;*VAR*
   InterpolDist := 0.5mm;*VAR*Abstand für Interpolationsfräsung
   AnzahlP := 0;
   AnzahlOutlineP := 0;
   Z_Index := 0;
   Z_Anzahl := 0;
   Z_Step := 0;
   Z_AktTiefe := 0;
   PocketKonturName := 'Pocket';
   HaveToSplit := 0;
   InClampArea := 0;
START
;--
;-- (c) DiREKT
;-- MW 07.08.2012 auch Anzahl Frässchritte möglich
;--
IF _WZR<>0
CALL _MNCDC_HaveToSplitContours (REF RESULT:=HaveToSplit,INCLAMPAREA:=InClampArea VAL CONTOURNAME_CONTOURNAMES:=Namen,TIEFE:=Tiefe,TOOLID:=_BOXID,MAXARCTOL:=0.1mm,VIEW_OFFX:=_AV_OFFSETX,VIEW_OFFY:=_AV_OFFSETY,VIEW_OFFZ:=_AV_OFFSETZ,VIEW_ROTA:=_AV_ROTA,VIEW_TIPA:=_AV_TIPA)
IF (HaveToSplit=1) & (_MNCDC_SplitKind<>-2)
CALL _MNCDC_ExecutePocket_V8 ( VAL NAMEN:=Namen,AA:=AA,UEBERLAPPUNG:=Ueberlappung,MODE:=Mode,ANGLE:=Angle,TIEFE:=Tiefe,ESMD:=esmd,ANZAHL:=Anzahl,MAXZ:=MaxZ,RD:=RD,FLIEGENDEINTAUCHEN:=FliegendEintauchen,MAXEINTAUCHLAENGE:=MaxEintauchLaenge,INCLAMPAREA:=InClampArea,INTERPOLDIST:=InterpolDist)
ELSE
;Easysnap verrechnen
Transesd (Tiefe,esmd)
CreatePocketContour (Namen,AA+_WZR,_WZD-_WZD*Ueberlappung/100,Angle,Mode,RD,PocketKonturName,'','',AnzahlP,AnzahlOutlineP)
IF (AnzahlP=0)&(AnzahlOutlineP=0)
;SF Fehler ausgeben 13.03.2009
IF _MNCDC_SplitKind<>-2
Fehlermeldung (GetMessageText('1001','Keine Fräskonturen vorhanden. Text vermutlich zu klein.'))
END
ELSE
InterpolDist := abs(InterpolDist)
;- Nur negative Zustellungen erlaubt !
;- Wie in allen Taschenmakros !!!
Tiefe := -ABS(Tiefe)
MaxZ := -ABS(MaxZ)
;Gleichmässige Zustellparameter berechnen
;CALL _Calc_Count_Step_V5 (REF Z_ANZAHL:=Z_Anzahl,Z_STEP:=Z_Step VAL TIEFE:=Tiefe,ANZAHL:=Anzahl,MAXZ:=MaxZ)
;Z_AktTiefe := Z_Step
;Taschenkonturen abarbeiten
;******* Anzahl Zustellungen errechnen *******
;SF Z_AktTiefe initialisieren und verweden 06.07.2009
IF (Tiefe<>0) & (MaxZ<>0)
Z_Anzahl := trunc(tiefe/maxz)
Z_AktTiefe := 0
ELSE
IF Anzahl>0
Z_Anzahl := Anzahl
Z_AktTiefe := 0
MaxZ := Tiefe/Anzahl
ELSE
Z_Anzahl := 0
Z_AktTiefe := 0.1mm
END
END
;FOR Z_Index := 1 TO Z_Anzahl STEP 1
;CALL _ExecutePocketContours_V5 ( VAL KN:=PocketKonturName,MODE:=Mode,LASTTIEFE:=Z_AktTiefe-Z_Step,TIEFE:=Z_AktTiefe,ANZAHLP:=AnzahlP,ANZAHLOUTLINEP:=AnzahlOutlineP,RD:=RD,FLIEGENDEINTAUCHEN:=FliegendEintauchen,MAXEINTAUCHLAENGE:=MaxEintauchLaenge,LASTCALL:=Z_Index=Z_Anzahl)
;Z_AktTiefe := Z_AktTiefe+Z_Step
;END
FOR Z_Index := 1 TO Z_Anzahl STEP 1
;LastCall richtigen Wert übergeben SF 03.11.2009
CALL _ExecutePocketContours_V8 ( VAL KN:=PocketKonturName,MODE:=Mode,LASTTIEFE:=Z_AktTiefe,TIEFE:=Z_AktTiefe+MaxZ,ANZAHLP:=AnzahlP,ANZAHLOUTLINEP:=AnzahlOutlineP,RD:=RD,FLIEGENDEINTAUCHEN:=FliegendEintauchen,MAXEINTAUCHLAENGE:=MaxEintauchLaenge,LASTCALL:=(Z_AktTiefe+MaxZ)=Tiefe,INTERPOLDIST:=InterpolDist)
Z_AktTiefe := _z
END
IF Z_AktTiefe>Tiefe
;LastCall richtigen Wert übergeben SF 03.11.2009
CALL _ExecutePocketContours_V8 ( VAL KN:=PocketKonturName,MODE:=Mode,LASTTIEFE:=Z_AktTiefe,TIEFE:=Tiefe,ANZAHLP:=AnzahlP,ANZAHLOUTLINEP:=AnzahlOutlineP,RD:=RD,FLIEGENDEINTAUCHEN:=FliegendEintauchen,MAXEINTAUCHLAENGE:=MaxEintauchLaenge,LASTCALL:=1,INTERPOLDIST:=InterpolDist)
END
CALL _DeletePocketContours_V5 ( VAL KN:=PocketKonturName,ANZAHLP:=AnzahlP,ANZAHLOUTLINEP:=AnzahlOutlineP)
END
END
ELSE
Fehlermeldung (GetMessageText('17','Bitte Werkzeug definieren'))
END
