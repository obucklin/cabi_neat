;MAKROTYP=0
;BILD=_EXECUTEPOCKETCONTOURS_V8.WMF
;INFO=_EXECUTEPOCKETCONTOURS_V5
;WZGV=1000008874SB
;WZGVCONFIG=
;MASCHINE=BetterSIM
;NCNAME=_EXECUTEPOCKETCONTOURS_V8
;KOMMENTAR=
;DX=1
;DY=2
;DZ=3
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=0
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   KN := '';*VAR*Konturnamen
   Mode := 0;*VAR*
   LastTiefe := 0;*VAR*
   Tiefe := -10;*VAR*Tiefe
   AnzahlP := 0;*VAR*
   AnzahlOutlineP := 0;*VAR*
   RD := 0;*VAR*Richtung umkehren
   FliegendEintauchen := 0;*VAR*
   MaxEintauchLaenge := 20;*VAR*
   LastCall := 0;*VAR*
   InterpolDist := 0.5mm;*VAR*Abstand für Interpolationsfräsung
   i := 0;
   UseOutline := 0;
START
;SF 07.11.2011
;Mit neuer Cadability Version bei Spirale nicht mehr erforderlich
;Spirale immer geschlossen
;UseOutline := (Mode=0)|(Mode=2)|(Mode=4)|(Mode=6)
UseOutline := (Mode=2)|(Mode=6)|(Mode=16)
IF RD=0
FOR i := 1 TO AnzahlP STEP 1
CALL _ExecutePocketContour_V8 ( VAL KN:=KN+IntToStr(i-1),LASTTIEFE:=LastTiefe,TIEFE:=Tiefe,FLIEGENDEINTAUCHEN:=FliegendEintauchen,MAXEINTAUCHLAENGE:=MaxEintauchLaenge,LASTCALL:=LastCall & (((~UseOutline) & (i=AnzahlP))|(UseOutline & (i=AnzahlP) & (AnzahlOutlineP=0))),INTERPOLDIST:=InterpolDist)
END
IF UseOutline
FOR i := 1 TO AnzahlOutlineP STEP 1
CALL _ExecutePocketContour_V8 ( VAL KN:=KN+'_Outline'+IntToStr(i-1),LASTTIEFE:=LastTiefe,TIEFE:=Tiefe,FLIEGENDEINTAUCHEN:=FliegendEintauchen,MAXEINTAUCHLAENGE:=MaxEintauchLaenge,LASTCALL:=LastCall & (i=AnzahlOutlineP))
END
END
ELSE
IF UseOutline
FOR i := 1 TO AnzahlOutlineP STEP 1
CALL _ExecutePocketContour_V8 ( VAL KN:=KN+'_Outline'+IntToStr(i-1),LASTTIEFE:=LastTiefe,TIEFE:=Tiefe,FLIEGENDEINTAUCHEN:=FliegendEintauchen,MAXEINTAUCHLAENGE:=MaxEintauchLaenge,LASTCALL:=LastCall & ((i=AnzahlOutlineP) & (AnzahlP=0)))
END
END
FOR i := 1 TO AnzahlP STEP 1
CALL _ExecutePocketContour_V8 ( VAL KN:=KN+IntToStr(i-1),LASTTIEFE:=LastTiefe,TIEFE:=Tiefe,FLIEGENDEINTAUCHEN:=FliegendEintauchen,MAXEINTAUCHLAENGE:=MaxEintauchLaenge,LASTCALL:=LastCall & (i=AnzahlP))
END
END
