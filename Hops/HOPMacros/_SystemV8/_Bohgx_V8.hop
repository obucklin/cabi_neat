;MAKROTYP=1
;INSTVERSION=
;EXEVERSION=7.11.0.182[Hops.exe]
;BILD=_BOHGX_V8.WMF
;INFO=_Bohgx_V5
;WZGV=7605_071222
;WZGVCONFIG=
;MASCHINE=BetterSIM
;NCNAME=_Bohgx_V8
;KOMMENTAR=
;DX=1
;DY=2
;DZ=3
;DIALOGDLL=DialogsHopSys.Dll
;DIALOGPROC=Show_Bohgx_V8Dialog
;DIALOGKIND=0
;AUTOSCRIPTSTART=0
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   SPY := 10;*VAR*Startwert (y)
   BIX := 64;*VAR*Bohrung1 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIX := 64;*VAR*Bohrung2 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIIX := 64;*VAR*Bohrung3 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIIIX := 0;*VAR*Bohrung4 (Wert=0-> Bohrung wird nicht abgesetzt)
   Spiegeln := 0;*VAR*1=>gespiegelt
   T := -13;*VAR*Bohrtiefe
   D := 8mm;*VAR*Bohrdurchmesser
   TLF := 10;*VAR*Tieflochflag
   Inkrement := 1;*VAR*Absolut oder Inkremental
   B1 := 0;Bohrung 1
   B2 := 0;Bohrung 2
   B3 := 0;Bohrung 3
   B4 := 0;Bohrung 4
   esxy := 1;*VAR*
   esd := 0;*VAR*
   Use2 := 1;*VAR*
   Use3 := 1;*VAR*
   Use4 := 0;*VAR*
   VonUnten := 1;*VAR*Von Unten
   DummyY := 0;
   ToolID := -999;
START
;direkt cnc systeme NCHOPS Version 4.x
;Bohrgruppe in X
;HH_POWERPIN_EDGE
;HH erweitert mir Anzeige von unten (HH_DRAW_DRILL)
CALL _UserInterface3DG (REF RESULT:=ToolID VAL INPUTTEXT:='GetStandardRouterID')
IF _MaschinenTyp=7
CALL HH_POWERPIN_EDGE ( VAL PARA1:=2)
END
Transesd (T,esd)
IF T>0
T := -T
END
IF Inkrement=0
transesxy (BIX,SPY,esxy,1)
transesxy (BIIX,DummyY,esxy,1)
transesxy (BIIIX,DummyY,esxy,1)
transesxy (BIIIIX,DummyY,esxy,1)
;IF (BIX<>0)
Bohrung (BIX,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=BIX,POSY:=SPY,D:=D,SHOW:=VonUnten)
;END
;IF (BIIX<>0)
IF (Use2<>0)
Bohrung (BIIX,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=BIIX,POSY:=SPY,D:=D,SHOW:=VonUnten)
END
;IF (BIIIX<>0)
IF (Use3<>0)
Bohrung (BIIIX,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=BIIIX,POSY:=SPY,D:=D,SHOW:=VonUnten)
END
;IF (BIIIIX<>0)
IF (Use4<>0)
Bohrung (BIIIIX,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=BIIIIX,POSY:=SPY,D:=D,SHOW:=VonUnten)
END
;Gespiegelte Bohrungen
IF Spiegeln <> 0
;IF (BIX<>_RX/2)&(BIX<>0)
Bohrung (_RX-BIX,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-BIX,POSY:=SPY,D:=D,SHOW:=VonUnten)
;END
;IF (BIIX<>_RX/2)&(BIIX<>0)
IF (Use2<>0)
Bohrung (_RX-BIIX,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-BIIX,POSY:=SPY,D:=D,SHOW:=VonUnten)
END
;IF (BIIIX<>_RX/2)&(BIIIX<>0)
IF (Use3<>0)
Bohrung (_RX-BIIIX,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-BIIIX,POSY:=SPY,D:=D,SHOW:=VonUnten)
END
;IF (BIIIIX<>_RX/2)&(BIIIIX<>0)
IF (Use4<>0)
Bohrung (_RX-BIIIIX,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-BIIIIX,POSY:=SPY,D:=D,SHOW:=VonUnten)
END
END
ELSE
B1 := BIX
B2 := BIX+BIIX
B3 := BIX+BIIX+BIIIX
B4 := BIX+BIIX+BIIIX+BIIIIX
transesxy (B1,SPY,esxy,1)
transesxy (B2,DummyY,esxy,1)
transesxy (B3,DummyY,esxy,1)
transesxy (B4,DummyY,esxy,1)
;IF (BIX<>0)
Bohrung (B1,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=B1,POSY:=SPY,D:=D,SHOW:=VonUnten)
;END
;IF (BIIX<>0)
IF (Use2<>0)
Bohrung (B2,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=B2,POSY:=SPY,D:=D,SHOW:=VonUnten)
END
;IF (BIIIX<>0)
IF (Use3<>0)
Bohrung (B3,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=B3,POSY:=SPY,D:=D,SHOW:=VonUnten)
END
;IF (BIIIIX<>0)
IF (Use4<>0)
Bohrung (B4,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=B4,POSY:=SPY,D:=D,SHOW:=VonUnten)
END
;Gespiegelte Bohrungen
IF Spiegeln <> 0
;IF (BIX<>_RX/2)&(BIX<>0)
Bohrung (_RX-B1,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-B1,POSY:=SPY,D:=D,SHOW:=VonUnten)
;END
;IF (BIIX<>_RX/2)&(BIIX<>0)
IF (Use2<>0)
Bohrung (_RX-B2,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-B2,POSY:=SPY,D:=D,SHOW:=VonUnten)
END
;IF (BIIIX<>_RX/2)&(BIIIX<>0)
IF (Use3<>0)
Bohrung (_RX-B3,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-B3,POSY:=SPY,D:=D,SHOW:=VonUnten)
END
;IF (BIIIIX<>_RX/2)&(BIIIIX<>0)
IF (Use4<>0)
Bohrung (_RX-B4,SPY,D,T,TLF,0,0,0,0,0,VonUnten,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-B4,POSY:=SPY,D:=D,SHOW:=VonUnten)
END
END
END
