;MAKROTYP=0
;BILD=VK_Band_Rahmen.wmf
;INFO=
;WZGV=7123K_021
;MASCHINE=HOLZHER
;NCNAME=VK_Band_Rahmen
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;AUTOSCRIPTSTART=0
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   DX := 2000;Dimension X
   DY := 100;Dimension Y
   DZ := 45;Dimension Z
   Falz_T := 15;*VAR*Falztiefe
   Falz_H := 30;*VAR*Falz hoehe
   Querstueck := DY;*VAR**REF*Querstueck oben
   Band_U := (Querstueck -27)+1700;*VAR*Bandposition von oben
   Band_O := (Querstueck -27)+280;*VAR*Bandposition von oben
START
Fertigteil (DX,DY,DZ,0,0,10,2.5,60,'',0,0,0)
CALL HH_Park ( VAL PARK:=2,X:=0,Y:=0)
;Band oben
WZF (5,_VE,_V,_VA,_SD,_ANF,'1')
CALL _RechteckTasche_V5 ( VAL X_MITTE:=Band_O,Y_MITTE:=Falz_T+15,TASCHENLAENGE:=114,TASCHENBREITE:=21,RADIUS:=10.5,WINKEL:=0,TIEFE:=-3,ZUSTELLUNG:=0,AB:=0,ABF:=_ANF,INTERPOL:=1,UMKEHREN:=0,ESXY:=1,ESMD:=0,LASER:=0)
CALL _Kreisbahn_V5 ( VAL X_MITTE:=Band_O+14,Y_MITTE:=Falz_T+15,TIEFE:=-27,ZUTIEFE:=20,RADIUS:=9.2,RADIUSKORREKTUR:=1,AB:=0,AUFMASS:=0,BEARB_UMKEHREN:=0,WINKEL:=360,ANF:=_ANF,ABF:=_ANF,RAMPE:=1,INTERPOL:=0,ESXY:=1,ESMD:=0,LASER:=0)
CALL _Kreisbahn_V5 ( VAL X_MITTE:=Band_O+14+32,Y_MITTE:=Falz_T+15,TIEFE:=-27,ZUTIEFE:=20,RADIUS:=9.2,RADIUSKORREKTUR:=1,AB:=0,AUFMASS:=0,BEARB_UMKEHREN:=0,WINKEL:=360,ANF:=_ANF,ABF:=_ANF,RAMPE:=1,INTERPOL:=0,ESXY:=1,ESMD:=0,LASER:=0)
;Bohrungen
WZB (501,_VE,_V,_VA,_SD,_ANF,'1')
Bohrung (Band_O -5,Falz_T+16+2.5,3,-15,20,0,0,1,0,0,0,0)
Bohrung (Band_O -24,Falz_T+16 - 3.5,3,-15,20,0,0,1,0,0,0,0)
Bohrung (Band_O -42,Falz_T+16-1,3,-15,20,0,0,1,0,0,0,0)
;Band unten
WZF (5,_VE,_V,_VA,_SD,_ANF,'1')
CALL _RechteckTasche_V5 ( VAL X_MITTE:=Band_U,Y_MITTE:=Falz_T+15,TASCHENLAENGE:=114,TASCHENBREITE:=21,RADIUS:=10.5,WINKEL:=0,TIEFE:=-3,ZUSTELLUNG:=0,AB:=0,ABF:=_ANF,INTERPOL:=1,UMKEHREN:=0,ESXY:=1,ESMD:=0,LASER:=0)
CALL _Kreisbahn_V5 ( VAL X_MITTE:=Band_U+14,Y_MITTE:=Falz_T+15,TIEFE:=-27,ZUTIEFE:=20,RADIUS:=9.2,RADIUSKORREKTUR:=1,AB:=0,AUFMASS:=0,BEARB_UMKEHREN:=0,WINKEL:=360,ANF:=_ANF,ABF:=_ANF,RAMPE:=1,INTERPOL:=0,ESXY:=1,ESMD:=0,LASER:=0)
CALL _Kreisbahn_V5 ( VAL X_MITTE:=Band_U+14+32,Y_MITTE:=Falz_T+15,TIEFE:=-27,ZUTIEFE:=20,RADIUS:=9.2,RADIUSKORREKTUR:=1,AB:=0,AUFMASS:=0,BEARB_UMKEHREN:=0,WINKEL:=360,ANF:=_ANF,ABF:=_ANF,RAMPE:=1,INTERPOL:=0,ESXY:=1,ESMD:=0,LASER:=0)
;Bohrungen
WZB (501,_VE,_V,_VA,_SD,_ANF,'1')
Bohrung (Band_U -5,Falz_T+16+2.5,3,-15,20,0,0,1,0,0,0,0)
Bohrung (Band_U -24,Falz_T+16 - 3.5,3,-15,20,0,0,1,0,0,0,0)
Bohrung (Band_U -42,Falz_T+16-1,3,-15,20,0,0,1,0,0,0,0)
