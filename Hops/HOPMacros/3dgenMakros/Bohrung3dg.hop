;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.6.3.243[Hops.exe]
;BILD=BOHRUNG3DG.WMF
;INFO=
;WZGV=7735D_101
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=Bohrung3dg
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0.000
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   dx := _lx;
   dy := _ly;
   dz := _lz;
   x := 0;*VAR*
   y := 200;*VAR*
   z := -10;*VAR*
   d := 8;*VAR*Durchmesser
   tiefe := -20;*VAR*
   toolID := 0;
   x1 := 0;Berechnung der X position test_hb
   a5 := 1;5 Achs Maschine =1;  Winkelgetriebe =0
   Y1 := 0;Berechnung der Y Position hb
START
;HOLZHER GmbH
;Copyright 2020
;Bohrung3dg
IF _pVar_NoDrillingV=1
;Prozessvariable - Keine vertikale Bohrungen aktiv
ELSE
_pVar_PCount := _pVar_PCount+1
;Cabineo mit HSK Bohraggregat 7828/////
IF (d=15)&(_Drill_Special_ID<>9999);BREAKPOINT
WZB (_Drill_Special_ID,_VE,_V,_VA,_SD,_ANF,'1')
Bohrung (x,y,d,Tiefe,30,0,0,0,0,0,0,0)
EXITMACRO
END
;Cabineo Flächenbündig /////
IF d=15.1
;Links
IF x<5
WZF (37,_VE,_V,_VA,_SD,_ANF,'1')
SP (0,y+8.25,-0.8,2,0,_ANF,0,0,0,0,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (33.93,0,0,8.25,10,2)
G01 (0,-16.5,0,8.25,10,2)
G01 (-33.93,0,0,0,10,2)
EP (0,_ANF,0)
CALL _UserInterface3DG (REF RESULT:=toolID VAL INPUTTEXT:='GetStandardDrillID')
WZB (toolID,_VE,_V,_VA,_SD,_ANF,'1')
Bohrung (x,y,15,Tiefe,30,0,0,0,0,0,0,0)
ZText ('Cabineo FB',x+32,y,15,0,2,0,'Arial',0,0,0,0,0,1)
EXITMACRO
ELSE
;Rechts
WZF (37,_VE,_V,_VA,_SD,_ANF,'1')
SP (0,y-8.25,-0.8,2,0,_ANF,0,0,0,3,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (-33.93,0,0,8.25,10,2)
G01 (0,16.5,0,8.25,10,2)
G01 (33.93,0,0,0,10,2)
EP (0,_ANF,0)
CALL _UserInterface3DG (REF RESULT:=toolID VAL INPUTTEXT:='GetStandardDrillID')
WZB (toolID,_VE,_V,_VA,_SD,_ANF,'1')
Bohrung (x,y,15,Tiefe,30,0,0,0,0,0,0,0)
ZText ('Cabineo FB',x-128,y,15,0,2,0,'Arial',0,0,0,0,0,1)
EXITMACRO
END
END
;//// Lamello Typ10 & Typ20 ////
IF ((_MaschinenTyp=1) | (_MaschinenTyp=2)| (_MaschinenTyp=5))
IF d=5.4
;Anzeige welcher Lamello Typ
IF tiefe=-5
ZText ('Lamello Typ 10',x+10,y,15,0,2,0,'Arial',0,0,0,0,0,1)
ZRechteck (x-2,y-25,4,50,1,0,0,0,0,1)
ELSE
ZText ('Lamello Typ 20',x+10,y,15,0,2,0,'Arial',0,0,0,0,0,1)
ZRechteck (x-2,y-25,4,50,1,0,0,0,0,1)
END
;WKG oder HSK
IF _Router_Vario_ID=9999
Fehlermeldung ('Vario NC Fräser - Lamello Fläche - Kein Werkzeug gewählt / Lamello surface - No tool selected ')
ELSE
WZS (_Router_Vario_ID,_VE,_V,_VA,_SD,_ANF,'1')
END
;Rechts
IF x<30
CALL _DrehenBBEnde ()
CALL _saege_y_V5 ( VAL SX:=x,SY:=y,SZ:=-3,EY:=y-1,EZ:=tiefe,BL:=0,EINPASSEN:=0,EL:=0,AL:=0,PARALLEL:=0,K:=0,KW:=0,BH:=0,RITZVERSATZ:=0.05,ESZ:=2,ESXY1:=1,ESY:=3)
;Links
ELSE
CALL _DrehenBBEnde ()
CALL _saege_y_V5 ( VAL SX:=x,SY:=y,SZ:=-3,EY:=y+1,EZ:=tiefe,BL:=0,EINPASSEN:=0,EL:=0,AL:=0,PARALLEL:=0,K:=0,KW:=0,BH:=0,RITZVERSATZ:=0.05,ESZ:=2,ESXY1:=1,ESY:=3)
END
END
ELSE
END
;Clamex P 14 wenn d=6,15mm
CALL _UserInterface3DG (REF RESULT:=ToolID VAL INPUTTEXT:='GetStandardRouterID')
IF d=5.4
IF x<30
CALL _DrehenBBEnde ()
WZF (136,_VE,_V,_VA,_SD,_ANF,'1')
CALL _UserInterface3DG (REF RESULT:=toolID VAL INPUTTEXT:='GetSpecialSawID')
WZS (toolID,_VE,_V,_VA,_SD,_ANF,'1')
CALL _saege_y_V5 ( VAL SX:=x,SY:=y,SZ:=-3,EY:=y-1,EZ:=tiefe,BL:=0,EINPASSEN:=0,EL:=0,AL:=0,PARALLEL:=0,K:=0,KW:=0,BH:=0,RITZVERSATZ:=0.05,ESZ:=2,ESXY1:=1,ESY:=3)
ELSE
CALL _DrehenBBEnde ()
WZF (136,_VE,_V,_VA,_SD,_ANF,'1')
CALL _UserInterface3DG (REF RESULT:=toolID VAL INPUTTEXT:='GetSpecialSawID')
WZS (toolID,_VE,_V,_VA,_SD,_ANF,'1')
CALL _saege_y_V5 ( VAL SX:=x,SY:=y,SZ:=-3,EY:=y+1,EZ:=tiefe,BL:=0,EINPASSEN:=0,EL:=0,AL:=0,PARALLEL:=0,K:=0,KW:=0,BH:=0,RITZVERSATZ:=0.05,ESZ:=2,ESXY1:=1,ESY:=3)
END
ELSE
;P 14
IF d=6.1
CALL _DrehenBBEnde ()
IF x>100
x1 := _lx-x
IF x1>100
CALL B2Punkte_V5 ( VAL P1X:=0,P1Y:=0,P2X:=x1,P2Y:=0,ABSTAND:=-40,FARBE:=0,TEXT:='',TEXTHOEHE:=20,PFEILLAENGE:=20mm,PFEILEINNERHALB:=0,ESXY1:=3,ESXY2:=3)
;Stiftfräser = 1
IF _PSystemSTIFT=1
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-14 Stift',x-30,y,15,0,2,0,'Times New Roman',0,1,0,0,3)
ELSE
IF _MaschinenTYP=2
;EVO
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-14 a',x1-20,y,15,0,2,0,'Times New Roman',0,1,0,0,3)
ELSE
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-14 WKG',x,y,15,0,2,0,'Times New Roman',0,1,0,0,1)
END
END
ELSE
;Clamex Rechts P14
CALL B2Punkte_V5 ( VAL P1X:=0,P1Y:=0,P2X:=x1,P2Y:=0,ABSTAND:=-40,FARBE:=0,TEXT:='',TEXTHOEHE:=20,PFEILLAENGE:=20mm,PFEILEINNERHALB:=0,ESXY1:=3,ESXY2:=3)
IF _MaschinenTYP=2
;EVO
IF textsame(_Teiletyp,'Mittelseite')
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-10',x,y,15,0,6,0,'Times New Roman',0,1,0,0,1)
ELSE
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-14 c',x,y,15,0,6,0,'Times New Roman',0,1,0,0,1)
END
ELSE
IF textsame(_Teiletyp,'Mittelseite');BREAKPOINT
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-10 g',x,y,15,0,2,0,'Times New Roman',0,1,0,0,1)
ELSE
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-14 d',x,y,15,0,2,0,'Times New Roman',0,1,0,0,1)
END
END
END
ELSE
;ClamexLinks P14
IF _MaschinenTYP=2
;EVO
IF textsame(_Teiletyp,'Mittelseite')
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-10',x,y,15,0,2,0,'Times New Roman',0,1,0,0,1)
ELSE
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-14e',x,y,15,0,2,0,'Times New Roman',0,1,0,0,1)
END
ELSE
IF textsame(_Teiletyp,'Mittelseite')
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-10',x,y,15,0,2,0,'Times New Roman',0,1,0,0,1)
ELSE
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-14f',x,y,15,0,2,0,'Times New Roman',0,1,0,0,1)
END
END
END
END
;Clamex P 10 wenn d=6.2
IF d=6.2
CALL _DrehenBBEnde ()
IF x>100
x1 := _lx-x
IF x1>100
CALL B2Punkte_V5 ( VAL P1X:=0,P1Y:=0,P2X:=x1,P2Y:=0,ABSTAND:=-40,FARBE:=0,TEXT:='',TEXTHOEHE:=20,PFEILLAENGE:=20mm,PFEILEINNERHALB:=0,ESXY1:=3,ESXY2:=3)
;5Achs a5=1 Winkelgetriebe a5=0
IF _PSystemSTIFT=1
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-10 Stift',x-20,y,15,0,2,0,'Times New Roman',0,1,0,0,3)
ELSE
IF _MaschinenTYP=2
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-10',x-20,y,15,0,6,0,'Times New Roman',0,1,0,0,3)
ELSE
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P-10 WKG',x-20,y,15,0,2,0,'Times New Roman',0,1,0,0,3)
END
END
ELSE
CALL B2Punkte_V5 ( VAL P1X:=0,P1Y:=0,P2X:=x1,P2Y:=0,ABSTAND:=-40,FARBE:=0,TEXT:='',TEXTHOEHE:=20,PFEILLAENGE:=20mm,PFEILEINNERHALB:=0,ESXY1:=3,ESXY2:=3)
ZText ('P10',x1,y,20,0,1,0,'Times New Roman',0,0,0,0,3)
IF _MaschinenTYP=2
;EVO
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ELSE
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
END
END
ELSE
ZText ('Clamex P10 Mittelseite',0,0,30,0,9,0,'Times New Roman',0,0,0,0,9)
IF _MaschinenTYP=2
;EVO
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ELSE
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
END
END
END
IF d=6.3
CALL _DrehenBBEnde ()
IF textsame(_Teiletyp,'Sockel')
IF _MaschinenTYP=2
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=0,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ELSE
IF x>100
x1 := _lx-x
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=0,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ELSE
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=0,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
END
END
ELSE
IF _MaschinenTYP=2
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ELSE
IF y>100
y1 := _ly-y
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ELSE
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=0,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
ZText ('P14 Sockel',x,y,14,0,1,0,'Times New Roman',0,0,0,0,0,0)
END
END
END
END
IF (d=6.1)|(d=6.2)|(d=6.3)
ELSE
;Fraesung bei d>35mm
IF d>35
CALL _UserInterface3DG (REF RESULT:=toolID VAL INPUTTEXT:='GetStandardRouterID')
WZF (toolID,_VE,_V,_VA,_SD,_ANF,'1')
IF tiefe<=_lz
CALL _Kreisbahn_V5 ( VAL X_MITTE:=x,Y_MITTE:=y,TIEFE:=tiefe-2,ZUTIEFE:=tiefe-2,RADIUS:=d/2,RADIUSKORREKTUR:=1,AB:=1,AUFMASS:=0,BEARB_UMKEHREN:=0,WINKEL:=360,ANF:=_ANF,ABF:=_ANF,RAMPE:=1,INTERPOL:=1,ESXY:=0,ESMD:=0,LASER:=0)
ELSE
CALL _Kreistasche_V5 ( VAL X_MITTE:=x,Y_MITTE:=y,RADIUS:=d/2,TIEFE:=tiefe,ZUSTELLUNG:=tiefe,AB:=2,ABF:=_ANF,INTERPOL:=0,UMKEHREN:=0,ESXY:=0,ESMD:=1,LASER:=0)
END
ELSE
CALL _UserInterface3DG (REF RESULT:=toolID VAL INPUTTEXT:='GetStandardDrillID')
WZB (toolID,_VE,_V,_VA,_SD,_ANF,'1')
;Durchgangsloch?
IF Tiefe<=-_lz
IF (_MaschinenTYP=3) | (_MaschinenTYP=4)
Bohrung (x,y,d,-_lz,10,0,0,0,0,0,0,0)
ELSE
Bohrung (x,y,d,-_lz,20,0,0,0,0,0,0,0)
END
ELSE
;Topfband?
IF d>=14
Bohrung (x,y,d,Tiefe,30,0,0,0,0,0,0,0)
ELSE
;Sackloch
Bohrung (x,y,d,Tiefe,10,0,0,0,0,0,0,0)
IF tiefe=-10.1
ZText ('P-18',x,y+5,15,0,8,0,'Times New Roman',0,0,0,0,1)
ELSE
END
END
END
END
END
END
END
