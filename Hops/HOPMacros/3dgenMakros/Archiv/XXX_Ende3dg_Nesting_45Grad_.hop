;Tiefe über Cos  HB
IF _wh<0
/CALL _saege_y_V5 ( VAL SX:=0,SY:=0,SZ:=-3,EY:=0,EZ:=-((_lz+2)/cos(_wr)),BL:=1,EINPASSEN:=0,EL:=0,AL:=0,PARALLEL:=0,K:=0,KW:=_wr,BH:=0,RITZVERSATZ:=0.05,ESZ:=2,ESXY1:=5,ESY:=3)
