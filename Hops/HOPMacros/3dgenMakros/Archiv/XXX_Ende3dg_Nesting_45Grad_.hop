/CALL _saege_y_V5 ( VAL SX:=0,SY:=0,SZ:=-3,EY:=0,EZ:=-2,BL:=2,EINPASSEN:=0,EL:=0,AL:=0,PARALLEL:=0,K:=1,KW:=-_wl,BH:=0,RITZVERSATZ:=0.05,ESZ:=0,ESXY1:=7,ESY:=3)
