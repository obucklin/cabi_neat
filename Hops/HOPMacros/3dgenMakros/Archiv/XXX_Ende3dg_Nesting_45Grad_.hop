/CALL _saege_x_V5 ( VAL SX:=0,SY:=0,SZ:=-3,EX:=0,EZ:=-((_lz+5)/cos(_wh)),BL:=1,EINPASSEN:=0,EL:=0,AL:=0,PARALLEL:=0,K:=0,KW:=-_wh,BH:=0,RITZVERSATZ:=0.05,ESZ:=2,ESXY1:=3,ESX:=1)
