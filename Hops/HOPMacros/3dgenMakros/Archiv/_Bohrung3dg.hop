IF (d=6.1)|(d=6.2)|(d=6.3)
ELSE
;Fraesung bei d>35mm
IF d>35
CALL _UserInterface3DG (REF RESULT:=toolID VAL INPUTTEXT:='GetStandardRouterID')
WZF (toolID,_VE,_V,_VA,_SD,_ANF,'1')
IF tiefe<=_lz
CALL _Kreisbahn_V5 ( VAL X_MITTE:=x,Y_MITTE:=y,TIEFE:=tiefe-2,ZUTIEFE:=tiefe-2,RADIUS:=d/2,RADIUSKORREKTUR:=1,AB:=1,AUFMASS:=0,BEARB_UMKEHREN:=0,WINKEL:=360,ANF:=_ANF,ABF:=_ANF,RAMPE:=1,INTERPOL:=1,ESXY:=0,ESMD:=0,LASER:=0)
ELSE
CALL _Kreistasche_V5 ( VAL X_MITTE:=x,Y_MITTE:=y,RADIUS:=d/2,TIEFE:=tiefe,ZUSTELLUNG:=tiefe,AB:=2,ABF:=_ANF,INTERPOL:=0,UMKEHREN:=0,ESXY:=0,ESMD:=1,LASER:=0)
END
ELSE
CALL _UserInterface3DG (REF RESULT:=toolID VAL INPUTTEXT:='GetStandardDrillID')
WZB (toolID,_VE,_V,_VA,_SD,_ANF,'1')
;Durchgangsloch?
IF Tiefe<=-_lz
IF (_MaschinenTYP=3) | (_MaschinenTYP=4)
Bohrung (x,y,d,-_lz,10,0,0,0,0,0,0,0)
ELSE
Bohrung (x,y,d,-_lz,20,0,0,0,0,0,0,0)
END
ELSE
;Topfband?
IF d>=14
Bohrung (x,y,d,Tiefe,30,0,0,0,0,0,0,0)
ELSE
;Sackloch
Bohrung (x,y,d,Tiefe,10,0,0,0,0,0,0,0)
IF tiefe=-10.1
ZText ('P-18',x,y+5,15,0,8,0,'Times New Roman',0,0,0,0,1)
ELSE
END
END
END
END
END
END
