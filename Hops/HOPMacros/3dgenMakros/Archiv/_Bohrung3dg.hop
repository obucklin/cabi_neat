;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.0.2.1[Hops.exe]
;BILD=BOHRUNG3DG.WMF
;INFO=
;WZGV=7225K_V7_DEMO
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=Bohrung3dg
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0.000
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   dx := _lx;
   dy := _ly;
   dz := _lz;
   x := 0;*VAR*
   y := 200;*VAR*
   z := -10;*VAR*
   d := 8;*VAR*Durchmesser
   tiefe := -20;*VAR*
   toolID := 0;
   x1 := 0;Berechnung der X position test_hb
   a5 := 1;5 Achs Maschine =1;  Winkelgetriebe =0
   Y1 := 0;Berechnung der Y Position hb
START
;HOLZHER - Reich Spezialmaschinen GmbH
;Copyright 2006
;2006-08-22 - CC-Makros V1.0 KRI
;Bohrung3dg
IF _pVar_NoDrillingV=1
;Prozessvariable - Keine vertikale Bohrungen aktiv
ELSE
_pVar_PCount := _pVar_PCount+1
;Clamex P 14 wenn d=6,15mm
CALL _UserInterface3DG (REF RESULT:=ToolID VAL INPUTTEXT:='GetStandardRouterID')
IF ((_MaschinenTyp=1) | (_MaschinenTyp=2)| (_MaschinenTyp=5))
IF d=5.4
IF x<30
CALL _DrehenBBEnde ()
WZF (136,_VE,_V,_VA,_SD,_ANF,'1')
CALL _UserInterface3DG (REF RESULT:=toolID VAL INPUTTEXT:='GetSpecialSawID')
WZS (toolID,_VE,_V,_VA,_SD,_ANF,'1')
CALL _saege_y_V5 ( VAL SX:=x,SY:=y,SZ:=-3,EY:=y-1,EZ:=tiefe,BL:=0,EINPASSEN:=0,EL:=0,AL:=0,PARALLEL:=0,K:=0,KW:=0,BH:=0,RITZVERSATZ:=0.05,ESZ:=2,ESXY1:=1,ESY:=3)
/SP (x,y,2+_wzr,0,0,_ANF,0,-90,-90,1,0,0,0,_AT_MAXDEPTH,0,1,0,0,0,0,0,0,0)
/G01 (x-0.01,y,_wzr+tiefe,0,1,0)
/G01 (x,y,20+_wzr,0,1,0)
/EP (0,_ANF,0)
ELSE
CALL _DrehenBBEnde ()
WZF (136,_VE,_V,_VA,_SD,_ANF,'1')
CALL _UserInterface3DG (REF RESULT:=toolID VAL INPUTTEXT:='GetSpecialSawID')
WZS (toolID,_VE,_V,_VA,_SD,_ANF,'1')
CALL _saege_y_V5 ( VAL SX:=x,SY:=y,SZ:=-3,EY:=y+1,EZ:=tiefe,BL:=0,EINPASSEN:=0,EL:=0,AL:=0,PARALLEL:=0,K:=0,KW:=0,BH:=0,RITZVERSATZ:=0.05,ESZ:=2,ESXY1:=1,ESY:=3)
/SP (x,y,2+_wzr,0,0,_ANF,0,-90,-90,1,0,0,0,_AT_MAXDEPTH,0,1,0,0,0,0,0,0,0)
/G01 (x+0.01,y,_wzr+tiefe,0,1,0)
/G01 (x,y,20+_wzr,0,1,0)
/EP (0,_ANF,0)
END
END
ELSE
;P 14
IF d=6.1
CALL _DrehenBBEnde ()
IF x>100
x1 := _lx-x
IF x1>100
CALL B2Punkte_V5 ( VAL P1X:=0,P1Y:=0,P2X:=x1,P2Y:=0,ABSTAND:=-40,FARBE:=0,TEXT:='',TEXTHOEHE:=20,PFEILLAENGE:=20mm,PFEILEINNERHALB:=0,ESXY1:=3,ESXY2:=3)
;Stiftfräser = 1
IF _PSystemSTIFT=1
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
/CALL P_System_X_Mitte ( VAL WKZ_WINKELGETRIEBE:=_Clamex_Nuter_WKG_ID,WKZ_STIFTFRAESER:=139,WKZ_VORFRAESER:=107,EITI:=14.0,APV_1:=0,APV_2:=0,APV_3:=0,APV_4:=0,APV_5:=0,APV_6:=1,PDV_X_1:=9.5,PDV_X_2:=9.5,PDV_X_3:=150,PDV_X_5:=dx/2,PDV_X_4:=dx/2,PDV_X_6:=x1,PDV_Y_1:=60,PDV_Y_2:=0,PDV_Y_3:=60,PDV_Y_4:=60,PDV_Y_5:=0,PDV_Y_6:=y,AUSW_CLAMEXBISCO:=1,AUSWSTIFTFRAESER:=1,AUSWWKG:=0,AUSWVORFRAESER:=0)
ZText ('P-14 Stift',x-30,y,15,0,2,0,'Times New Roman',0,1,0,0,3)
ELSE
IF _MaschinenTYP=2
;EVO
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
/CALL P_System_X_Mitte_EVO_V6 ( VAL WKZ_WINKELGETRIEBE:=_Clamex_Nuter_Y_WKG_ID,EITI:=14.0,APV_1:=0,APV_2:=0,APV_3:=0,APV_4:=0,APV_5:=0,APV_6:=1,PDV_X_1:=DZ/2,PDV_X_2:=DZ/2,PDV_X_3:=DZ/2,PDV_X_5:=DZ/2,PDV_X_4:=DZ/2,PDV_X_6:=x1,PDV_Y_1:=60,PDV_Y_2:=0,PDV_Y_3:=60,PDV_Y_4:=60,PDV_Y_5:=0,PDV_Y_6:=y,AUSW_CLAMEXBISCO:=1)
ZText ('P-14 a',x1-20,y,15,0,2,0,'Times New Roman',0,1,0,0,3)
ELSE
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
/CALL P_System_X_Mitte ( VAL WKZ_WINKELGETRIEBE:=_Clamex_Nuter_WKG_ID,WKZ_STIFTFRAESER:=139,WKZ_VORFRAESER:=107,EITI:=14.0,APV_1:=0,APV_2:=0,APV_3:=0,APV_4:=0,APV_5:=0,APV_6:=1,PDV_X_1:=9.5,PDV_X_2:=9.5,PDV_X_3:=150,PDV_X_5:=dx/2,PDV_X_4:=dx/2,PDV_X_6:=x1,PDV_Y_1:=60,PDV_Y_2:=0,PDV_Y_3:=60,PDV_Y_4:=60,PDV_Y_5:=0,PDV_Y_6:=y,AUSW_CLAMEXBISCO:=1,AUSWSTIFTFRAESER:=0,AUSWWKG:=1,AUSWVORFRAESER:=0)
ZText ('P-14 WKG',x,y,15,0,2,0,'Times New Roman',0,1,0,0,1)
END
END
ELSE
;Clamex Rechts P14
CALL B2Punkte_V5 ( VAL P1X:=0,P1Y:=0,P2X:=x1,P2Y:=0,ABSTAND:=-40,FARBE:=0,TEXT:='',TEXTHOEHE:=20,PFEILLAENGE:=20mm,PFEILEINNERHALB:=0,ESXY1:=3,ESXY2:=3)
IF _MaschinenTYP=2
;EVO
IF textsame(_Teiletyp,'Mittelseite')
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
/CALL P_System_X_Mitte_EVO_V6 ( VAL WKZ_WINKELGETRIEBE:=_Clamex_Nuter_Y_WKG_ID,EITI:=10.0,APV_1:=0,APV_2:=0,APV_3:=0,APV_4:=0,APV_5:=0,APV_6:=1,PDV_X_1:=DZ/2,PDV_X_2:=DZ/2,PDV_X_3:=DZ/2,PDV_X_5:=DZ/2,PDV_X_4:=DZ/2,PDV_X_6:=x1,PDV_Y_1:=60,PDV_Y_2:=0,PDV_Y_3:=60,PDV_Y_4:=60,PDV_Y_5:=0,PDV_Y_6:=y,AUSW_CLAMEXBISCO:=0)
ZText ('P-10',x,y,15,0,6,0,'Times New Roman',0,1,0,0,1)
ELSE
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
/CALL P_System_X_Mitte_EVO_V6 ( VAL WKZ_WINKELGETRIEBE:=_Clamex_Nuter_Y_WKG_ID,EITI:=14.0,APV_1:=0,APV_2:=0,APV_3:=0,APV_4:=0,APV_5:=0,APV_6:=1,PDV_X_1:=DZ/2,PDV_X_2:=DZ/2,PDV_X_3:=DZ/2,PDV_X_5:=DZ/2,PDV_X_4:=DZ/2,PDV_X_6:=x1,PDV_Y_1:=60,PDV_Y_2:=0,PDV_Y_3:=60,PDV_Y_4:=60,PDV_Y_5:=0,PDV_Y_6:=y,AUSW_CLAMEXBISCO:=1)
ZText ('P-14 c',x,y,15,0,6,0,'Times New Roman',0,1,0,0,1)
END
ELSE
IF textsame(_Teiletyp,'Mittelseite');BREAKPOINT
CALL P_S_BASE_FLAT ( VAL POSX:=x,POSY:=y,POSZ_WI:=0,EITI:=tiefe,KIPPWINKEL:=0,DREHWINKEL:=90,WZ_ID_V1:=_Clamex_Nuter_X_WKG_ID,WZ_ID_V2:=_Clamex_Nuter_Y_WKG_ID,WZ_ID_STIFT:=_Clamex_Stiftfraeser_ID,WZ_STIFT_ON_OFF:=_PSystemStift,Z_BEWEG:=1,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0)
