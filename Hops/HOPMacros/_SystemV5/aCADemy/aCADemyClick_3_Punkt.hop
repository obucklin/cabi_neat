;MAKROTYP=1
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;AUTOSCRIPTSTART=0
VARS
   CADPX1 := 0;*VAR*Kreismittelpunkt (X.Y)
   CADPY1 := 0;*VAR*
   CADPX2 := 0;*VAR*Kreispunkt (X.Y)
   CADPY2 := 0;*VAR*
   CADPX3 := 0;*VAR*(X.Y)
   CADPY3 := 0;*VAR*
   Tiefe := 0;*VAR*
   sdfasdf := 0;
START
ZKBCW (CADPX1,CADPY1,CADPX1-10,CADPY1,CADPX1+10,CADPY1,0,0,0,0)
ZKBCW (CADPX2,CADPY2,CADPX2-10,CADPY2,CADPX2+10,CADPY2,0,0,0,0)
ZKBCW (CADPX3,CADPY3,CADPX3-10,CADPY3,CADPX3+10,CADPY3,0,0,0,0)
