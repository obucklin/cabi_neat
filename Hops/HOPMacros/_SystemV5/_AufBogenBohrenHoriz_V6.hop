;MAKROTYP=1
;DIALOGDLL=DialogsHopSys.Dll
;DIALOGPROC=Show_AufBogenBohrenHoriz_V6Dialog
;AUTOSCRIPTSTART=0
VARS
   MX := 0;*VAR*MITTELPUNKT DES BOGENS X
   MY := 0;*VAR*MITTELPUNKT DES BOGENS Y
   Z := 0;*VAR*BOHRPOSITION Z
   R := _RY/2-50;*VAR*RADIUS DES BOGENS
   DW := 360;*VAR*DREHWINKEL
   AW := 0;*VAR*ANFANGSWINKEL
   A := 12;*VAR*ANZAHL BOHRUNGEN
   T := -30;*VAR*BOHRTIEFE
   DELTA := 0;DELTAWINKEL
   X := 0;BOHRPOSITION
   Y := 0;BOHRPOSITION
   XB := 0;ERSTEPOSITION
   YB := 0;ERSTEPOSITION
   I := 0;
   AKTW := 0;AKTUELLEWINKEL
   D := 8;*VAR*Bohrungsdurchmesser
   DR_WINKEL := 0;*VAR*0= Von Innen 180 = Von Aussen
   esz := 1;*VAR*
   esxy := 9;*VAR*
   TL := 0;*VAR*Tieflochflag
START
;DIREKT CNC SYSTEME GMBH
;BOHRUNGEN WERDEN AUF EINEM KREISBOGEN
;GEGEN DEN UHRZEIGERSINN ANGEORDNET
;.
transesxy (Mx,My,esxy,1)
Transesz (Z,esz)
IF DR_WINKEL = 0
DR_WINKEL := 0
ELSE
DR_WINKEL := 180
END
;-
WHILE DW>360
DW:=DW-360
END
IF T>0
T := -T
END
IF A>1
IF DW=360
DELTA := DW/A
ELSE
DELTA := DW/(A-1)
END
AKTW:=AW
XB:=MX+R*COS(AKTW)
YB:=MY+R*SIN(AKTW)
FOR I := 1 TO A STEP 1
X:=MX+R*COS(AKTW)
Y:=MY+R*SIN(AKTW)
AKTW:=AKTW+DELTA
IF I=A
IF (X<>XB)|(Y<>YB)
HorzB (X,Y,Z,D,T,TL,0,AKTW-DELTA+DR_WINKEL)
END
ELSE
HorzB (X,Y,Z,D,T,TL,0,AKTW-DELTA+DR_WINKEL)
END
END
END
