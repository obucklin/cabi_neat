;MAKROTYP=1
;DIALOGDLL=DialogsHopKonturen.Dll
;DIALOGPROC=Show_KKorb_3R_G02_V5Dialog
VARS
   Name := '';*VAR*KonturElementname
   SX := 0;Startpunkt in X
   SY := 0;Startpunkt in Y
   Br := 2000;*VAR*Gesamtbreite
   Stich := 400;*VAR*Stich
   HolzBr := 0;*VAR*Holzbreite
   Z := 0;*VAR*Zustelltiefe
   Info := '';*VAR*KonturElementinfo
   _K3R2 := 0;Radius Gross Aussen
   _K3R1 := 0;Radius Klein Aussen
   _K3R4 := 0;Radius Gross Innen
   _K3R3 := 0;Radius Klein Innen
   X := 0;Schnittpunkt in X
   Y := 0;Schnittpunkt in Y
   a := 0;Variablenberechnung
   S := 0;Variablenberechnung
   S1 := 0;Variablenberechnung
   W1 := 0;Winkel1
   R1 := 0;Radius erster Bogen
   b := 0;Variablenberechnung
   R2 := 0;Radius2
   S2 := 0;Variablenberechnung
   W2 := 0;Winkel2
   esd := 2;*VAR*
START
;direkt cnc systeme NCHOPS Version 4
transesd (z,esd)
Rohteil (Br,Stich,1,0,0)
;*********
a := (Br/2)-(Stich)
S := sqrt(sqr(Br/2)+sqr(Stich))
S1 := (S-a)/2
W1 := arccos((Br/2)/(S))
R1 := S1/cos(W1)
b := (Br/2)-R1
S2 := b/tan(W1)
R2 := (Stich)+S2
W2 := 360-90-W1
X := -cos(W2)*R1
Y := -sin(W2)*R1
HGNeu()
IF Holzbr=0
HLineY (_Y)
HKreismpr (_X+Br/2,_Y+Stich-R2,R2)
HKreismpr (_X+R1,_Y,R1)
HKreismpr (_X+Br-R1,_Y,R1)
_K3R2 := R2
_K3R1 := R1
ZText ('_K3R2='+ FloatToStr(R2,8,3)+' / _K3R1='+ FloatToStr(R1,8,3),SX+Br/2,SY+Stich+10,15,0,8,0,'',0,0,0,0)
CALL _KG02R ( VAL EN:=Name,EX:=_SPX5,EY:=_SPY5,EZ:=Z,R:=_K3R1,EI:=Info)
CALL _KG02R ( VAL EN:='',EX:=_SPX9,EY:=_SPY9,EZ:=Z,R:=_K3R2,EI:=Info)
CALL _KG02R ( VAL EN:='',EX:=_SPX7,EY:=_SPY7,EZ:=Z,R:=_K3R1,EI:=Info)
ELSE
_X := _X-HolzBr
HLineY (_Y)
HKreismpr (_X+Br/2,_Y+Stich-R2,R2-HolzBr)
HKreismpr (_X+R1,_Y,R1-HolzBr)
HKreismpr (_X+Br-R1,_Y,R1-HolzBr)
_X := _spx4
_K3R4 := R2-HolzBr
_K3R3 := R1-HolzBr
ZText ('_K3R4='+ FloatToStr(R2-HolzBr,8,3)+' / _K3R3='+ FloatToStr(R1-HolzBr,8,3),SX+Br/2,SY+Stich-HolzBr+10,15,0,8,0,'',0,0,0,0)
;CALL _KG03R ( VAL EN:=Name,EX:=_SPX5,EY:=_SPY5,EZ:=_Z,R:=_K3R3,EI:='')
;CALL _KG03R ( VAL EN:='',EX:=_SPX9,EY:=_SPY9,EZ:=_Z,R:=_K3R4,EI:='')
;CALL _KG03R ( VAL EN:='',EX:=_SPX7,EY:=_SPY7,EZ:=_Z,R:=_K3R3,EI:='')
CALL _KG02R ( VAL EN:=Name,EX:=_SPX5,EY:=_SPY5,EZ:=Z,R:=_K3R3,EI:=Info)
CALL _KG02R ( VAL EN:='',EX:=_SPX9,EY:=_SPY9,EZ:=Z,R:=_K3R4,EI:=Info)
CALL _KG02R ( VAL EN:='',EX:=_SPX7,EY:=_SPY7,EZ:=Z,R:=_K3R3,EI:=Info)
END
HGNeuEnd()
