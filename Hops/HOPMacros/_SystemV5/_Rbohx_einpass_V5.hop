;MAKROTYP=1
;DIALOGDLL=DialogsHopSys.Dll
;DIALOGPROC=Show_Rbohx_einpass_V5Dialog
;AUTOSCRIPTSTART=0
VARS
   einpassen := 0;*VAR*Einpassen   1=Ja   0=Nein
   SPX := 64;*VAR*Mindestwert für Strartpunkt
   SPY := 37;*VAR*StartPunkt (y)
   SPY2 := 0;*VAR*Lage der 2. Reihe
   Raster := 32mm;*VAR*Rasterwerte
   EPX := 64;*VAR*Mindestwert für Endpunkt
   T := -13;*VAR*Bohrtiefe
   D := 5mm;*VAR*Bohrdurchmesser
   TLF := 0;*VAR*Tieflochflag
   Anzahl := 0;Anzahl Löcher
   Rest := 0;Restwert links
   i := 0;
   länge := 0;
   MerkerSPX := 0;
   esxy := 1;*VAR*
   esx := 3;*VAR*
   esy := 5;*VAR*
   esd := 0;*VAR*
   Use2 := 0;*VAR*
   Dummy := 0;
START
;direkt cnc systeme NCHOPS Version 3.4
;Lochreihe in X / MD/04.01
;--
;-- MW / SF 11.05.2009
;-- Reihenbohrung auch auf freien Ebenen möglich
;--
;-- Der Easysnap esx (links - mitte - rechts ) muss in Abhängigkeit von esxy auch Y berücksichtigen
;--
;--
;--
CALL _Trans_ESX_2_ESXY (REF ESX:=esx VAL ESXY:=esxy)
CALL _Trans_ESY_2_ESXY (REF ESY:=esy VAL ESXY:=esxy)
;--
;--
;--
;--
;--
Transesd (T,esd)
;--
;-- Hier bisher Trans immer bezogen auf View=0
transesxy (SPx,SPy,esxy,0)
transesxy (dummy,SPY2,esy,0)
transesxy (EPX,dummy,esx,0)
Raster := abs(Raster)
;epx := 295
IF (SPX>EPX)&(einpassen=1)
;--
;-- MW 12.12.2007
;-- wenn Referenzpunkt rechts
;-- MW 16.01.2008
;-- nur wenn einpassen gewählt
MerkerSPX := SPX
SPX := EPX
EPX := MerkerSPX
END
IF T>0
T := -T
END
;*****   1. Reihe  *****
MerkerSPX := SPX
IF einpassen = 1
länge := epx-spx
anzahl := (länge)/Raster
anzahl := anzahl DIV 1 +1
rest := (länge-(anzahl-1)*Raster)/2
FOR i := 0 TO anzahl-1 STEP 1
Bohrung (spx+rest+i*raster,spy,D,T,TLF,0,0)
END
ELSE
IF EPX > SPX
WHILE SPX <= EPX
Bohrung (SPX,SPY,D,T,TLF,0,0)
SPX := SPX + Raster
END
ELSE
WHILE SPX >= EPX
Bohrung (SPX,SPY,D,T,TLF,0,0)
SPX  :=  SPX - Raster
END
END
END
;*****   2. Reihe  *****
;IF SPY2<>0
IF Use2<>0
SPX := MerkerSPX
i := 0
SPY := SPY2
IF einpassen = 1
länge := epx-spx
anzahl := (länge)/Raster
anzahl := anzahl DIV 1 +1
rest := (länge-(anzahl-1)*Raster)/2
FOR i := 0 TO anzahl-1 STEP 1
Bohrung (spx+rest+i*raster,spy,D,T,TLF,0,0)
END
ELSE
IF EPX > SPX
WHILE SPX <= EPX
Bohrung (SPX,SPY,D,T,TLF,0,0)
SPX := SPX + Raster
END
ELSE
WHILE SPX >= EPX
Bohrung (SPX,SPY,D,T,TLF,0,0)
SPX  :=  SPX - Raster
END
END
END
END
