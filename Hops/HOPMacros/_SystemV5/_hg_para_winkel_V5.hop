;MAKROTYP=1
;DIALOGDLL=DialogsHopSys.Dll
;DIALOGPROC=Show_hg_para_winkel_V5Dialog
VARS
   para := 50;*VAR*Parallele
   x1 := 0;*VAR*1. Schnittpunkt in X
   y1 := 0;*VAR*1. Schnittpunkt in Y
   winkel := 45;*VAR*Winkel der Eingangspunkte
   RotMX := 0;
   RotMY := 0;
   RotW := 45;
   AktPosY := 0;
   AktPosX := 0;
   y := 0;
   x := 0;
   wert := 0;
   esxy1 := 0;*VAR*
START
;Rohteil (1000,1000,19,0,0)
;direkt cnc systeme NCHOPS Version 3.4
;Hilfgeometrie über Winkel  incl. Parallele
transesxy (x1,y1,esxy1,0)
RotMX := x1
RotMY := y1
RotW := -winkel
;CALL SetRotPara (VAL MX:=X1,MY:=Y1,RotW:=winkel)
AktPosX := x1
AktPosY := y1-para
;CALL SetPunkt (VAL X:=x1,Y:=Y1-para)
X := AktPosX
Y := AktPosY
X := (X-RotMX)
Y := (Y-RotMY)
Wert := X
X := x*cos(RotW) + y*sin(RotW)
Y := - Wert*sin(RotW) + y*cos(RotW)
X := (X+RotMX)
Y := (Y+RotMY)
AktPosX := X
AktPosY := Y
;CALL RotUmPunkt ()
HLineW (aktposx,aktposy,winkel)
