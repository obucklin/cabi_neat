;MAKROTYP=1
;DIALOGDLL=DialogsHopKonturen.Dll
;DIALOGPROC=Show_KEllipsenbogen02_V5Dialog
VARS
   Name := '';*VAR*Konturelementname
   mx := 0;*VAR*Mitte in X
   my := 0;*VAR*Mitte in Y
   a := _RX/2;*VAR*Laenge der waagrechten Halbachse
   b := _RY/2;*VAR*Laenge der senkrechten Halbachse
   ew := 0;*VAR*Endwinkel Ellipse X+ = 0°
   Z := 0;*VAR*Zustellung
   dw := 0;*VAR*Drehwinkel
   Info := '';*VAR*Konturelementinfo
   _KonturElementName := '';
   _KonturElementInfo := '';
   esxy := 9;*VAR*
   esd := 2;*VAR*
START
transesxy (mx,my,esxy,0)
transesd (z,esd)
_KonturElementName := Name
_KonturElementInfo := Info
CALLDLL KELLIPSENBOGEN02(Fraesen,Dummy, VAL mx:=mx,my:=my,a:=a,b:=b,ew:=ew,Z:=Z,dw:=dw)
