;MAKROTYP=1
;INSTVERSION=
;EXEVERSION=7.11.0.182[Hops.exe]
;BILD=_RBOHX_EINPASS_HORZ_V6.WMF
;INFO=_RBohX_einpass_Horz_V6
;WZGV=7605_071222
;WZGVCONFIG=
;MASCHINE=HH_PPIN
;NCNAME=
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=DialogsHopSys.Dll
;DIALOGPROC=Show_Rbohx_einpass_Horz_V6Dialog
;DIALOGKIND=0
;AUTOSCRIPTSTART=0
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   ebene := 0;*VAR*
   einpassen := 0;*VAR*Einpassen   1=Ja   0=Nein
   SPX := 64;*VAR*Mindestwert für Strartpunkt
   PosY := 0;
   Raster := 32mm;*VAR*Rasterwerte
   EPX := 64;*VAR*Mindestwert für Endpunkt
   T := -13;*VAR*Bohrtiefe
   D := 8;*VAR*Bohrdurchmesser
   Anzahl := 0;Anzahl Löcher
   Rest := 0;Restwert links
   i := 0;
   länge := 0;
   MerkerSPX := 0;
   esx1 := 1;*VAR*
   esx := 3;*VAR*
   Dummy := 0;
   TL := 0;*VAR*Tieflochflag
   Z := 0;*VAR*
   esz := 1;*VAR*
   DW := 0;
   ToolID := -999;
START
;HH_POWER-PIN_Erweiterung_
;25.04.2023
;Stirnseitenbohrungen in X
CALL _UserInterface3DG (REF RESULT:=ToolID VAL INPUTTEXT:='GetStandardRouterID')
IF _MaschinenTyp=7
CALL HH_POWERPIN_EDGE ( VAL PARA1:=2)
END
Transesz (Z,esz)
transesxy (SPx,dummy,esx1,1)
transesxy (EPX,dummy,esx,1)
Raster := abs(Raster)
IF ebene=0
PosY := 0
DW := 90
ELSE
PosY := _RY
DW := 270
END
IF (SPX>EPX)&(einpassen=1)
;--
;-- wenn Referenzpunkt rechts
;-- nur wenn einpassen gewählt
MerkerSPX := SPX
SPX := EPX
EPX := MerkerSPX
END
IF T>0
T := -T
END
MerkerSPX := SPX
IF einpassen = 1
länge := epx-spx
anzahl := (länge)/Raster
anzahl := anzahl DIV 1 +1
rest := (länge-(anzahl-1)*Raster)/2
FOR i := 0 TO anzahl-1 STEP 1
HorzB (spx+rest+i*raster,PosY,Z,D,T,TL,0,DW,0,0,0,0)
END
ELSE
IF EPX > SPX
WHILE SPX <= EPX
HorzB (SPX,PosY,Z,D,T,TL,0,DW,0,0,0,0)
SPX := SPX + Raster
END
ELSE
WHILE SPX >= EPX
HorzB (SPX,PosY,Z,D,T,TL,0,DW,0,0,0,0)
SPX  :=  SPX - Raster
END
END
END
