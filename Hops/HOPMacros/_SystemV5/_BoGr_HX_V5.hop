;MAKROTYP=1
;DIALOGDLL=DialogsHopSys.Dll
;DIALOGPROC=Show_BoGr_HX_V5Dialog
;AUTOSCRIPTSTART=0
VARS
   BIX := 64;*VAR*Bohrung1 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIX := 64+37;*VAR*Bohrung2 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIIX := 0;*VAR*Bohrung3 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIIIX := 0;*VAR*Bohrung4 (Wert=0-> Bohrung wird nicht abgesetzt)
   Z := 0;*VAR*Z-Wert von der Unterkante
   Spiegeln := 0;*VAR*1=>gespiegelt
   T := -30;*VAR*Bohrtiefe
   D := 8mm;*VAR*Bohrdurchmesser
   Ebene := 0;*VAR*Ebene 1 oder Ebene 3
   YP := 0;Y Position
   DW := 90;Drehwinkel
   TL := 0;Tieflochflag
   Inkrement := 0;*VAR*Absolut oder Inkremental
   B1 := 0;Bohrung 1
   B2 := 0;Bohrung 2
   B3 := 0;Bohrung 3
   B4 := 0;Bohrung 4
   esx := 1;*VAR*
   esz := 1;*VAR*
   use2 := 1;*VAR*
   use3 := 0;*VAR*
   use4 := 0;*VAR*
   DummyY := 0;
START
;direkt cnc systeme NCHOPS Version 4
;Stirnseitenbohrungen in X
Transesz (Z,esz)
IF T>0
T := -T
END
;*****************  Auswerten Ebenen zwecks Dialog 0/1
IF ebene=0
ebene := 1
ELSE
ebene := 3
END
;*****************************************
IF (Ebene<>1)&(Ebene<>3)
Fehlermeldung (GetMessageText('2','Falsche Ebene gewählt'))
END
IF Ebene=1
YP := 0
DW := 90
END
IF Ebene=3
YP := _RY
DW := 270
END
IF Inkrement=0
transesxy (BIX,DummyY,esx,1)
transesxy (BIIX,DummyY,esx,1)
transesxy (BIIIX,DummyY,esx,1)
transesxy (BIIIIX,DummyY,esx,1)
;IF (BIX<>0)
HorzB (BIX,YP,Z,D,T,TL,0,DW)
;END
;IF (BIIX<>0)
IF (Use2<>0)
HorzB (BIIX,YP,Z,D,T,TL,0,DW)
END
;IF (BIIIX<>0)
IF (Use3<>0)
HorzB (BIIIX,YP,Z,D,T,TL,0,DW)
END
;IF (BIIIIX<>0)
IF (Use4<>0)
HorzB (BIIIIX,YP,Z,D,T,TL,0,DW)
END
;Gespiegelte Bohrungen
IF Spiegeln <> 0
;IF (BIX<>_RX/2)&(BIX<>0)
HorzB (_RX-BIX,YP,Z,D,T,TL,0,DW)
;END
;IF (BIIX<>_RX/2)&(BIIX<>0)
IF (Use2<>0)
HorzB (_RX-BIIX,YP,Z,D,T,TL,0,DW)
END
;IF (BIIIX<>_RX/2)&(BIIIX<>0)
IF (Use3<>0)
HorzB (_RX-BIIIX,YP,Z,D,T,TL,0,DW)
END
;IF (BIIIIX<>_RX/2)&(BIIIIX<>0)
IF (Use4<>0)
HorzB (_RX-BIIIIX,YP,Z,D,T,TL,0,DW)
END
END
ELSE
B1 := BIX
B2 := BIX+BIIX
B3 := BIX+BIIX+BIIIX
B4 := BIX+BIIX+BIIIX+BIIIIX
transesxy (B1,DummyY,esx,1)
transesxy (B2,DummyY,esx,1)
transesxy (B3,DummyY,esx,1)
transesxy (B4,DummyY,esx,1)
;IF (BIX<>0)
HorzB (B1,YP,Z,D,T,TL,0,DW)
;END
;IF (BIIX<>0)
IF (Use2<>0)
HorzB (B2,YP,Z,D,T,TL,0,DW)
END
;IF (BIIIX<>0)
IF (Use3<>0)
HorzB (B3,YP,Z,D,T,TL,0,DW)
END
;IF (BIIIIX<>0)
IF (Use4<>0)
HorzB (B4,YP,Z,D,T,TL,0,DW)
END
;Gespiegelte Bohrungen
IF Spiegeln <> 0
;IF (BIX<>_RX/2)&(BIX<>0)
HorzB (_RX-B1,YP,Z,D,T,TL,0,DW)
;END
;IF (BIIX<>_RX/2)&(BIIX<>0)
IF (Use2<>0)
HorzB (_RX-B2,YP,Z,D,T,TL,0,DW)
END
;IF (BIIIX<>_RX/2)&(BIIIX<>0)
IF (Use3<>0)
HorzB (_RX-B3,YP,Z,D,T,TL,0,DW)
END
;IF (BIIIIX<>_RX/2)&(BIIIIX<>0)
IF (Use4<>0)
HorzB (_RX-B4,YP,Z,D,T,TL,0,DW)
END
END
END
