;MAKROTYP=1
;DIALOGDLL=DialogsHopSys.Dll
;DIALOGPROC=Show_Rbohx_einpass_Horz_V5Dialog
;AUTOSCRIPTSTART=0
VARS
   ebene := 0;*VAR*
   einpassen := 0;*VAR*Einpassen   1=Ja   0=Nein
   SPX := 64;*VAR*Mindestwert für Strartpunkt
   PosY := 0;
   Raster := 32mm;*VAR*Rasterwerte
   EPX := 64;*VAR*Mindestwert für Endpunkt
   T := -13;*VAR*Bohrtiefe
   D := 5mm;*VAR*Bohrdurchmesser
   Anzahl := 0;Anzahl Löcher
   Rest := 0;Restwert links
   i := 0;
   länge := 0;
   MerkerSPX := 0;
   esx1 := 1;*VAR*
   esx := 3;*VAR*
   Dummy := 0;
   TL := 0;Tieflochflag
   Z := 0;*VAR*
   esz := 1;*VAR*
   DW := 0;
START
;DIREKT CNC SYSTEME / NC-HOPS Version 5.x
;Lochreihe in X horizontal
Transesz (Z,esz)
transesxy (SPx,dummy,esx1,1)
transesxy (EPX,dummy,esx,1)
IF ebene=0
PosY := 0
DW := 90
ELSE
PosY := _RY
DW := 270
END
IF (SPX>EPX)&(einpassen=1)
;--
;-- wenn Referenzpunkt rechts
;-- nur wenn einpassen gewählt
MerkerSPX := SPX
SPX := EPX
EPX := MerkerSPX
END
IF T>0
T := -T
END
MerkerSPX := SPX
IF einpassen = 1
länge := epx-spx
anzahl := (länge)/Raster
anzahl := anzahl DIV 1 +1
rest := (länge-(anzahl-1)*Raster)/2
FOR i := 0 TO anzahl-1 STEP 1
HorzB (spx+rest+i*raster,PosY,Z,D,T,TL,0,DW,0,0,0,0)
END
ELSE
IF EPX > SPX
WHILE SPX <= EPX
HorzB (SPX,PosY,Z,D,T,TL,0,DW,0,0,0,0)
SPX := SPX + Raster
END
ELSE
WHILE SPX >= EPX
HorzB (SPX,PosY,Z,D,T,TL,0,DW,0,0,0,0)
SPX  :=  SPX - Raster
END
END
END
