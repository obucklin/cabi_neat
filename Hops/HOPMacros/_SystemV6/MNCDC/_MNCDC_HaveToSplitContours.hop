;MAKROTYP=1
;AUTOSCRIPTSTART=0
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowHAVETOSPLITCONTOURSPARSEREXTCONTOURSDialog
VARS
   CONTOURNAME_CONTOURNAMES := '';*VAR*
   Tiefe := 0;*VAR*
   ToolID := 0;*VAR*
   MaxArcTol := 0.1mm;*VAR*
   View_OffX := 0;*VAR*
   View_OffY := 0;*VAR*
   View_OffZ := 0;*VAR*
   View_RotA := 0;*VAR*
   View_TipA := 0;*VAR*
   Result := 0;*VAR**REF*
   InClampArea := 0;*VAR**REF*
START
;Konturen teilen ermitteln über DLL
CALLDLL HAVETOSPLITCONTOURSPARSEREXTCONTOURS(MNCDC,DefaultStr,REF INCLAMPAREA:=InClampArea,RESULT:=Result VAL CONTOURNAME_CONTOURNAMES:=CONTOURNAME_CONTOURNAMES,TIEFE:=Tiefe,TOOLID:=ToolID,MAXARCTOL:=MaxArcTol,VIEW_OFFX:=View_OffX,VIEW_OFFY:=View_OffY,VIEW_OFFZ:=View_OffZ,VIEW_ROTA:=View_RotA,VIEW_TIPA:=View_TipA)
