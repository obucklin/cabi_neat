;MAKROTYP=1
;BILD=BRadius.bmp
;INFO=BT_BRadius
;WZGV=demo
;MASCHINE=Simu
;NCNAME=BRadius
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
VARS
   MX := 0;*VAR*Kreismittelpunkt in X
   MY := 0;*VAR*KreisMittelpunkt inY
   PX := 100;*VAR*Punkt auf Kreisbogen
   PY := 100;*VAR*Punkt auf Kreisbogen
   Abstand := 100;*VAR*
   Farbe := 0;*VAR*
   Text := '';*VAR*Text zum überschreiben
   TextHöhe := 20;*VAR*Texthöhe
   Pfeillänge := 30;*VAR*
   PfeileInnerhalb := 0;*VAR*Bemaßungspfeile innerhalb
   _AktDimValue := 0;
   dx := 0;
   dy := 0;
   l := 0;
   dxn := 0;
   dyn := 0;
   WinkelBem := 0;
   Radius := 0;
   EndPosX := 0;
   EndPosY := 0;
   Pfeilwinkel := 15;
START
;DIRECT CNC SYSTEME NCHOPS Version 4.x
Rohteil (1000,2000,19,0,0)
Abstand := abs(Abstand)
Pfeillänge := abs(Pfeillänge)
IF PfeileInnerhalb=0
Abstand := -Abstand
END
dx := MX-PX
dy := MY-PY
IF (dx<>0)|(dy<>0)
CALL Dist2P_V4 (REF Dist:=l VAL P1X:=MX,P1Y:=MY,P2X:=PX,P2Y:=PY)
dx := Abstand*(dx/l)
dy := Abstand*(dy/l)
CALL Pfeil_V4 (REF EndPosX:=EndPosX,EndPosY:=EndPosY VAL P1X:=PX,P1Y:=PY,P2X:=PX+dx,P2Y:=PY+dy,Länge:=Pfeillänge,Farbe:=Farbe,Pfeilwinkel:=Pfeilwinkel)
ZLinie(EndPosX,EndPosY,Px+dx,Py+dy,Farbe)
;Text ausgeben
Radius := sqrt(sqr(MX-PX)+sqr(MY-PY))
CALL GetWinkel2P_V4 (REF Winkel2P:=WinkelBem VAL P1X:=Px+dx,P1Y:=Py+dy,P2X:=Px,P2Y:=Py)
IF StrLength(Text)=0
CALL FloatToStr_V4 (REF StrWert:=Text VAL Wert:=Radius)
_AktDimValue := Radius
Text := 'R'+Text
END
IF ((WinkelBem>=0)&(WinkelBem<=90))|((WinkelBem>270)&(WinkelBem<=360))
ZText(Text,Px+dx,Py+dy,Texthöhe,WinkelBem,1,Farbe)
ELSE
IF ((WinkelBem>90)&(WinkelBem<=270))
WinkelBem := WinkelBem+180
ZText(Text,Px+dx,Py+dy,TextHöhe,WinkelBem,7,Farbe)
ELSE
END
END
END
