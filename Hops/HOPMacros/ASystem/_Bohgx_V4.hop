;MAKROTYP=1
;BILD=Bohgx.WMF
;INFO=_Bohgx
;WZGV=demo
;MASCHINE=Simu
;NCNAME=_Bohgx_V4
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
VARS
   SPY := 10;*VAR*Startwert (y)
   BIX := 64;*VAR*Bohrung1 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIX := 64+37;*VAR*Bohrung2 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIIX := 0;*VAR*Bohrung3 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIIIX := 0;*VAR*Bohrung4 (Wert=0-> Bohrung wird nicht abgesetzt)
   Spiegeln := 0;*VAR*1=>gespiegelt
   T := -13;*VAR*Bohrtiefe
   D := 8;*VAR*Bohrdurchmesser
   TLF := 0;*VAR*Tieflochflag
   Inkrement := 0;*VAR*Absolut oder Inkremental
   B1 := 0;Bohrung 1
   B2 := 0;Bohrung 2
   B3 := 0;Bohrung 3
   B4 := 0;Bohrung 4
START
;direkt cnc systeme NCHOPS Version 4.x
;Bohrgruppe in X
IF T>0
T := -T
END
IF Inkrement=0
IF (BIX<>0)
Bohrung (BIX,SPY,D,T,TLF,0,0)
END
IF (BIIX<>0)
Bohrung (BIIX,SPY,D,T,TLF,0,0)
END
IF (BIIIX<>0)
Bohrung (BIIIX,SPY,D,T,TLF,0,0)
END
IF (BIIIIX<>0)
Bohrung (BIIIIX,SPY,D,T,TLF,0,0)
END
;Gespiegelte Bohrungen
IF Spiegeln <> 0
IF (BIX<>_RX/2)&(BIX<>0)
Bohrung (_RX-BIX,SPY,D,T,TLF,0,0)
END
IF (BIIX<>_RX/2)&(BIIX<>0)
Bohrung (_RX-BIIX,SPY,D,T,TLF,0,0)
END
IF (BIIIX<>_RX/2)&(BIIIX<>0)
Bohrung (_RX-BIIIX,SPY,D,T,TLF,0,0)
END
IF (BIIIIX<>_RX/2)&(BIIIIX<>0)
Bohrung (_RX-BIIIIX,SPY,D,T,TLF,0,0)
END
END
ELSE
B1 := BIX
B2 := BIX+BIIX
B3 := BIX+BIIX+BIIIX
B4 := BIX+BIIX+BIIIX+BIIIIX
IF (BIX<>0)
Bohrung (B1,SPY,D,T,TLF,0,0)
END
IF (BIIX<>0)
Bohrung (B2,SPY,D,T,TLF,0,0)
END
IF (BIIIX<>0)
Bohrung (B3,SPY,D,T,TLF,0,0)
END
IF (BIIIIX<>0)
Bohrung (B4,SPY,D,T,TLF,0,0)
END
;Gespiegelte Bohrungen
IF Spiegeln <> 0
IF (BIX<>_RX/2)&(BIX<>0)
Bohrung (_RX-B1,SPY,D,T,TLF,0,0)
END
IF (BIIX<>_RX/2)&(BIIX<>0)
Bohrung (_RX-B2,SPY,D,T,TLF,0,0)
END
IF (BIIIX<>_RX/2)&(BIIIX<>0)
Bohrung (_RX-B3,SPY,D,T,TLF,0,0)
END
IF (BIIIIX<>_RX/2)&(BIIIIX<>0)
Bohrung (_RX-B4,SPY,D,T,TLF,0,0)
END
END
END
