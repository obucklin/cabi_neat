;MAKROTYP=1
;DZ=0
;DY=0
;DX=0
;KOMMENTAR=
;NCNAME=NCName
;MASCHINE=Simu
;WZGV=demo
;BILD=WGerade.WMF
VARS
   Laenge := ;*VAR*Länge der Geraden
   Winkel := ;*VAR*Winkel gegen X
   Z := _Z;*VAR*Zustelltiefe
   R := 0;*VAR*verrundungsradius
START
G01 (_X+laenge*cos(Winkel),_Y+laenge*sin(Winkel),Z,R)

