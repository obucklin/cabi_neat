;MAKROTYP=1
;DZ=0
;DY=0
;DX=0
;KOMMENTAR=
;NCNAME=NCNAME
;MASCHINE=Simu
;WZGV=demo
;BILD=_NutInY.bmp
VARS
   NB := 5;*VAR*Nutbreite
   NT := -5;*VAR*NutTiefe
   Ebene := 0;*VAR*Seite: 0->Links, <>0->Rechts
   ARand := 5;*VAR*Kleinere Abstand von Nut zum Rand
   AUnten := 0;*VAR*0 -> Rohteilunterkante, <>0 -> Abstand zu Rohteilunterkante mit Einpassen
   AOben := 0;*VAR*0 -> Rohteiloberkante, <>0 -> Abstand zu Rohteiloberkante mit Einpassen
   RK := 0;*VAR*Richtungs Kenner für Gleichlauf / Gegenlauf
   X := 0;
   Y1 := 0;
   Y2 := 0;
   EP1 := 0;Einpassen
   EP2 := 0;Einpassen
   Korr := 0;
   Saege_Art := 1;Säge fix = 0     Sägeaggregat = 1
   k := 1;Rechteck zeichnen
START
;direkt cnc systeme NCHOPS Version 3.4
;Sägenutx / .04.01
IF Ebene=0
;Linke Rohteilseite
X := ARand
Korr := 2
k := 1
ELSE
;Rechte Rohteilseite
X := _RX-ARand
Korr := 1
k := -1
END
Y1 := AUnten
Y2 := _RY-AOben
;Einpassen bestimmen
IF AUnten=0
EP1 := 0
ELSE
EP1 := -1
END
IF AOben=0
EP2 := 0
ELSE
EP2 := -1
END
CALL _nuten (VAL X1:=X,Y1:=Y1,X2:=X,Y2:=Y2,NB:=NB,Tiefe:=NT,LAGE:=Korr,SPEGA:=EP1,EPEGA:=EP2,RK:=RK)
ZRechteck (x,aunten,nb*k,_ry-aoben-aunten,0,0)

