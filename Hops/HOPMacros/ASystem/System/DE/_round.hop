;MAKROTYP=1
;DZ=0
;DY=0
;DX=0
;KOMMENTAR=
;NCNAME=NCName
;MASCHINE=Simu
;WZGV=demo
;BILD=_ROUND.WMF
VARS
   REST := 0;
   INC := 0;
START
;DIE'FUNKTION'ROUND
;RUNDETDIEGLOBALEVARIABLE_GKZ
REST := (_GKZ*10) MOD 10
IF (REST>=0)&(REST<=4)
INC:=0
ELSE
INC:=1
END
_GKZ := ((_GKZ*10) DIV 10)+INC
