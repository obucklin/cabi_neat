;MAKROTYP=1
;DZ=0
;DY=0
;DX=0
;KOMMENTAR=xxx
;NCNAME=simu
;MASCHINE=Simu
;WZGV=demo
;BILD=TascheWMF.bmp
VARS
   x_Mitte := _RX/2;*VAR*Taschenmitte in X
   Y_Mitte := _RY/2;*VAR*Taschenmitte in Y
   Taschenlaenge := _RX/2;*VAR*Tasche in X
   Taschenbreite := _RY/2;*VAR*Tasche in Y
   Radius := 0;*VAR*Eckenradius
   Winkel := 0;*VAR*Winkel gegen X-Achse
   Tiefe := 0;*VAR*Tiefe der Tasche
   Zustellung := 0;*VAR*Tiefenzustellung pro Fräsgang
   AusRäumen := 1;(1 = Ausräumen) (0 = Kontur fräsen)
   versatz := 10;Überlappung in %
   Schleifenzahl := 0;anzahl der Durchläufe
   GX := 0;Übergröße in X Richtung
   UW := 0;Zustellung Breite
   RM := 0;momentaner Radius
   GY := 0;Weg Y
   Durchlauf := 1;Nummer des Durchlauf
   RZ := 0;Radiuszustellung pro Durchgang
   UL := 0;Überlappung der Fräsbahn
   TU := 0;Nötiger fräsweg
   I := 1;Zähler
   ANZAHL := 0;
   TM := 0;Momentane Tiefe
   FRN := 0;
   _GKZ := 0;
   EPX := 1;
   APX := 2;
   winkel1 := 0;
   ÜberfahrKreisbogen := 2;
   KreisEndpunktY := 0;Kreisendpunkt in Y beim Überfahren des Endpunktes
   LängeGeradenStück := 0;
   Laenge := 0;
   UeberfahrwegX := 0.5;Überfahrweg in X
   MinimalerAbstand := 0.5;
START
;direkt cnc systeme NCHOPS Version3.4
;Tasche V3.4
;Benötigt Rechteck.hop,WGerade.hop
;Rohteil (508,383,16,0,0)
;WZF (8,_VE,_V,_VA,_SD,_ANF)
;Eingabe
;Unterschied zum Quadrat
GX := Taschenlaenge-Taschenbreite
;Tiefeneingabe prüfen
IF Taschenbreite<_WZD
Fehlermeldung (WERKZEUG_GROESSER_ALS_BREITE)
END
IF Taschenlaenge<_WZD
Fehlermeldung (WERKZEUG_GROESSER_ALS_HOEHE)
END
IF Tiefe>0
Tiefe := -tiefe
END
IF AusRäumen <1
CALL _Rechteck (VAL x_Mitte:=x_mitte,Y_Mitte:=y_mitte,laenge:=Taschenlaenge,breite:=Taschenbreite,Radius:=Radius,Winkel:=Winkel,Tiefe:=Tiefe,Radiuskorrektur:=2,AB:=1)
ELSE
;Abfrage ob Schlitz
;Bestimmen ob xoder y länger
IF  GX<0
GX := -GX
TU := Taschenbreite-gx
Winkel1 := Winkel+90
ELSE
tu := Taschenlaenge-gx
Winkel1 := Winkel
END
IF Zustellung>0
Zustellung := -Zustellung
END
IF Zustellung=0
Zustellung := Tiefe
END
TM := 1
IF (TU<(2*_WZD))|(TU=(2*_WZD))
WHILE TM > Tiefe
IF TM=1
TM := 0
END
TM := TM+Zustellung
IF TM < Tiefe
TM := Tiefe
END
CALL _Rechteck (VAL x_Mitte:=x_Mitte,Y_Mitte:=y_Mitte,laenge:=Taschenlaenge,breite:=Taschenbreite,Radius:=Radius,Winkel:=Winkel,Tiefe:=TM,Radiuskorrektur:=2,AB:=1)
END
ELSE
Winkel := Winkel1
TM := 1
;Fräserversatz
WHILE Versatz >=100
ChangeVar (Versatz)
END
UL := _WZD/100*Versatz
UW := (_WZD/1.55)
;Drehen wenn nötig
IF Winkel<>0
DrehenBB()
END
;Radius verkleinern wenn nötig
IF Radius>TU/2
Radius := TU/2
END
;Abfragen ob Tasche groß genug
IF TU<_WZD
ZKBCW (X_Mitte,Y_Mitte,X_Mitte-_WZR,Y_Mitte,X_Mitte-_WZR,Y_Mitte,255)
ZLinie (X_Mitte+(sin(Winkel)*(Taschenbreite/2))-(cos(Winkel)*(Taschenlaenge/2)),Y_Mitte-(cos(Winkel)*(Taschenbreite/2))-(Sin(Winkel)*(Taschenlaenge/2)),X_Mitte-+(sin(Winkel)*(Taschenbreite/2))+(cos(Winkel)*(Taschenlaenge/2)),Y_Mitte-(cos(Winkel)*(Taschenbreite/2))+(Sin(Winkel)*(Taschenlaenge/2)),255)
ZLinie (X_Mitte+(sin(Winkel)*(Taschenbreite/2))+(cos(Winkel)*(Taschenlaenge/2)),Y_Mitte-(cos(Winkel)*(Taschenbreite/2))+(Sin(Winkel)*(Taschenlaenge/2)),X_Mitte-(sin(Winkel)*(Taschenbreite/2))+(cos(Winkel)*(Taschenlaenge/2)),Y_Mitte+(cos(Winkel)*(Taschenbreite/2))+(Sin(Winkel)*(Taschenlaenge/2)),255)
ZLinie (X_Mitte-(sin(Winkel)*(Taschenbreite/2))+(cos(Winkel)*(Taschenlaenge/2)),Y_Mitte+(cos(Winkel)*(Taschenbreite/2))+(Sin(Winkel)*(Taschenlaenge/2)),X_Mitte-(sin(Winkel)*(Taschenbreite/2))-(cos(Winkel)*(Taschenlaenge/2)),Y_Mitte+(cos(Winkel)*(Taschenbreite/2))-(Sin(Winkel)*(Taschenlaenge/2)),255)
ZLinie (X_Mitte-(sin(Winkel)*(Taschenbreite/2))-(cos(Winkel)*(Taschenlaenge/2)),Y_Mitte+(cos(Winkel)*(Taschenbreite/2))-(Sin(Winkel)*(Taschenlaenge/2)),X_Mitte-+(sin(Winkel)*(Taschenbreite/2))-(cos(Winkel)*(Taschenlaenge/2)),Y_Mitte-(cos(Winkel)*(Taschenbreite/2))-(Sin(Winkel)*(Taschenlaenge/2)),255)
ELSE
;Abfrage ob Bohrung
IF  (Taschenbreite=_WZD)&(Taschenlaenge=_WZD)
Bohrung (X_Mitte,Y_Mitte,_WZD,Tiefe,0,0,0)
ELSE
;Anzahl der Schleifen berechnen
IF UW=0
Fehlermeldung (Bitte_Werkzeug_definieren)
END
Schleifenzahl := TU/UW
Schleifenzahl := (Schleifenzahl DIV 2)+1
;Zustellung anpassen
UW := TU/Schleifenzahl
;Abfrage ob Radius zu groß
IF Radius > TU/2
Radius := TU/2
ELSE
END
;Wenn Quadrat und Radius= Seitenlänge dann Kreistasche fräsen
IF (Taschenlaenge=Taschenbreite)&(Radius=Taschenbreite/2)
;Kreistasche
WHILE TM>Tiefe
IF TM=1
TM := 0
ELSE
END
TM := TM+Zustellung
IF TM<Tiefe
TM := Tiefe
ELSE
END
IF (_WZR<Radius)&(_WZR>0)&(_WZR*2<Radius)
_GKZ := (Radius/(_WZR*0.9))/2
CALL _ROUND()
ANZAHL:=_GKZ*2+1
FRN := Radius/ANZAHL
FOR I := (ANZAHL DIV 2) TO 1 STEP -1
IF I=(ANZAHL DIV 2)
SP (X_Mitte-(Radius-(2*I-1)*FRN),Y_Mitte,TM,2,0,0,0,0,0)
END
IF I<>(ANZAHL DIV 2)
APX := X_Mitte+(Radius-(2*I+1)*FRN)
EPX := X_Mitte-(Radius-(2*I-1)*FRN)
G02M (EPX,Y_Mitte,_Z,(EPX+APX)/2,Y_Mitte,0)
END
APX := X_Mitte-(Radius-(2*I-1)*FRN)
EPX := X_Mitte+(Radius-(2*I-1)*FRN)
G02M (EPX,Y_Mitte,_Z,(EPX+APX)/2,Y_Mitte,0)
END
IF _X<X_Mitte+Radius
APX := _X
EPX := X_Mitte-Radius
G02M (EPX,Y_Mitte,_Z,(EPX+APX)/2,Y_Mitte,0)
APX := X_Mitte-Radius
EPX := X_Mitte+Radius
G02M (EPX,Y_Mitte,_Z,(EPX+APX)/2,Y_Mitte,0)
G02M (X_Mitte-Radius,Y_Mitte,_Z,x_Mitte,Y_Mitte,0)
G02M (X_Mitte+Radius,Y_Mitte,_Z,x_Mitte,Y_Mitte,0)
END
IF (_X-X_Mitte)>(_WZD)
G01 (X_Mitte,Y_Mitte,0,0)
END
EP (0,_ANF,0)
ELSE
IF (_WZR<>0)&(_WZR<Radius)
SP (X_Mitte+Radius,Y_Mitte,TM,2,0,0,0,0,0)
G02M (X_Mitte,Y_Mitte-Radius,Tiefe,X_Mitte,Y_Mitte,0)
G02M (_X,_Y,_Z,X_Mitte,Y_Mitte,0)
IF (Y_Mitte-_Y)>(_WZD)
G01 (X_Mitte,Y_Mitte,0,0)
END
EP (0,_ANF,0)
ELSE
Bohrung (x_Mitte,y_Mitte,_WZD,tiefe,0,0,0)
END
END
ZKBCW (x_Mitte,y_Mitte,x_Mitte-Radius,Y_Mitte,x_Mitte-Radius,Y_Mitte,0)
END
ELSE
;Rechtecktasche
;Radius setzen wenn Radius <> 0
IF Radius=0
ELSE
IF  Schleifenzahl<2
RZ := Radius
ELSE
RZ := Radius/(Schleifenzahl-1)
END
;Abfragen ob Radiuszustellung größer oder gleich Fräserradius
IF RZ<_WZR
RZ := _WZR
ELSE
END
END
WHILE TM > Tiefe
IF TM=1
TM := 0
ELSE
END
TM := TM+Zustellung
IF TM < Tiefe
TM := Tiefe
ELSE
END
IF Taschenlaenge>Taschenbreite
GX := Taschenlaenge-TU+UW
ELSE
GX := Taschenbreite-TU+UW
END
GY := UW
IF Durchlauf=1
KreisEndpunktY := _WZD+ÜberfahrKreisbogen
IF KreisEndpunktY>=GY
KreisEndpunktY := _WZD+((GY-_WZD)/2)
END
IF KreisEndpunktY<_WZD
;Dann erfolgt keine Bahnbewegung mehr
KreisEndpunktY := 0
END
IF _SDAKT>0
SP (X_Mitte,Y_Mitte-GY/2,TM,2,0,_ANF,0,0,0)
ELSE
SP (X_Mitte,Y_Mitte-GY/2,TM,1,0,_ANF,0,0,0)
END
ELSE
G01 (X_Mitte,Y_Mitte-GY/2,TM,0)
END
FOR I := 1 TO Schleifenzahl STEP 1
IF _SDAkt>0
G01 (_X-GX/2,_Y,_Z,RM)
G01 (_X,_Y+GY,_Z,RM)
G01 (_X+GX,_Y,_Z,RM)
G01 (_X,_Y-GY,_Z,RM)
G01 (_X-GX/2,_Y,_Z,0)
ELSE
G01 (_X+GX/2,_Y,_Z,RM)
G01 (_X,_Y+GY,_Z,RM)
G01 (_X-GX,_Y,_Z,RM)
G01 (_X,_Y-GY,_Z,RM)
G01 (_X+GX/2,_Y,_Z,0)
END
IF I<Schleifenzahl
GX := Gx+UW
GY := GY+UW
G01 (_X,_Y-(GY/2)/(I+1),_Z,0)
RM := RM+RZ
;Wenn der Radius größer als Werkzeugradius, dann Radius=0
IF Radius< _WZR
Radius := 0
ELSE
END
IF RM > Radius
RM := Radius
ELSE
END
ELSE
RM := 0
END
END
Durchlauf := Durchlauf+1
END
;Um diesen Weg muß überfahren werden, damit nichts stehenbleibt
UeberfahrWegX := _WZR+UeberfahrWegX
IF _SDAKT>0
;Ueberfahren wenn geradenstück lang genug
IF ((GX-2*Radius)/2) > UeberfahrwegX
;Ueberfahren Linear
G01 (_X-UeberfahrwegX,_Y,_Z,0)
;Im Kreisbogen abfahren
IF (KreisEndpunktY>_WZD)
TANG (_X,_Y+KreisEndpunktY,_z,_wzr)
END
ELSE
;Ueberfahren über Radius hinaus
G01 (_X-(GX/2),_Y,_Z,Radius)
G01 (_X,_Y+GY,_Z,Radius)
G01 (X_Mitte,_Y,_Z,Radius)
;Im Kreisbogen abfahren
IF (KreisEndpunktY>_WZD)
TANG (_X,_Y-KreisEndpunktY,_z,_wzr)
END
END
ELSE
;Ueberfahren wenn geradenstück lang genug
IF ((GX-2*Radius)/2) > UeberfahrwegX
;Ueberfahren Linear
G01 (_X+UeberfahrwegX,_Y,_Z,0)
;Im Kreisbogen abfahren
IF (KreisEndpunktY>_WZD)
TANG (_X,_Y+KreisEndpunktY,_z,_WZR)
END
ELSE
;Ueberfahren über Radius hinaus
G01 (_X+(GX/2),_Y,_Z,Radius)
G01 (_X,_Y+GY,_Z,Radius)
G01 (X_Mitte,_Y,_Z,Radius)
;Im Kreisbogen abfahren
IF (KreisEndpunktY>_WZD)
TANG (_X,_Y-KreisEndpunktY,_z,_WZR)
END
END
END
;G01 (_X,_Y+GY/2,0,0)
EP (0,_ANF,0)
END
END
END
DrehenEB (X_Mitte,Y_Mitte,Winkel)
END
END

