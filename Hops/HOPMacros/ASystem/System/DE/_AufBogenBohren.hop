;MAKROTYP=1
;DZ=0
;DY=0
;DX=0
;KOMMENTAR=
;NCNAME=NCName
;MASCHINE=Simu
;WZGV=demo
;BILD=BOGENBOHRENWMF.bmp
VARS
   MX := _RX/2;*VAR*MITTELPUNKT DES BOGENS X
   MY := _RY/2;*VAR*MITTELPUNKT DES BOGENS Y
   R := _RX/2;*VAR*RADIUS DES BOGENS
   DW := 180;*VAR*DREHWINKEL
   AW := 0;*VAR*ANFANGSWINKEL
   A := 6;*VAR*ANZAHL BOHRUNGEN
   T := -10;*VAR*BOHRTIEFE
   DELTA := 0;DELTAWINKEL
   X := 0;BOHRPOSITION
   Y := 0;BOHRPOSITION
   XB := 0;ERSTEPOSITION
   YB := 0;ERSTEPOSITION
   I := 0;
   AKTW := 0;AKTUELLEWINKEL
START
;$B$BOHRENAUFKREISBOGEN
;DIREKT CNC SYSTEME GMBH
;BOHRUNGEN WERDEN AUF EINEM KREISBOGEN
;IM GEGENUHRZEIGERSINN ANGEORDNET
;29.09.98 SF
;.
;ROHTEIL(1000,2000,19,0,0)
;WZB(3,_VE,_V,_VA,_SD,_ANF)
WHILE DW>360
DW:=DW-360
END
IF T>0
T := -T
END
IF A>1
;ZKBCCW(MX,MY,MX+R*COS(AW),MY+R*SIN(AW),MX+R*COS(AW+DW),MY+R*SIN(AW+DW),0)
DELTA:=DW/(A-1)
AKTW:=AW
XB:=MX+R*COS(AKTW)
YB:=MY+R*SIN(AKTW)
FOR I := 1 TO A STEP 1
X:=MX+R*COS(AKTW)
Y:=MY+R*SIN(AKTW)
AKTW:=AKTW+DELTA
IF I=A
IF (X<>XB)|(Y<>YB)
BOHRUNG(X,Y,_WZD,T,0,0,0)
END
ELSE
BOHRUNG(X,Y,_WZD,T,0,0,0)
END
END
END

