;MAKROTYP=1
;DZ=0.00
;DY=0.00
;DX=0.00
;KOMMENTAR=
;NCNAME=_spiegeln_on_off
;MASCHINE=SIMU
;WZGV=DEMO
;BILD=
VARS
   spiegeln := 0;*VAR*Schaletr für Spiegeln
   Achse := 0;*VAR*X-Achse=0   Y-Achse=1
   Spiegel_variable := 0;*VAR*
START
;direkt cnc systeme NCHOPS Version 3.4.5
;Spiegeln über X und Y-Achse
;--------------------------------------------------------------
;---- Auswerten der spiegel-Variable...
IF spiegeln=0
_spiegeln := spiegeln
END
IF spiegeln=1
_spiegeln := spiegeln
END
IF spiegeln=2
_spiegeln := Spiegel_variable
END
;--------------------------------------------------------------
;--- Auswerten der Spiegelachse...
IF Achse=0
SPROHY()
ELSE
SPROHX()
END

