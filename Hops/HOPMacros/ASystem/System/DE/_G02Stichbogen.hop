;MAKROTYP=1
;DZ=0
;DY=0
;DX=0
;KOMMENTAR=
;NCNAME=NCNAME
;MASCHINE=Simu
;WZGV=demo
;BILD=_G02Stichbogen.wmf
VARS
   Breite := ;*VAR*Breite des Stichbogen
   Hoehe := ;*VAR*Höhe des Stichbogen
   Z := _Z;*VAR*Zustelltiefe
   R := 0;*VAR*Verrundungsradius
   Radius := 0;
   H := 0;Hilfsvariable
START
;Rohteil (1000,200,40,0,0)
IF Hoehe<0
H := -Hoehe
ELSE
H := Hoehe
END
Radius := (sqr(H)+sqr(Breite)/4)/(2*H)
IF Hoehe>0
G02R (_X+Breite,_Y,Z,Radius,R)
ELSE
G03R (_X+Breite,_Y,Z,Radius,R)
END

