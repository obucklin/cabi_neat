;MAKROTYP=1
;DZ=0
;DY=0
;DX=0
;KOMMENTAR=
;NCNAME=NCNAME
;MASCHINE=Simu
;WZGV=demo
;BILD=GeradeWX.wmf
VARS
   X := ;*VAR*Strecke in X-Richtung
   Winkel := ;*VAR*Winkel der Strecke
   Z := _Z;*VAR*Zustelltiefe
   R := 0;*VAR*verrundungsradius
START
;DIREKT CNC SYSTEME NCHOPS VERSION 3.0
;Gerade mit X-Wert und Winkel
;WZF (1,_VE,_V,_VA,_SD,_ANF)
WHILE Winkel>360
Winkel := Winkel-360
END
WHILE Winkel<0
Winkel := Winkel+360
END
IF ((Winkel<90.0001)&(Winkel>89.9999))|((Winkel<270.0001)&(Winkel>269.9999))
;Keine Lösung
Hinweismeldung (Keine_Lösung)
ELSE
IF (winkel>90)&(winkel<270)
G01 (_X-X,_Y-(X*Tan(Winkel)),Z,R)
ELSE
G01 (_X+X,_Y+(X*Tan(Winkel)),Z,R)
END
END

