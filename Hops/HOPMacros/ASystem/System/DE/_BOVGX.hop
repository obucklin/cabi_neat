;MAKROTYP=1
;DZ=0
;DY=0
;DX=0
;KOMMENTAR=
;NCNAME=Bohgx
;MASCHINE=Simu
;WZGV=demo
;BILD=BOVGXWMF.bmp
VARS
   BIX := _RX/5;*VAR*Bohrung1 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIX := _RX/5*2;*VAR*Bohrung2 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIIX := 0;*VAR*Bohrung3 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIIIX := 0;*VAR*Bohrung4 (Wert=0-> Bohrung wird nicht abgesetzt)
   Z := 10;*VAR*Z-Wert von der Unterkante
   Spiegeln := 1;*VAR*1=>gespiegelt
   T := -30;*VAR*Bohrtiefe
   D := 8;*VAR*Bohrdurchmesser
   Oben := 0;*VAR*Ebene3=1 , Ebene1=0
   YP := 0;Y Position
   DW := 90;Drehwinkel
   TL := 0;Tieflochflag
START
;direkt cnc systeme NCHOPS Version3.0
;Stirnseitenbohrungen in X V 3.0/SF/09.98
;Rohteil (400,400,20,0,0)
IF T>0
T := -T
END
IF Oben=0
YP := 0
DW := 90
ELSE
YP := _RY
DW := 270
END
IF (BIX<>0)
HorzB (BIX,YP,Z,D,T,TL,0,DW)
END
IF (BIIX<>0)
HorzB (BIIX,YP,Z,D,T,TL,0,DW)
END
IF (BIIIX<>0)
HorzB (BIIIX,YP,Z,D,T,TL,0,DW)
END
IF (BIIIIX<>0)
HorzB (BIIIIX,YP,Z,D,T,TL,0,DW)
END
;Gespiegelte Bohrungen
IF Spiegeln <> 0
IF (BIX<>_RX/2)&(BIX<>0)
HorzB (_RX-BIX,YP,Z,D,T,TL,0,DW)
END
IF (BIIX<>_RX/2)&(BIIX<>0)
HorzB (_RX-BIIX,YP,Z,D,T,TL,0,DW)
END
IF (BIIIX<>_RX/2)&(BIIIX<>0)
HorzB (_RX-BIIIX,YP,Z,D,T,TL,0,DW)
END
IF (BIIIIX<>_RX/2)&(BIIIIX<>0)
HorzB (_RX-BIIIIX,YP,Z,D,T,TL,0,DW)
END
END

