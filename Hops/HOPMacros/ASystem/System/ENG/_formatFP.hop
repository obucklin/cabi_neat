;MAKROTYP=1
;DZ=0
;DY=0
;DX=0
;KOMMENTAR=
;NCNAME=NCName
;MASCHINE=Simu
;WZGV=demo
;BILD=FORMATWMF.bmp
VARS
   Eckenverrundung := 0;*VAR*Radius der Eckenverrundung
   Richtung := 0;*VAR*0=Uhrzeiger,1=gegenUhrzeiger
START
;DIREKT CNC SYSTEME NCHOPS VERSION 3.0
;Rohteilformatierung 1.0/JOFU/07.98
;WZF (1,_VE,_V,_VA,_SD,_ANF)
IF Richtung=0
SP(0,_RY/2,-_RZ-2,1,2,_ANF,0,0,0)
G01(0,_RY,_Z,ECKENVERRUNDUNG)
G01(_RX,_Y,_Z,ECKENVERRUNDUNG)
G01(_X,0,_Z,ECKENVERRUNDUNG)
G01(0,0,_Z,ECKENVERRUNDUNG)
G01(_X,_RY/2+_WZR,_Z,0)
ELSE
SP(0,_RY/2,-_RZ-2,2,2,_ANF,0,0,0)
G01(0,0,-_RZ-2,ECKENVERRUNDUNG)
G01(_RX,_Y,_Z,ECKENVERRUNDUNG)
G01(_X,_RY,_Z,ECKENVERRUNDUNG)
G01(0,_Y,_Z,ECKENVERRUNDUNG)
G01(_X,_RY/2-_WZR,_Z,0)
END
EP(2,_ANF,0)

