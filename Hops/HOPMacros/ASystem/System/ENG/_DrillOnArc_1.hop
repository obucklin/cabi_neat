;MAKROTYP=1
;DZ=0
;DY=0
;DX=0
;KOMMENTAR=
;NCNAME=NCName
;MASCHINE=Simu
;WZGV=demo
;BILD=BOGENBOHRENWMF.bmp
VARS
   MX := _RX/2;*VAR*MITTELPUNKT DES BOGENS X
   MY := _RY/2;*VAR*MITTELPUNKT DES BOGENS Y
   R := 100;*VAR*RADIUS DES BOGENS
   DW := 360;*VAR*DREHWINKEL
   AW := 0;*VAR*ANFANGSWINKEL
   A := 6;*VAR*ANZAHL BOHRUNGEN
   T := -10;*VAR*BOHRTIEFE
   DELTA := 0;DELTAWINKEL
   X := 0;BOHRPOSITION
   Y := 0;BOHRPOSITION
   XB := 0;ERSTEPOSITION
   YB := 0;ERSTEPOSITION
   I := 0;
   AKTW := 0;AKTUELLEWINKEL
   TLF := 0;*VAR*TIEFLOCHFLAG
   D := 8;*VAR*Bohrungsdurchmesser
START
;DIREKT CNC SYSTEME GMBH
;BOHRUNGEN WERDEN AUF EINEM KREISBOGEN
;IM GEGENUHRZEIGERSINN ANGEORDNET
;.
WHILE DW>360
DW:=DW-360
END
IF T>0
T := -T
END
IF A>1
IF DW=360
DELTA := DW/A
ELSE
DELTA := DW/(A-1)
END
AKTW:=AW
XB:=MX+R*COS(AKTW)
YB:=MY+R*SIN(AKTW)
FOR I  :=  1  TO  A  STEP  1
X:=MX+R*COS(AKTW)
Y:=MY+R*SIN(AKTW)
AKTW:=AKTW+DELTA
IF I=A
IF (X<>XB)|(Y<>YB)
DRILLING(X,Y,D,T,TLF,0,0)
END
ELSE
DRILLING(X,Y,D,T,TLF,0,0)
END
END
END

