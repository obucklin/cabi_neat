;MAKROTYP=1
;DZ=0
;DY=0
;DX=0
;KOMMENTAR=
;NCNAME=Bohgx
;MASCHINE=Simu
;WZGV=demo
;BILD=BovgyWMF.bmp
VARS
   BIY := 64;*VAR*Bohrung1 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIY := 64+37;*VAR*Bohrung2 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIIY := 0;*VAR*Bohrung3 (Wert=0-> Bohrung wird nicht abgesetzt)
   BIIIIY := 0;*VAR*Bohrung4 (Wert=0-> Bohrung wird nicht abgesetzt)
   Z := _RZ/2;*VAR*Z-Wert von der Unterkante
   Spiegeln := 0;*VAR*1=>gespiegelt
   T := -30;*VAR*Bohrtiefe
   D := 8;*VAR*Bohrdurchmesser
   Ebene := 0;*VAR*Ebene 2 oder Ebene 4
   TL := 0;Tieflochflag
   XP := 0;Y Position
   DW := 90;Drehwinkel
START
;direkt cnc systeme NCHOPS Version 4
;Stirnzeitenbohrung in Y
IF T>0
T := -T
END
;*****************  Auswerten Ebenen zwecks Dialog 0/1
IF ebene=0
ebene := 2
ELSE
ebene := 4
END
;*****************************************
IF (Ebene<>2)&(Ebene<>4)
GIVEOUTERROR(____FALSCHE_EBENE_GEWAEHLT___)
END
IF Ebene=2
XP := 0
DW := 0
END
IF Ebene=4
XP := _RX
DW := 180
END
IF (BIY<>0)
HORD(XP,BIY,Z,D,T,TL,0,DW)
END
IF (BIIY<>0)
HORD(XP,BIIY,Z,D,T,TL,0,DW)
END
IF (BIIIY<>0)
HORD(XP,BIIIY,Z,D,T,TL,0,DW)
END
IF (BIIIIY<>0)
HORD(XP,BIIIIY,Z,D,T,TL,0,DW)
END
;Gespiegelte Bohrungen
IF Spiegeln <> 0
IF (BIY<>_RY/2)&(BIY<>0)
HORD(XP,_RY-BIY,Z,D,T,TL,0,DW)
END
IF (BIIY<>_RY/2)&(BIIY<>0)
HORD(XP,_RY-BIIY,Z,D,T,TL,0,DW)
END
IF (BIIIY<>_RY/2)&(BIIIY<>0)
HORD(XP,_RY-BIIIY,Z,D,T,TL,0,DW)
END
IF (BIIIIY<>_RY/2)&(BIIIIY<>0)
HORD(XP,_RY-BIIIIY,Z,D,T,TL,0,DW)
END
END

