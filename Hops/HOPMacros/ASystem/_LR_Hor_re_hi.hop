;NCNAME=_LR_Hor_re_hi
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0.000
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
VARS
   i := 0;
   du := 8;*VAR*Durchmesser
   abh := 100;*VAR*Abstand von hinten
   abv := 30;*VAR*Abstand von vorne
   Tiefe := 22;*VAR*Tiefe der Bohrungen
   Raster := 64;*VAR*Raster
   anz := 2;Anzahl
   Drehen := 0;0=Nein 1=Ja um 180 Grad
START
Rohteil (1000,650,19,0,3)
WZB (501,_VE,_V,_VA,_SD,_ANF)
FOR i := abv TO _ry-abh STEP Raster
HorzB (_rx,_ry-i,_rz/2,du,-Tiefe,0,0,180)
END
