;MAKROTYP=1
;BILD=_HorTasche.WMF
;INFO=_HorTasche
;WZGV=demo
;MASCHINE=Simu
;NCNAME=_HorTasche_V4
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
VARS
   EBENE := 1;*VAR*BearbeitungsEbene
   XPOS := ;*VAR*(Mittelpunkt)
   YPOS := ;*VAR*(Mittelpunkt)
   ZPOS := ;*VAR*(TaschenMitte) von Werkstückunterkante
   Breite := 100;*VAR*Taschenlänge
   HOEHE := 20;*VAR*TaschenHoehe
   TIEFE := ;*VAR*Tiefe der Tasche
   Zutiefe := 0;*VAR*Zustellung pro Fräsung
   ABF := _ANF;Abfahrfaktor
   Radius := 0;*VAR*Verrundungsradius an den Ecken der Tasche
   umkehren := 0;*VAR*Bearbeitung umkehren
   Interpol := 0;*VAR*Interpolation auf Anfahrbewegung
   Pendeln := 0;*VAR*Pendeln = in Linien abzeilen
   Farbe := 0;Mit Farbe Füllen JA/NEIN 0/1
START
;direkt cnc systeme NCHOPS Version 4.x
Rohteil (300,300,100,0,0)
;WZF (21,_VE,_V,_VA,_SD,_ANF)
;****************************
IF (Tiefe=0) & (ZuTiefe=0)
Fehlermeldung (Bitte_Tiefe_eingeben)
END
;***** Überprüfung Tiefe negativ *****
IF Tiefe<0
tiefe := tiefe*(-1)
END
;***** Überprüfung ZuTiefe negativ *****
IF zuTiefe<0
zutiefe := zutiefe*(-1)
END
;***** Überprüfung ZuTiefe NULL *****
IF ZuTiefe=0
ZuTiefe := tiefe
END
;***** Überprüfung ZuTiefe größer Tiefe *****
IF ZuTiefe>Tiefe
ZuTiefe := tiefe
END
;***** Überprüfung des WZD bei umfahren *****
IF (pendeln=0) & (_WZD>hoehe)
Fehlermeldung ('Fräser mit D'+FloatToStr(_WZD,15,3)+'  ist grösser als die Taschenhöhe !')
END
;****************************
IF Radius>Hoehe/2
Radius := Hoehe/2
Hinweismeldung (Radius_wurde_auf_die_Hälfte_der_Höhe_geändert)
END
;****************************
;**************************************************************************************
;Horizontales Taschenfräsen auf EB1-EB4
;**************************************************************************************
IF (Ebene=1)
;Von VORNE
ZRechteck (XPOS-Breite/2,YPOS,Breite,Tiefe,Farbe,1)
EbeneF (XPOS,YPOS,0,90,0)
END
;**************************************************************************************
IF (Ebene=2)
;Von LINKS
ZRechteck (XPOS,YPOS-Breite/2,Tiefe,Breite,Farbe,1)
EbeneF (XPOS,YPOS,0,90,270)
END
;**************************************************************************************
IF (Ebene=3)
;Von Hinten
ZRechteck (XPOS-Breite/2,YPOS,Breite,-Tiefe,Farbe,1)
EbeneF (XPOS,YPOS,0,90,180)
END
;**************************************************************************************
IF (Ebene=4)
;Von Rechts
ZRechteck (XPOS,YPOS-Breite/2,-Tiefe,Breite,Farbe,1)
EbeneF (XPOS,YPOS,0,90,90)
END
;**************************************************************************************
CALL _HorTascheFraesen_V4 ( VAL X:=0,Y:=ZPOS,Z:=0,Hoehe:=Hoehe,Laenge:=Breite,Tiefe:=Tiefe,Radius:=Radius,Zutiefe:=ZuTiefe,ABF:=ABF,umkehren:=umkehren,Interpol:=Interpol,Pendeln:=pendeln)
Ebene0()
