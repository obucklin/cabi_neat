;MAKROTYP=1
;BILD=_AufBogenBohrenHoriz_1.bmp
;INFO=_AufBogenBohren_1
;WZGV=NC1000
;MASCHINE=NC1000
;NCNAME=_AufBogenBohrenHoriz_1
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
VARS
   MX := _RX/2;*VAR*MITTELPUNKT DES BOGENS X
   MY := _RY/2;*VAR*MITTELPUNKT DES BOGENS Y
   Z := _RZ/2;*VAR*BOHRPOSITION Z
   R := _RY/2-50;*VAR*RADIUS DES BOGENS
   DW := 360;*VAR*DREHWINKEL
   AW := 0;*VAR*ANFANGSWINKEL
   A := 12;*VAR*ANZAHL BOHRUNGEN
   T := -10;*VAR*BOHRTIEFE
   DELTA := 0;DELTAWINKEL
   X := 0;BOHRPOSITION
   Y := 0;BOHRPOSITION
   XB := 0;ERSTEPOSITION
   YB := 0;ERSTEPOSITION
   I := 0;
   AKTW := 0;AKTUELLEWINKEL
   TLF := 0;*VAR*TIEFLOCHFLAG
   D := 8;*VAR*Bohrungsdurchmesser
   DR_WINKEL := 0;*VAR*0= Von Innen 180 = Von Aussen
START
;DIREKT CNC SYSTEME GMBH
;BOHRUNGEN WERDEN AUF EINEM KREISBOGEN
;GEGEN DEN UHRZEIGERSINN ANGEORDNET
;.
IF DR_WINKEL = 0
DR_WINKEL := 0
ELSE
DR_WINKEL := 180
END
;-
WHILE DW>360
DW:=DW-360
END
IF T>0
T := -T
END
IF A>1
IF DW=360
DELTA := DW/A
ELSE
DELTA := DW/(A-1)
END
AKTW:=AW
XB:=MX+R*COS(AKTW)
YB:=MY+R*SIN(AKTW)
FOR I := 1 TO A STEP 1
X:=MX+R*COS(AKTW)
Y:=MY+R*SIN(AKTW)
AKTW:=AKTW+DELTA
IF I=A
IF (X<>XB)|(Y<>YB)
HorzB (X,Y,Z,D,T,0,0,AKTW-DELTA+DR_WINKEL)
END
ELSE
HorzB (X,Y,Z,D,T,0,0,AKTW-DELTA+DR_WINKEL)
END
END
END
