;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   P1 := 0;*VAR*X Position
   P2 := 0;*VAR*Y Position
   P3 := 0;*VAR*
   P4 := 0;*VAR*Durchmesser
   P5 := '';*VAR*Layername
START
;Mustermakro V1_2022
;
WZB (501,_VE,_V,_VA,_SD,_ANF,'1')
;Topfbandbohrer 15mm / 35mm
IF (P4=15) | (P4=35)
Bohrung (P1,P2,P4,-13,30,0,0,0,0,0,0,0)
ELSE
;Saklochboher
Bohrung (P1,P2,P4,-13,10,0,0,0,0,0,0,0)
END
;
