;MAKROTYP=1
;INSTVERSION=
;EXEVERSION=7.10.0.108[Hops.exe]
;BILD=P_S_HI_VO_HORI_V7.WMF
;INFO=
;WZGV=7535D_320
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=P_S_HI_VO_HORI_V7
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0
;DIALOGDLL=HHDialogs_P_System_BASE_V7.dll
;DIALOGPROC=ShowPSystemKanteHIVO_BASE_V7
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   DX := 600;Dimension X
   DY := 400;Dimension Y
   DZ := 19;Dimension Z
   PDV_X_1 := 60;*VAR*VL
   PDV_X_2 := 0;*VAR*VM
   PDV_X_3 := 60;*VAR*VR
   PDV_X_4 := 60;*VAR*HL
   PDV_X_5 := 0;*VAR*HM
   PDV_X_6 := 60;*VAR*HL
   APV_1 := 1;*VAR*VL
   APV_2 := 1;*VAR*VM
   APV_3 := 1;*VAR*VR
   APV_4 := 1;*VAR*HR
   APV_5 := 1;*VAR*HM
   APV_6 := 1;*VAR*HL
   ZH_H := 9.5;*VAR*Z-Wert hinten
   ZH_V := 9.5;*VAR*Z-Wert vorne
   BOHR_Vo := 0;*VAR*vorne bohren
   BOHR_Hi := 0;*VAR*Hinten bohren
   ToolID := -99999;
   Ausw_ClamexBisco := 1;*VAR*Welcher Typ von Clamex wurde angewählt
   CLAMEX_TYP := 1;
   Z_BEWEG := 1.4;Default 1.4
   ABST_KANTE := 1.5;Sicherheitsabstand zur Kante
   TEXT := 'nix';
   RAFB := 5.5;Fixer Randabstand Bohrung (7.5/5.3)
   EITI := 10.0;FIX_Eintauchtiefe des Werkzeuges
   _STRING_STL := '';
START
Fertigteil (DX,DY,DZ,0,0,0,0,0,'',0,0,0)
;Clamex_V7_SK 26.06.2017
;Draw Darstellung_SK 22.08.2023
CALL _UserInterface3DG (REF RESULT:=ToolID VAL INPUTTEXT:='GetStandardRouterID')
IF (_MaschinenTyp=3) | (_MaschinenTyp=4)
_EXECUTELEADINOUT := 1
ELSE
_EXECUTELEADINOUT := 0
END
;0=Tenso; 1=Divario; 2=Medius 14/10; 3=P10; 4=P14
;P10
IF Ausw_ClamexBisco=0
CLAMEX_TYP := 3
TEXT := 'P-10'
RAFB := 5.5
Z_BEWEG := 1
EITI := 10
_STRING_STL := 'P10.stl'
END
;P14
IF Ausw_ClamexBisco=1
CLAMEX_TYP := 4
TEXT := 'P-14'
RAFB := 7.5
Z_BEWEG := 1
EITI := 14
_STRING_STL := 'P14.stl'
END
;Tenso P14
IF Ausw_ClamexBisco=2
CLAMEX_TYP := 0
TEXT := 'Ten-14'
Z_BEWEG := 1
EITI := 14
_STRING_STL := 'TN.stl'
END
;Bisco P10
IF Ausw_ClamexBisco=3
CLAMEX_TYP := 3
Z_BEWEG := 0
TEXT := 'Bis-10'
EITI := 10
_STRING_STL := 'BI10.stl'
END
;Bisco P14
IF Ausw_ClamexBisco=4
CLAMEX_TYP := 4
Z_BEWEG := 0
TEXT := 'Bis-14'
EITI := 14
_STRING_STL := 'BI14.stl'
END
;Dicario P18
/IF Ausw_ClamexBisco=5
/CLAMEX_TYP := 1
/TEXT := 'Div-18'
/EITI := 18
/END
/_STRING_STL := 'DV.stl'
;VORNE
;VORNE links
IF APV_1=1
CALL P_S_BASE_HORI ( VAL POS_X:=PDV_X_1,POS_Y:=0,POS_Z:=ZH_V,DRILL_DISTANCE:=RAFB,VIEW:=1,DRILL:=BOHR_VO,Z_BEWEG:=Z_BEWEG,NUT_TIEFE:=-EITI,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0,WKZ_NUT:=_Clamex_Nuter_ID,WKZ_BOHR:=_Clamex_Bohrer_ID)
CALL HH_Clamex_DRAW ( VAL X_1:=PDV_X_1,Y_1:=0,DW:=90,EITI:=EITI)
ZText (TEXT,PDV_X_1,-50,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
;VORNE Mitte
IF APV_2=1
CALL P_S_BASE_HORI ( VAL POS_X:=_RX/2+PDV_X_2,POS_Y:=0,POS_Z:=ZH_V,DRILL_DISTANCE:=RAFB,VIEW:=1,DRILL:=BOHR_VO,Z_BEWEG:=Z_BEWEG,NUT_TIEFE:=-EITI,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0,WKZ_NUT:=_Clamex_Nuter_ID,WKZ_BOHR:=_Clamex_Bohrer_ID)
CALL HH_Clamex_DRAW ( VAL X_1:=_RX/2+PDV_X_2,Y_1:=0,DW:=90,EITI:=EITI)
ZText (TEXT,_RX/2+PDV_X_2,-50,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
;VORNE rechts
IF APV_3=1
CALL P_S_BASE_HORI ( VAL POS_X:=_Rx-PDV_X_3,POS_Y:=0,POS_Z:=ZH_V,DRILL_DISTANCE:=RAFB,VIEW:=1,DRILL:=BOHR_VO,Z_BEWEG:=Z_BEWEG,NUT_TIEFE:=-EITI,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0,WKZ_NUT:=_Clamex_Nuter_ID,WKZ_BOHR:=_Clamex_Bohrer_ID)
CALL HH_Clamex_DRAW ( VAL X_1:=_RX-PDV_X_3,Y_1:=0,DW:=90,EITI:=EITI)
ZText (TEXT,_Rx-PDV_X_3,-50,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
;-----------HINTEN------------
;HINTEN rechts
IF APV_4=1
CALL P_S_BASE_HORI ( VAL POS_X:=_Rx-PDV_X_4,POS_Y:=_RY,POS_Z:=ZH_H,DRILL_DISTANCE:=RAFB,VIEW:=3,DRILL:=BOHR_Hi,Z_BEWEG:=Z_BEWEG,NUT_TIEFE:=-EITI,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0,WKZ_NUT:=_Clamex_Nuter_ID,WKZ_BOHR:=_Clamex_Bohrer_ID)
CALL HH_Clamex_DRAW ( VAL X_1:=_RX-PDV_X_4,Y_1:=_RY,DW:=270,EITI:=EITI)
ZText (TEXT,_Rx-PDV_X_4,_RY+50,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
;HINTEN Mitte
IF APV_5=1
CALL P_S_BASE_HORI ( VAL POS_X:=_Rx/2+PDV_X_5,POS_Y:=_RY,POS_Z:=ZH_H,DRILL_DISTANCE:=RAFB,VIEW:=3,DRILL:=BOHR_Hi,Z_BEWEG:=Z_BEWEG,NUT_TIEFE:=-EITI,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0,WKZ_NUT:=_Clamex_Nuter_ID,WKZ_BOHR:=_Clamex_Bohrer_ID)
CALL HH_Clamex_DRAW ( VAL X_1:=_RX/2+PDV_X_5,Y_1:=_RY,DW:=270,EITI:=EITI)
ZText (TEXT,_Rx/2+PDV_X_5,_RY+50,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
;HINTEN links
IF APV_6=1
CALL P_S_BASE_HORI ( VAL POS_X:=PDV_X_6,POS_Y:=_RY,POS_Z:=ZH_H,DRILL_DISTANCE:=RAFB,VIEW:=3,DRILL:=BOHR_Hi,Z_BEWEG:=Z_BEWEG,NUT_TIEFE:=-EITI,TEMP_VAR1:=0,TEMP_VAR2:=0,TEMP_VAR3:=0,WKZ_NUT:=_Clamex_Nuter_ID,WKZ_BOHR:=_Clamex_Bohrer_ID)
CALL HH_Clamex_DRAW ( VAL X_1:=PDV_X_6,Y_1:=_RY,DW:=270,EITI:=EITI)
ZText (TEXT,PDV_X_6,_RY+50,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
