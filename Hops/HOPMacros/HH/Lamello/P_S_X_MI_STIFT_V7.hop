;MAKROTYP=1
;INSTVERSION=
;EXEVERSION=7.7.12.80[Hops.exe]
;BILD=P_S_X_MI_STIFT_V7.BMP
;INFO=
;WZGV=7405_1156
;WZGVCONFIG=
;MASCHINE=BetterSIM
;NCNAME=P_S_Y_MI_STIFT_V7
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=HHDialogs_P_System_BASE_V7.Dll
;DIALOGPROC=ShowP_S_X_MI_STIFT_V7
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   LPX := 1500;
   LPY := 600;
   LPZ := 19;
   APV_7 := 1;*VAR*LM
   PDV_X_7 := 60;*VAR*HL
   PDV_Y_7 := 0;*VAR*HL
   APV_8 := 1;*VAR*MM
   PDV_X_8 := 0;*VAR*MM
   PDV_Y_8 := 0;*VAR*MM
   APV_9 := 1;*VAR*RM
   PDV_X_9 := 60;*VAR*RM
   PDV_Y_9 := 0;*VAR*RM
   Ausw_ClamexBisco := 1;*VAR*0=Tenso; 1=Divario; 2=Medius 14/10; 3=P10; 4=P14
   StartCL := 40.1;Eintrittposition (Kreissegment 80.2/2 (mit 5mm überhalb Platte))
   ToolID := -99999;Themp
   CLAMEX_TYP := 1;
   Z_BEWEG := 1.4;Default 1.4
   TEXT := 'nix';
   WZ4_VE := -99;_Clamex_Stiftfraeser_ID
   WZ4_V := -99;_Clamex_Stiftfraeser_ID
   WZ4_VA := -99;_Clamex_Stiftfraeser_ID
   WZ4_SD := -99;_Clamex_Stiftfraeser_ID
START
Fertigteil (LPX,LPY,LPZ,0,0,0,0,0,'',0,0,0)
CALL _UserInterface3DG (REF RESULT:=ToolID VAL INPUTTEXT:='GetStandardRouterID')
;DEFINITION _Clamex_Stiftfraeser_ID
WZF (_Clamex_Stiftfraeser_ID,_VE,_V,_VA,_SD,_ANF,'1')
WZ4_VE := _VE
WZ4_VA := _VA
WZ4_V := _V
WZ4_SD := _SD
/IF (_MaschinenTyp = 1) | (_MaschinenTyp = 4)
;0=Tenso; 1=Divario; 2=Medius 14/10; 3=P10; 4=P14
;P10
IF Ausw_ClamexBisco=0
CLAMEX_TYP := 3
TEXT := 'P-10'
/StartCL := 71.58/2
END
;P14
IF Ausw_ClamexBisco=1
CLAMEX_TYP := 4
TEXT := 'P-14'
/StartCL := 78.65/2
END
;Tenso P14
IF Ausw_ClamexBisco=2
CLAMEX_TYP := 0
TEXT := 'Ten-14'
/StartCL := 78.65/2
END
;Bisco P10
IF Ausw_ClamexBisco=3
CLAMEX_TYP := 3
Z_BEWEG := 0
TEXT := 'Bis-10'
/StartCL := 71.58/2
END
;Bisco P14
IF Ausw_ClamexBisco=4
CLAMEX_TYP := 4
Z_BEWEG := 0
TEXT := 'Bis-14'
/StartCL := 78.65/2
END
;Divario P18
IF Ausw_ClamexBisco=5
CLAMEX_TYP := 1
Z_BEWEG := 1
TEXT := 'DIV-18'
/StartCL := 78.65/2
END
;Medius P14/10
IF Ausw_ClamexBisco=6
CLAMEX_TYP := 2
Z_BEWEG := 1
TEXT := 'MED-10'
/StartCL := 78.65/2
END
;7 links mitte
IF APV_7=1
CALL Clamex_V7 ( VAL WKZ_NUT_NR:=9999,WKZ_NUT_H:='1',WKZ_NUT_V1:=0,WKZ_NUT_V2:=0,WKZ_NUT_V3:=0,WKZ_NUT_D:=0,WKZ_BOHR_NR:=9999,WKZ_BOHR_H:='1',WKZ_BOHR_V1:=0,WKZ_BOHR_V2:=0,WKZ_BOHR_V3:=0,WKZ_BOHR_D:=0,WKZ_BOHR_S_NR:=9999,WKZ_BOHR_S_H:='1',WKZ_BOHR_S_V1:=0,WKZ_BOHR_S_V2:=0,WKZ_BOHR_S_V3:=0,WKZ_BOHR_S_D:=0,WKZ_FINGER_NR:=_Clamex_Stiftfraeser_ID,WKZ_FINGER_H:='1',WKZ_FINGER_V1:=WZ4_VE,WKZ_FINGER_V2:=WZ4_V,WKZ_FINGER_V3:=WZ4_VA,WKZ_FINGER_D:=WZ4_SD,WKZ_90_NR:=9999,WKZ_90_H:='1',WKZ_90_V1:=0,WKZ_90_V2:=0,WKZ_90_V3:=0,WKZ_90_D:=0,WINKEL:=10,VERBINDUNG:=0,SEITE:=1,BOHR:=0,DRILLINGD:=6,SEITETEIL:=0,VERBINDER:=1,ABSTAND:=PDV_X_7,ABSTAND2:=_RY/2+PDV_Y_7,ABSTAND3:=60,TSK:=0,FF:=1,TYP:=CLAMEX_TYP,SK:=0,SPSK:=0,EPSK:=0,ADDEITI:=0,WUE:=10,BOU:=Z_BEWEG,OTHERSIDE:=0,RES1:=0,RES2:=-111111,RES3:=0,RES4:=7,RES5:=-111111,RES6:=-111111,RES7:=-111111,RES8:=-111111,RES9:=-111111,RES10:=-111111,RES11:=-111111,RES12:=-111111,RES13:=-111111,RES14:=-111111,RES15:=-111111,RES16:='',RES17:='',RES18:='',RES19:='',RES20:='')
CALL _ZRechteck_2P_V5 ( VAL SX:=PDV_X_7 - StartCL,SY:=_RY/2+PDV_Y_7-3.5,EX:=PDV_X_7 + StartCL,EY:=_RY/2+PDV_Y_7 + 3.5,FUELLEN:=1,FARBE:=0,ESXY1:=0,ESXY2:=0)
ZText (TEXT,PDV_X_7,_RY/2+PDV_Y_7 +25,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
;8 mitte mitte
IF APV_8=1
CALL Clamex_V7 ( VAL WKZ_NUT_NR:=9999,WKZ_NUT_H:='1',WKZ_NUT_V1:=0,WKZ_NUT_V2:=0,WKZ_NUT_V3:=0,WKZ_NUT_D:=0,WKZ_BOHR_NR:=9999,WKZ_BOHR_H:='1',WKZ_BOHR_V1:=0,WKZ_BOHR_V2:=0,WKZ_BOHR_V3:=0,WKZ_BOHR_D:=0,WKZ_BOHR_S_NR:=9999,WKZ_BOHR_S_H:='1',WKZ_BOHR_S_V1:=0,WKZ_BOHR_S_V2:=0,WKZ_BOHR_S_V3:=0,WKZ_BOHR_S_D:=0,WKZ_FINGER_NR:=_Clamex_Stiftfraeser_ID,WKZ_FINGER_H:='1',WKZ_FINGER_V1:=WZ4_VE,WKZ_FINGER_V2:=WZ4_V,WKZ_FINGER_V3:=WZ4_VA,WKZ_FINGER_D:=WZ4_SD,WKZ_90_NR:=9999,WKZ_90_H:='1',WKZ_90_V1:=0,WKZ_90_V2:=0,WKZ_90_V3:=0,WKZ_90_D:=0,WINKEL:=10,VERBINDUNG:=0,SEITE:=1,BOHR:=0,DRILLINGD:=6,SEITETEIL:=0,VERBINDER:=1,ABSTAND:=_RX/2+PDV_X_8,ABSTAND2:=_RY/2+PDV_Y_8,ABSTAND3:=60,TSK:=0,FF:=1,TYP:=CLAMEX_TYP,SK:=0,SPSK:=0,EPSK:=0,ADDEITI:=0,WUE:=10,BOU:=Z_BEWEG,OTHERSIDE:=0,RES1:=0,RES2:=-111111,RES3:=0,RES4:=7,RES5:=-111111,RES6:=-111111,RES7:=-111111,RES8:=-111111,RES9:=-111111,RES10:=-111111,RES11:=-111111,RES12:=-111111,RES13:=-111111,RES14:=-111111,RES15:=-111111,RES16:='',RES17:='',RES18:='',RES19:='',RES20:='')
CALL _ZRechteck_2P_V5 ( VAL SX:=_RX/2+PDV_X_8 - StartCL,SY:=_RY/2+PDV_Y_8-3.5,EX:=_RX/2+PDV_X_8 + StartCL,EY:=_RY/2+PDV_Y_8 + 3.5,FUELLEN:=1,FARBE:=0,ESXY1:=0,ESXY2:=0)
ZText (TEXT,_Rx/2+PDV_X_8,_RY/2+PDV_Y_8+25,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
;9 rechts mitte
IF APV_9=1
CALL Clamex_V7 ( VAL WKZ_NUT_NR:=9999,WKZ_NUT_H:='1',WKZ_NUT_V1:=0,WKZ_NUT_V2:=0,WKZ_NUT_V3:=0,WKZ_NUT_D:=0,WKZ_BOHR_NR:=9999,WKZ_BOHR_H:='1',WKZ_BOHR_V1:=0,WKZ_BOHR_V2:=0,WKZ_BOHR_V3:=0,WKZ_BOHR_D:=0,WKZ_BOHR_S_NR:=9999,WKZ_BOHR_S_H:='1',WKZ_BOHR_S_V1:=0,WKZ_BOHR_S_V2:=0,WKZ_BOHR_S_V3:=0,WKZ_BOHR_S_D:=0,WKZ_FINGER_NR:=_Clamex_Stiftfraeser_ID,WKZ_FINGER_H:='1',WKZ_FINGER_V1:=WZ4_VE,WKZ_FINGER_V2:=WZ4_V,WKZ_FINGER_V3:=WZ4_VA,WKZ_FINGER_D:=WZ4_SD,WKZ_90_NR:=9999,WKZ_90_H:='1',WKZ_90_V1:=0,WKZ_90_V2:=0,WKZ_90_V3:=0,WKZ_90_D:=0,WINKEL:=10,VERBINDUNG:=0,SEITE:=1,BOHR:=0,DRILLINGD:=6,SEITETEIL:=0,VERBINDER:=1,ABSTAND:=_RX-PDV_X_9,ABSTAND2:=_RY/2+PDV_Y_9,ABSTAND3:=60,TSK:=0,FF:=1,TYP:=CLAMEX_TYP,SK:=0,SPSK:=0,EPSK:=0,ADDEITI:=0,WUE:=10,BOU:=Z_BEWEG,OTHERSIDE:=0,RES1:=0,RES2:=-111111,RES3:=0,RES4:=7,RES5:=-111111,RES6:=-111111,RES7:=-111111,RES8:=-111111,RES9:=-111111,RES10:=-111111,RES11:=-111111,RES12:=-111111,RES13:=-111111,RES14:=-111111,RES15:=-111111,RES16:='',RES17:='',RES18:='',RES19:='',RES20:='')
CALL _ZRechteck_2P_V5 ( VAL SX:=_RX-PDV_X_9 - StartCL,SY:=_RY/2+PDV_Y_9-3.5,EX:=_RX-PDV_X_9 + StartCL,EY:=_RY/2+PDV_Y_9 + 3.5,FUELLEN:=1,FARBE:=0,ESXY1:=0,ESXY2:=0)
ZText (TEXT,_Rx-PDV_X_9,_RY/2+PDV_Y_9+25,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
/ELSE
/Fehlermeldung ('only 5X Machine')
/END
