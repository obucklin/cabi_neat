;MAKROTYP=1
;INSTVERSION=
;EXEVERSION=7.5.3.10[Hops.exe]
;BILD=P_S_RE_LI_FLAT_V7.BMP
;INFO=
;WZGV=7225K_V7_DEMO
;WZGVCONFIG=
;MASCHINE=BetterSIM
;NCNAME=P_S_RE_LI_FLAT_V7
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=HHDialogs_P_System_BASE_V7.Dll
;DIALOGPROC=ShowPSystemFlaecheY_V7
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   LPX := 1500;
   LPY := 600;
   LPZ := 19;
   APV_1 := 1;*VAR*Auswahl Position Verbinder links/oben
   APV_2 := 1;*VAR*Auswahl Position Verbinder links/mitte
   APV_3 := 1;*VAR*Auswahl Position Verbinder links/unten
   APV_4 := 1;*VAR*Auswahl Position Verbinder rechts/oben
   APV_5 := 1;*VAR*Auswahl Position Verbinder rechts/mitte
   APV_6 := 1;*VAR*Auswahl Position Verbinder rechts/unten
   PDV_X_1 := 9.5;*VAR*Position des Verbinder in X (links oben)
   PDV_X_2 := 9.5;*VAR*Position des Verbinder in X (links mitte)
   PDV_X_3 := 9.5;*VAR*Position des Verbinder in X (links unten)
   Ausw_ClamexBisco := 1;*VAR*0=Tenso; 1=Divario; 2=Medius 14/10; 3=P10; 4=P14
   PDV_X_5 := 9.5;*VAR*Position des Verbinder in X (lrechts mitte)
   PDV_X_4 := 9.5;*VAR*Position des Verbinder in X (rechts oben)
   PDV_X_6 := 9.5;*VAR*Position des Verbinder in X (rechts unten)
   PDV_Y_1 := 60;*VAR*Position des Verbinders in Y (links oben)
   PDV_Y_2 := 0;*VAR*Position des Verbinders in Y (links mitte)
   PDV_Y_3 := 60;*VAR*Position des Verbinders in Y (links unten)
   PDV_Y_4 := 60;*VAR*Position des Verbinders in Y (rechts oben)
   PDV_Y_5 := 0;*VAR*Position des Verbinders in Y (rechts mitte)
   PDV_Y_6 := 60;*VAR*Position des Verbinders in Y (rechts unten)
   StartCL := 40.1;Eintrittposition (Kreissegment 80.2/2 (mit 5mm überhalb Platte))
   ToolID := -99999;Themp
   CLAMEX_TYP := 1;
   Z_BEWEG := 1.4;Default 1.4
   TEXT := 'nix';
   MODE_Y := -999;2= von links / 4 = von rechts
   WZ1_VE := -99;Clamex_Nuter_ID
   WZ1_V := -99;Clamex_Nuter_ID
   WZ1_VA := -99;Clamex_Nuter_ID
   WZ1_SD := -99;Clamex_Nuter_ID
   WZ2_VE := -99;_Clamex_Nuter_X_WKG_ID
   WZ2_V := -99;_Clamex_Nuter_X_WKG_ID
   WZ2_VA := -99;_Clamex_Nuter_X_WKG_ID
   WZ2_SD := -99;_Clamex_Nuter_X_WKG_ID
   WZ3_VE := -99;_Clamex_Nuter_Y_WKG_ID
   WZ3_V := -99;_Clamex_Nuter_Y_WKG_ID
   WZ3_VA := -99;_Clamex_Nuter_Y_WKG_ID
   WZ3_SD := -99;_Clamex_Nuter_Y_WKG_ID
   WZ4_VE := -99;_Clamex_Stiftfraeser_ID
   WZ4_V := -99;_Clamex_Stiftfraeser_ID
   WZ4_VA := -99;_Clamex_Stiftfraeser_ID
   WZ4_SD := -99;_Clamex_Stiftfraeser_ID
START
Fertigteil (LPX,LPY,LPZ,0,0,0,0,0,'',0,0,0)
CALL _UserInterface3DG (REF RESULT:=ToolID VAL INPUTTEXT:='GetStandardRouterID')
;Definition Maschine in CC Tools
IF (_MaschinenTyp = 0) | (_MaschinenTyp > 5)
Fehlermeldung ('select a Machine - TYP in CCTools')
END
;DEFINITION _Clamex_Nuter_ID
WZF (_Clamex_Nuter_ID,_VE,_V,_VA,_SD,_ANF,'1')
WZ1_VE := _VE
WZ1_VA := _VA
WZ1_V := _V
WZ1_SD := _SD
;DEFINITION _Clamex_Nuter_X_WKG_ID
WZF (_Clamex_Nuter_X_WKG_ID,_VE,_V,_VA,_SD,_ANF,'1')
WZ2_VE := _VE
WZ2_VA := _VA
WZ2_V := _V
WZ2_SD := _SD
;DEFINITION _Clamex_Nuter_Y_WKG_ID
WZF (_Clamex_Nuter_Y_WKG_ID,_VE,_V,_VA,_SD,_ANF,'1')
WZ3_VE := _VE
WZ3_VA := _VA
WZ3_V := _V
WZ3_SD := _SD
;DEFINITION _Clamex_Stiftfraeser_ID
WZF (_Clamex_Stiftfraeser_ID,_VE,_V,_VA,_SD,_ANF,'1')
WZ4_VE := _VE
WZ4_VA := _VA
WZ4_V := _V
WZ4_SD := _SD
;Rotation nur bei 5Achs und C-Achsmaschinen
IF (_MaschinenTyp=1) | (_MaschinenTyp=4)| (_MaschinenTyp=5)
ELSE
;Rotation hier nicht
IF _JOB_ROT>0
Fehlermeldung ('no use rot')
END
END
IF (_MaschinenTyp=1) | (_MaschinenTyp=5)
MODE_Y := 24
END
IF (_MaschinenTyp=2) | (_MaschinenTyp=3)
IF _JOB_MIRX=1
MODE_Y := 4
ELSE
MODE_Y := 2
END
END
IF _MaschinenTyp=4
IF _JOB_MIRX=1
MODE_Y := 2
ELSE
MODE_Y := 4
END
END
;0=Tenso; 1=Divario; 2=Medius 14/10; 3=P10; 4=P14
;P10
IF Ausw_ClamexBisco=0
CLAMEX_TYP := 3
TEXT := 'P-10'
/StartCL := 71.58/2
END
;P14
IF Ausw_ClamexBisco=1
CLAMEX_TYP := 4
TEXT := 'P-14'
/StartCL := 78.65/2
END
;Tenso P14
IF Ausw_ClamexBisco=2
CLAMEX_TYP := 0
TEXT := 'Ten-14'
/StartCL := 78.65/2
END
;Bisco P10
IF Ausw_ClamexBisco=3
CLAMEX_TYP := 3
Z_BEWEG := 0
TEXT := 'Bis-10'
/StartCL := 71.58/2
END
;Bisco P14
IF Ausw_ClamexBisco=4
CLAMEX_TYP := 4
Z_BEWEG := 0
TEXT := 'Bis-14'
/StartCL := 78.65/2
END
;Divario P18
IF Ausw_ClamexBisco=5
CLAMEX_TYP := 1
TEXT := 'DIV-18'
/StartCL := 78.65/2
END
;Medius P14/10
IF Ausw_ClamexBisco=6
CLAMEX_TYP := 2
TEXT := 'MED-10'
/StartCL := 78.65/2
END
;Tenso P10
IF (Ausw_ClamexBisco=8)|(Ausw_ClamexBisco=28)
CLAMEX_TYP := 3
TEXT := 'Tenso P10'
/StartCL := 78.65/2
END
;###########links oben 1############
IF APV_1=1
;EVO**7X05**7X07 oder 7532 gespiegelt
IF MODE_Y=2
CALL Clamex_V7 ( VAL WKZ_NUT_NR:=_Clamex_Nuter_ID,WKZ_NUT_H:='1',WKZ_NUT_V1:=WZ1_VE,WKZ_NUT_V2:=WZ1_V,WKZ_NUT_V3:=WZ1_VA,WKZ_NUT_D:=WZ1_SD,WKZ_BOHR_NR:=9999,WKZ_BOHR_H:='1',WKZ_BOHR_V1:=0,WKZ_BOHR_V2:=0,WKZ_BOHR_V3:=0,WKZ_BOHR_D:=0,WKZ_BOHR_S_NR:=9999,WKZ_BOHR_S_H:='1',WKZ_BOHR_S_V1:=0,WKZ_BOHR_S_V2:=0,WKZ_BOHR_S_V3:=0,WKZ_BOHR_S_D:=0,WKZ_FINGER_NR:=_Clamex_Stiftfraeser_ID,WKZ_FINGER_H:='1',WKZ_FINGER_V1:=WZ4_VE,WKZ_FINGER_V2:=WZ4_V,WKZ_FINGER_V3:=WZ4_VA,WKZ_FINGER_D:=WZ4_SD,WKZ_90_NR:=_Clamex_Nuter_Y_WKG_ID,WKZ_90_H:='1',WKZ_90_V1:=WZ3_VE,WKZ_90_V2:=WZ3_V,WKZ_90_V3:=WZ3_VA,WKZ_90_D:=WZ3_SD,WINKEL:=10,VERBINDUNG:=0,SEITE:=1,BOHR:=0,DRILLINGD:=6,SEITETEIL:=1,VERBINDER:=1,ABSTAND:=_RY-PDV_Y_1,ABSTAND2:=PDV_X_1,ABSTAND3:=60,TSK:=0,FF:=_PSystemStift,TYP:=CLAMEX_TYP,SK:=0,SPSK:=0,EPSK:=0,ADDEITI:=0,WUE:=10,BOU:=Z_BEWEG,OTHERSIDE:=0,RES1:=0,RES2:=-111111,RES3:=0,RES4:=7,RES5:=-111111,RES6:=-111111,RES7:=-111111,RES8:=-111111,RES9:=-111111,RES10:=-111111,RES11:=-111111,RES12:=-111111,RES13:=-111111,RES14:=-111111,RES15:=-111111,RES16:='',RES17:='',RES18:='',RES19:='',RES20:='')
CALL _ZRechteck_2P_V5 ( VAL SX:=PDV_X_1 - 3.5,SY:=PDV_Y_1-StartCL,EX:=PDV_X_1 + 3.5,EY:=PDV_Y_1 + StartCL,FUELLEN:=1,FARBE:=16384,ESXY1:=7,ESXY2:=7)
ZText (TEXT,PDV_X_1+35,_RY-PDV_Y_1,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
;**7532**oder EVO,7X05,7X07 gespiegelt
IF MODE_Y=4
CALL Clamex_V7 ( VAL WKZ_NUT_NR:=_Clamex_Nuter_ID,WKZ_NUT_H:='1',WKZ_NUT_V1:=WZ1_VE,WKZ_NUT_V2:=WZ1_V,WKZ_NUT_V3:=WZ1_VA,WKZ_NUT_D:=WZ1_SD,WKZ_BOHR_NR:=9999,WKZ_BOHR_H:='1',WKZ_BOHR_V1:=0,WKZ_BOHR_V2:=0,WKZ_BOHR_V3:=0,WKZ_BOHR_D:=0,WKZ_BOHR_S_NR:=9999,WKZ_BOHR_S_H:='1',WKZ_BOHR_S_V1:=0,WKZ_BOHR_S_V2:=0,WKZ_BOHR_S_V3:=0,WKZ_BOHR_S_D:=0,WKZ_FINGER_NR:=_Clamex_Stiftfraeser_ID,WKZ_FINGER_H:='1',WKZ_FINGER_V1:=WZ4_VE,WKZ_FINGER_V2:=WZ4_V,WKZ_FINGER_V3:=WZ4_VA,WKZ_FINGER_D:=WZ4_SD,WKZ_90_NR:=_Clamex_Nuter_Y_WKG_ID,WKZ_90_H:='1',WKZ_90_V1:=WZ3_VE,WKZ_90_V2:=WZ3_V,WKZ_90_V3:=WZ3_VA,WKZ_90_D:=WZ3_SD,WINKEL:=10,VERBINDUNG:=0,SEITE:=1,BOHR:=0,DRILLINGD:=6,SEITETEIL:=3,VERBINDER:=1,ABSTAND:=_RY-PDV_Y_1,ABSTAND2:=_RX-PDV_X_1,ABSTAND3:=60,TSK:=0,FF:=_PSystemStift,TYP:=CLAMEX_TYP,SK:=0,SPSK:=0,EPSK:=0,ADDEITI:=0,WUE:=10,BOU:=Z_BEWEG,OTHERSIDE:=0,RES1:=0,RES2:=-111111,RES3:=0,RES4:=7,RES5:=-111111,RES6:=-111111,RES7:=-111111,RES8:=-111111,RES9:=-111111,RES10:=-111111,RES11:=-111111,RES12:=-111111,RES13:=-111111,RES14:=-111111,RES15:=-111111,RES16:='',RES17:='',RES18:='',RES19:='',RES20:='')
CALL _ZRechteck_2P_V5 ( VAL SX:=PDV_X_1 - 3.5,SY:=PDV_Y_1-StartCL,EX:=PDV_X_1 + 3.5,EY:=PDV_Y_1 + StartCL,FUELLEN:=1,FARBE:=128,ESXY1:=7,ESXY2:=7)
ZText (TEXT,PDV_X_1+35,_RY-PDV_Y_1,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
;**C-Achs**5Achs**
IF MODE_Y=24
