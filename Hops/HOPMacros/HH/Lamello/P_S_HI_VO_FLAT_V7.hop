;MAKROTYP=1
;INSTVERSION=
;EXEVERSION=7.0.2.1[Hops.exe]
;BILD=P_S_HI_VO_FLAT_V7.BMP
;INFO=
;WZGV=7225K_V7_DEMO
;WZGVCONFIG=
;MASCHINE=BetterSIM
;NCNAME=P_S_HI_VO_FLAT_V7
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=HHDialogs_P_System_BASE_V7.Dll
;DIALOGPROC=ShowPSystemFlaecheX_V7
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   LPX := 1500;
   LPY := 600;
   LPZ := 19;
   APV_1 := 1;*VAR*HL
   APV_2 := 1;*VAR*HM
   APV_3 := 1;*VAR*HR
   APV_4 := 1;*VAR*VL
   APV_5 := 1;*VAR*VM
   APV_6 := 1;*VAR*VR
   PDV_X_1 := 60;*VAR*HL
   PDV_X_2 := 0;*VAR*HM
   PDV_X_3 := 60;*VAR*HR
   PDV_X_4 := 60;*VAR*VL
   PDV_X_5 := 0;*VAR*VM
   PDV_X_6 := 60;*VAR*VR
   PDV_Y_1 := 9.5;*VAR*HL
   PDV_Y_2 := 9.5;*VAR*HM
   PDV_Y_3 := 9.5;*VAR*HR
   PDV_Y_4 := 9.5;*VAR*VL
   PDV_Y_5 := 9.5;*VAR*VM
   PDV_Y_6 := 9.5;*VAR*VR
   Ausw_ClamexBisco := 1;*VAR*0=Tenso; 1=Divario; 2=Medius 14/10; 3=P10; 4=P14
   StartCL := 40.1;Eintrittposition (Kreissegment 80.2/2 (mit 5mm überhalb Platte))
   ToolID := -99999;Themp
   CLAMEX_TYP := 1;
   Z_BEWEG := 1.4;Default 1.4
   TEXT := 'keinText';
   MODE_X := -999;
   WZ1_VE := -99;Clamex_Nuter_ID
   WZ1_V := -99;Clamex_Nuter_ID
   WZ1_VA := -99;Clamex_Nuter_ID
   WZ1_SD := -99;Clamex_Nuter_ID
   WZ2_VE := -99;_Clamex_Nuter_X_WKG_ID
   WZ2_V := -99;_Clamex_Nuter_X_WKG_ID
   WZ2_VA := -99;_Clamex_Nuter_X_WKG_ID
   WZ2_SD := -99;_Clamex_Nuter_X_WKG_ID
   WZ3_VE := -99;_Clamex_Nuter_Y_WKG_ID
   WZ3_V := -99;_Clamex_Nuter_Y_WKG_ID
   WZ3_VA := -99;_Clamex_Nuter_Y_WKG_ID
   WZ3_SD := -99;_Clamex_Nuter_Y_WKG_ID
   WZ4_VE := -99;_Clamex_Stiftfraeser_ID
   WZ4_V := -99;_Clamex_Stiftfraeser_ID
   WZ4_VA := -99;_Clamex_Stiftfraeser_ID
   WZ4_SD := -99;_Clamex_Stiftfraeser_ID
START
Fertigteil (LPX,LPY,LPZ,0,0,0,0,0,'',0,0,0)
CALL _UserInterface3DG (REF RESULT:=ToolID VAL INPUTTEXT:='GetStandardRouterID')
IF (_MaschinenTyp = 0) | (_MaschinenTyp > 5)
Fehlermeldung ('select a Machine - TYP in CCTools')
END
;DEFINITION _Clamex_Nuter_ID
WZF (_Clamex_Nuter_ID,_VE,_V,_VA,_SD,_ANF,'1')
WZ1_VE := _VE
WZ1_VA := _VA
WZ1_V := _V
WZ1_SD := _SD
;DEFINITION _Clamex_Nuter_X_WKG_ID
WZF (_Clamex_Nuter_X_WKG_ID,_VE,_V,_VA,_SD,_ANF,'1')
WZ2_VE := _VE
WZ2_VA := _VA
WZ2_V := _V
WZ2_SD := _SD
;DEFINITION _Clamex_Nuter_Y_WKG_ID
WZF (_Clamex_Nuter_Y_WKG_ID,_VE,_V,_VA,_SD,_ANF,'1')
WZ3_VE := _VE
WZ3_VA := _VA
WZ3_V := _V
WZ3_SD := _SD
;DEFINITION _Clamex_Stiftfraeser_ID
WZF (_Clamex_Stiftfraeser_ID,_VE,_V,_VA,_SD,_ANF,'1')
WZ4_VE := _VE
WZ4_VA := _VA
WZ4_V := _V
WZ4_SD := _SD
;Keine Rotation zugelassen
IF _JOB_ROT>0
Fehlermeldung ('no use rot')
END
;C-Achse / 5XL
IF (_MaschinenTyp=1) | (_MaschinenTyp=5)
MODE_X := 13
END
;EVO
IF _MaschinenTyp=2
IF _JOB_MIRY=1
MODE_X := 3
ELSE
MODE_X := 1
END
END
;7X05 / 7X07 / 7532
IF (_MaschinenTyp=3) | (_MaschinenTyp=4)
IF _JOB_MIRY=1
MODE_X := 1
ELSE
MODE_X := 3
END
END
;0=Tenso; 1=Divario; 2=Medius 14/10; 3=P10; 4=P14
;P10
IF Ausw_ClamexBisco=0
CLAMEX_TYP := 3
TEXT := 'P-10'
/StartCL := 71.58/2
END
;P14
IF Ausw_ClamexBisco=1
CLAMEX_TYP := 4
TEXT := 'P-14'
/StartCL := 78.65/2
END
;Tenso P14
IF Ausw_ClamexBisco=2
CLAMEX_TYP := 0
TEXT := 'Ten-14'
/StartCL := 78.65/2
END
;Bisco P10
IF Ausw_ClamexBisco=3
CLAMEX_TYP := 3
Z_BEWEG := 0
TEXT := 'Bis-10'
/StartCL := 71.58/2
END
;Bisco P14
IF Ausw_ClamexBisco=4
CLAMEX_TYP := 4
Z_BEWEG := 0
TEXT := 'Bis-14'
/StartCL := 78.65/2
END
;Divario P18
IF Ausw_ClamexBisco=5
CLAMEX_TYP := 1
Z_BEWEG := 1
TEXT := 'DIV-18'
/StartCL := 78.65/2
END
;Medius P14/10
IF Ausw_ClamexBisco=6
CLAMEX_TYP := 2
Z_BEWEG := 1
TEXT := 'Med-10'
/StartCL := 78.65/2
END
;1 hinten links
IF APV_1=1
IF (MODE_X=13) | (MODE_X=3)
CALL Clamex_V7 ( VAL WKZ_NUT_NR:=_Clamex_Nuter_ID,WKZ_NUT_H:='1',WKZ_NUT_V1:=WZ1_VE,WKZ_NUT_V2:=WZ1_V,WKZ_NUT_V3:=WZ1_VA,WKZ_NUT_D:=WZ1_SD,WKZ_BOHR_NR:=9999,WKZ_BOHR_H:='1',WKZ_BOHR_V1:=0,WKZ_BOHR_V2:=0,WKZ_BOHR_V3:=0,WKZ_BOHR_D:=0,WKZ_BOHR_S_NR:=9999,WKZ_BOHR_S_H:='1',WKZ_BOHR_S_V1:=0,WKZ_BOHR_S_V2:=0,WKZ_BOHR_S_V3:=0,WKZ_BOHR_S_D:=0,WKZ_FINGER_NR:=_Clamex_Stiftfraeser_ID,WKZ_FINGER_H:='1',WKZ_FINGER_V1:=WZ4_VE,WKZ_FINGER_V2:=WZ4_V,WKZ_FINGER_V3:=WZ4_VA,WKZ_FINGER_D:=WZ4_SD,WKZ_90_NR:=_Clamex_Nuter_X_WKG_ID,WKZ_90_H:='1',WKZ_90_V1:=WZ2_VE,WKZ_90_V2:=WZ2_V,WKZ_90_V3:=WZ2_VA,WKZ_90_D:=WZ2_SD,WINKEL:=10,VERBINDUNG:=0,SEITE:=1,BOHR:=0,DRILLINGD:=6,SEITETEIL:=2,VERBINDER:=1,ABSTAND:=PDV_X_1,ABSTAND2:=PDV_Y_1,ABSTAND3:=60,TSK:=0,FF:=_PSystemStift,TYP:=CLAMEX_TYP,SK:=0,SPSK:=0,EPSK:=0,ADDEITI:=0,WUE:=10,BOU:=Z_BEWEG,OTHERSIDE:=0,RES1:=0,RES2:=-111111,RES3:=0,RES4:=7,RES5:=-111111,RES6:=-111111,RES7:=-111111,RES8:=-111111,RES9:=-111111,RES10:=-111111,RES11:=-111111,RES12:=-111111,RES13:=-111111,RES14:=-111111,RES15:=-111111,RES16:='',RES17:='',RES18:='',RES19:='',RES20:='');BREAKPOINT
CALL _ZRechteck_2P_V5 ( VAL SX:=PDV_X_1 - StartCL,SY:=_RY-PDV_Y_1-3.5,EX:=PDV_X_1 + StartCL,EY:=_RY-PDV_Y_1 + 3.5,FUELLEN:=1,FARBE:=4227200,ESXY1:=0,ESXY2:=0)
ZText (TEXT,PDV_X_1,_RY-PDV_Y_1 -25,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
IF MODE_X=1
CALL Clamex_V7 ( VAL WKZ_NUT_NR:=_Clamex_Nuter_ID,WKZ_NUT_H:='1',WKZ_NUT_V1:=WZ1_VE,WKZ_NUT_V2:=WZ1_V,WKZ_NUT_V3:=WZ1_VA,WKZ_NUT_D:=WZ1_SD,WKZ_BOHR_NR:=4444,WKZ_BOHR_H:='1',WKZ_BOHR_V1:=0,WKZ_BOHR_V2:=0,WKZ_BOHR_V3:=0,WKZ_BOHR_D:=0,WKZ_BOHR_S_NR:=9999,WKZ_BOHR_S_H:='1',WKZ_BOHR_S_V1:=0,WKZ_BOHR_S_V2:=0,WKZ_BOHR_S_V3:=0,WKZ_BOHR_S_D:=0,WKZ_FINGER_NR:=_Clamex_Stiftfraeser_ID,WKZ_FINGER_H:='1',WKZ_FINGER_V1:=WZ4_VE,WKZ_FINGER_V2:=WZ4_V,WKZ_FINGER_V3:=WZ4_VA,WKZ_FINGER_D:=WZ4_SD,WKZ_90_NR:=_Clamex_Nuter_X_WKG_ID,WKZ_90_H:='1',WKZ_90_V1:=WZ2_VE,WKZ_90_V2:=WZ2_V,WKZ_90_V3:=WZ2_VA,WKZ_90_D:=WZ2_SD,WINKEL:=10,VERBINDUNG:=0,SEITE:=1,BOHR:=0,DRILLINGD:=6,SEITETEIL:=0,VERBINDER:=1,ABSTAND:=PDV_X_1,ABSTAND2:=_RY-PDV_Y_1,ABSTAND3:=60,TSK:=0,FF:=_PSystemStift,TYP:=CLAMEX_TYP,SK:=0,SPSK:=0,EPSK:=0,ADDEITI:=0,WUE:=10,BOU:=Z_BEWEG,OTHERSIDE:=0,RES1:=0,RES2:=-111111,RES3:=0,RES4:=7,RES5:=-111111,RES6:=-111111,RES7:=-111111,RES8:=-111111,RES9:=-111111,RES10:=-111111,RES11:=-111111,RES12:=-111111,RES13:=-111111,RES14:=-111111,RES15:=-111111,RES16:='',RES17:='',RES18:='',RES19:='',RES20:='')
CALL _ZRechteck_2P_V5 ( VAL SX:=PDV_X_1 - StartCL,SY:=_RY-PDV_Y_1-3.5,EX:=PDV_X_1 + StartCL,EY:=_RY-PDV_Y_1 + 3.5,FUELLEN:=1,FARBE:=8421440,ESXY1:=0,ESXY2:=0)
ZText (TEXT,PDV_X_1,_RY-PDV_Y_1 -25,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
END
;2 hinten mitte
IF APV_2=1
IF (MODE_X=13) | (MODE_X=3)
CALL Clamex_V7 ( VAL WKZ_NUT_NR:=_Clamex_Nuter_ID,WKZ_NUT_H:='1',WKZ_NUT_V1:=WZ1_VE,WKZ_NUT_V2:=WZ1_V,WKZ_NUT_V3:=WZ1_VA,WKZ_NUT_D:=WZ1_SD,WKZ_BOHR_NR:=9999,WKZ_BOHR_H:='1',WKZ_BOHR_V1:=0,WKZ_BOHR_V2:=0,WKZ_BOHR_V3:=0,WKZ_BOHR_D:=0,WKZ_BOHR_S_NR:=9999,WKZ_BOHR_S_H:='1',WKZ_BOHR_S_V1:=0,WKZ_BOHR_S_V2:=0,WKZ_BOHR_S_V3:=0,WKZ_BOHR_S_D:=0,WKZ_FINGER_NR:=_Clamex_Stiftfraeser_ID,WKZ_FINGER_H:='1',WKZ_FINGER_V1:=WZ4_VE,WKZ_FINGER_V2:=WZ4_V,WKZ_FINGER_V3:=WZ4_VA,WKZ_FINGER_D:=WZ4_SD,WKZ_90_NR:=_Clamex_Nuter_X_WKG_ID,WKZ_90_H:='1',WKZ_90_V1:=WZ2_VE,WKZ_90_V2:=WZ2_V,WKZ_90_V3:=WZ2_VA,WKZ_90_D:=WZ2_SD,WINKEL:=10,VERBINDUNG:=0,SEITE:=1,BOHR:=0,DRILLINGD:=6,SEITETEIL:=2,VERBINDER:=1,ABSTAND:=_RX/2+PDV_X_2,ABSTAND2:=PDV_Y_2,ABSTAND3:=60,TSK:=0,FF:=_PSystemStift,TYP:=CLAMEX_TYP,SK:=0,SPSK:=0,EPSK:=0,ADDEITI:=0,WUE:=10,BOU:=Z_BEWEG,OTHERSIDE:=0,RES1:=0,RES2:=-111111,RES3:=0,RES4:=7,RES5:=-111111,RES6:=-111111,RES7:=-111111,RES8:=-111111,RES9:=-111111,RES10:=-111111,RES11:=-111111,RES12:=-111111,RES13:=-111111,RES14:=-111111,RES15:=-111111,RES16:='',RES17:='',RES18:='',RES19:='',RES20:='')
CALL _ZRechteck_2P_V5 ( VAL SX:=_RX/2+PDV_X_2 - StartCL,SY:=_RY-PDV_Y_2-3.5,EX:=_RX/2+PDV_X_2 + StartCL,EY:=_RY-PDV_Y_2 + 3.5,FUELLEN:=1,FARBE:=4227200,ESXY1:=0,ESXY2:=0)
ZText (TEXT,_RX/2+PDV_X_2,_RY-PDV_Y_2 -25,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
IF MODE_X=1
CALL Clamex_V7 ( VAL WKZ_NUT_NR:=_Clamex_Nuter_ID,WKZ_NUT_H:='1',WKZ_NUT_V1:=WZ1_VE,WKZ_NUT_V2:=WZ1_V,WKZ_NUT_V3:=WZ1_VA,WKZ_NUT_D:=WZ1_SD,WKZ_BOHR_NR:=9999,WKZ_BOHR_H:='1',WKZ_BOHR_V1:=0,WKZ_BOHR_V2:=0,WKZ_BOHR_V3:=0,WKZ_BOHR_D:=0,WKZ_BOHR_S_NR:=9999,WKZ_BOHR_S_H:='1',WKZ_BOHR_S_V1:=0,WKZ_BOHR_S_V2:=0,WKZ_BOHR_S_V3:=0,WKZ_BOHR_S_D:=0,WKZ_FINGER_NR:=_Clamex_Stiftfraeser_ID,WKZ_FINGER_H:='1',WKZ_FINGER_V1:=WZ4_VE,WKZ_FINGER_V2:=WZ4_V,WKZ_FINGER_V3:=WZ4_VA,WKZ_FINGER_D:=WZ4_SD,WKZ_90_NR:=_Clamex_Nuter_X_WKG_ID,WKZ_90_H:='1',WKZ_90_V1:=WZ2_VE,WKZ_90_V2:=WZ2_V,WKZ_90_V3:=WZ2_VA,WKZ_90_D:=WZ2_SD,WINKEL:=10,VERBINDUNG:=0,SEITE:=1,BOHR:=0,DRILLINGD:=6,SEITETEIL:=0,VERBINDER:=1,ABSTAND:=_RX/2+PDV_X_2,ABSTAND2:=_RY-PDV_Y_2,ABSTAND3:=60,TSK:=0,FF:=_PSystemStift,TYP:=CLAMEX_TYP,SK:=0,SPSK:=0,EPSK:=0,ADDEITI:=0,WUE:=10,BOU:=Z_BEWEG,OTHERSIDE:=0,RES1:=0,RES2:=-111111,RES3:=0,RES4:=7,RES5:=-111111,RES6:=-111111,RES7:=-111111,RES8:=-111111,RES9:=-111111,RES10:=-111111,RES11:=-111111,RES12:=-111111,RES13:=-111111,RES14:=-111111,RES15:=-111111,RES16:='',RES17:='',RES18:='',RES19:='',RES20:='')
CALL _ZRechteck_2P_V5 ( VAL SX:=_RX/2+PDV_X_2 - StartCL,SY:=_RY-PDV_Y_2-3.5,EX:=_RX/2+PDV_X_2 + StartCL,EY:=_RY-PDV_Y_2 + 3.5,FUELLEN:=1,FARBE:=8421440,ESXY1:=0,ESXY2:=0)
ZText (TEXT,_RX/2+PDV_X_2,_RY-PDV_Y_1 -25,25,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
END
;3 hinten rechts
IF APV_3=1
IF (MODE_X=13) | (MODE_X=3)
CALL Clamex_V7 ( VAL WKZ_NUT_NR:=_Clamex_Nuter_ID,WKZ_NUT_H:='1',WKZ_NUT_V1:=WZ1_VE,WKZ_NUT_V2:=WZ1_V,WKZ_NUT_V3:=WZ1_VA,WKZ_NUT_D:=WZ1_SD,WKZ_BOHR_NR:=9999,WKZ_BOHR_H:='1',WKZ_BOHR_V1:=0,WKZ_BOHR_V2:=0,WKZ_BOHR_V3:=0,WKZ_BOHR_D:=0,WKZ_BOHR_S_NR:=9999,WKZ_BOHR_S_H:='1',WKZ_BOHR_S_V1:=0,WKZ_BOHR_S_V2:=0,WKZ_BOHR_S_V3:=0,WKZ_BOHR_S_D:=0,WKZ_FINGER_NR:=_Clamex_Stiftfraeser_ID,WKZ_FINGER_H:='1',WKZ_FINGER_V1:=WZ4_VE,WKZ_FINGER_V2:=WZ4_V,WKZ_FINGER_V3:=WZ4_VA,WKZ_FINGER_D:=WZ4_SD,WKZ_90_NR:=_Clamex_Nuter_X_WKG_ID,WKZ_90_H:='1',WKZ_90_V1:=WZ2_VE,WKZ_90_V2:=WZ2_V,WKZ_90_V3:=WZ2_VA,WKZ_90_D:=WZ2_SD,WINKEL:=10,VERBINDUNG:=0,SEITE:=1,BOHR:=0,DRILLINGD:=6,SEITETEIL:=2,VERBINDER:=1,ABSTAND:=_RX-PDV_X_3,ABSTAND2:=PDV_Y_3,ABSTAND3:=60,TSK:=0,FF:=_PSystemStift,TYP:=CLAMEX_TYP,SK:=0,SPSK:=0,EPSK:=0,ADDEITI:=0,WUE:=10,BOU:=Z_BEWEG,OTHERSIDE:=0,RES1:=0,RES2:=-111111,RES3:=0,RES4:=7,RES5:=-111111,RES6:=-111111,RES7:=-111111,RES8:=-111111,RES9:=-111111,RES10:=-111111,RES11:=-111111,RES12:=-111111,RES13:=-111111,RES14:=-111111,RES15:=-111111,RES16:='',RES17:='',RES18:='',RES19:='',RES20:='')
CALL _ZRechteck_2P_V5 ( VAL SX:=_RX-PDV_X_3 - StartCL,SY:=_RY-PDV_Y_3-3.5,EX:=_RX-PDV_X_3 + StartCL,EY:=_RY-PDV_Y_3 + 3.5,FUELLEN:=1,FARBE:=4227200,ESXY1:=0,ESXY2:=0)
