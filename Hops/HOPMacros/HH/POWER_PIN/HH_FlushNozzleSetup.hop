;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.13.0.10[Hops.exe]
;BILD=HH_FLUSHNOZZLESETUP.WMF
;INFO=
;WZGV=7605_101
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=HH_FlushNozzleSetup
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   DX := 600;Dimension X
   DY := 400;Dimension Y
   DZ := 19;Dimension Z
   BPosX := 50;*VAR*
   BPosZ := 9.5;*VAR*
   BD := 8;*VAR*
   BT := 27;*VAR*
   MTMWKZ := 1;*VAR*Spindel mit Werkzeug 1=101; 2=102; 4=103
START
Fertigteil (DX,DY,DZ,0,0,0,0,0,'',0,0,0)
CALL Park_V7 ( VAL MODE:=3,POSX:=0,POSY:=0)
WZB (501,_VE,_V,_VA,_SD,_ANF,'')
CALL NCLineDirekt_V7 ( VAL HOLD:=0,HOLDCLONEMOVEZ:=0,MODE:=0,STR:='TC; 886; 886; 0 ;')
CALL NCLineDirekt_V7 ( VAL HOLD:=0,HOLDCLONEMOVEZ:=0,MODE:=0,STR:='TSPEED; 51; 3; 3500;')
CALL NCLineDirekt_V7 ( VAL HOLD:=0,HOLDCLONEMOVEZ:=0,MODE:=0,STR:='TC; 51; 501; ' + INTTOSTR(MTMWKZ) + ';')
CALL NCLineDirekt_V7 ( VAL HOLD:=0,HOLDCLONEMOVEZ:=0,MODE:=0,STR:='HD; -' + INTTOSTR(BPosX) + '; 9999.000; -' + INTTOSTR(BPosZ) + '; ' + INTTOSTR(BD) + '; -' + INTTOSTR(BT) + ';')
CALL HH_DowelGr_HY ( VAL BIY:=BPosX,BIIY:=32,BIIIY:=32,BIIIIY:=32,Z:=BPosZ,SPIEGELN:=0,T:=-BT,D:=BD,EBENE:=0,INKREMENT:=0,ESY:=3,ESZ:=0,USE2:=0,USE3:=0,USE4:=0,BAKTIV:=1,LAKTIV:=0,DAKTIV:=0,DUEBA:=15,LEIMZ:=0.5,DUEBL:=40,NUM1:=789,NUM2:=666,STR1:='AA')
