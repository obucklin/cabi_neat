;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.13.0.10[Hops.exe]
;BILD=HH_BOHRUNG.WMF
;INFO=
;WZGV=7605_101
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=HH_Bohrung
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0
;DIALOGDLL=DialogsSys.Dll
;DIALOGPROC=ShowBohrungDialog
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   X := 30;*VAR*X-Wert
   Y := 30;*VAR*Y-Wert
   D := 8;*VAR*Bohrdurchmesser
   T := -13;*VAR*Bohrtiefe
   TLF := 10;*VAR*Tieflochflag
   KW := 0;*VAR*Kippwinkel
   DW := 0;*VAR*Drehwinkel
   esxy := 1;*VAR*Easysnap in xy
   esd := 0;*VAR*Easysnap depth
   AxisDW := 0;*VAR*Achsstellung
   res1 := 1;*VAR*Von unten
   res2 := 0;*VAR*reserve2
   max_Y_POS := 35.5;
   max_X_POS := 35.5;
   Kante := -99;1=vorne / 2=links / 3=hinten / 4=rechts
START
;Power-PIN
;31.08.2023 HH
;vorne links oder 0-Point
IF (esxy=1)|(esxy=0)
Bohrung (X,Y,D,T,TLF,0,0,1,esd,0,res1,0)
CALL HH_DRAW_DRILL ( VAL POSX:=X,POSY:=Y,D:=D,SHOW:=res1)
END
;vorne mitte
IF (esxy=2)
Bohrung (X,Y,D,T,TLF,0,0,2,esd,0,res1,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX/2+X,POSY:=Y,D:=D,SHOW:=res1)
END
;vorne rechts
IF (esxy=3)
Bohrung (X,Y,D,T,TLF,0,0,3,esd,0,res1,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-X,POSY:=Y,D:=D,SHOW:=res1)
END
;mitte rechts
IF (esxy=4)
Bohrung (X,Y,D,T,TLF,0,0,4,esd,0,res1,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-X,POSY:=_RY/2+Y,D:=D,SHOW:=res1)
END
;hinten rechts
IF (esxy=5)
Bohrung (X,Y,D,T,TLF,0,0,5,esd,0,res1,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-X,POSY:=_RY-Y,D:=D,SHOW:=res1)
END
;hinten mitte
IF (esxy=6)
Bohrung (X,Y,D,T,TLF,0,0,6,esd,0,res1,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX/2+X,POSY:=_RY-Y,D:=D,SHOW:=res1)
END
;hinten links
IF (esxy=7)
Bohrung (X,Y,D,T,TLF,0,0,7,esd,0,res1,0)
CALL HH_DRAW_DRILL ( VAL POSX:=X,POSY:=_RY-Y,D:=D,SHOW:=res1)
END
;mitte links
IF (esxy=8)
Bohrung (X,Y,D,T,TLF,0,0,8,esd,0,res1,0)
CALL HH_DRAW_DRILL ( VAL POSX:=X,POSY:=_RY/2+Y,D:=D,SHOW:=res1)
END
;mitte
IF (esxy=9)
Bohrung (X,Y,D,T,TLF,0,0,9,esd,0,res1,0)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX/2+X,POSY:=_RY/2+Y,D:=D,SHOW:=res1)
END
