;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.11.0.182[Hops.exe]
;BILD=DRAW_CABINEO_POWERPIN.WMF
;INFO=
;WZGV=7605_071222
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=DRAW_CABINEO_POWERPIN
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   Y := 50;*VAR*
   X := 50;*VAR*
   Kante := 1;*VAR*
START
IF Kante=1
CALL HH_DRAW_DRILL ( VAL POSX:=3.6,POSY:=Y,D:=15,SHOW:=1)
CALL HH_DRAW_DRILL ( VAL POSX:=14.8,POSY:=Y,D:=15,SHOW:=1)
CALL HH_DRAW_DRILL ( VAL POSX:=26,POSY:=Y,D:=15,SHOW:=1)
END
IF Kante=2
CALL HH_DRAW_DRILL ( VAL POSX:=X,POSY:=_RY-3.6,D:=15,SHOW:=1)
CALL HH_DRAW_DRILL ( VAL POSX:=X,POSY:=_RY-14.8,D:=15,SHOW:=1)
CALL HH_DRAW_DRILL ( VAL POSX:=X,POSY:=_RY-26,D:=15,SHOW:=1)
END
IF Kante=3
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-3.6,POSY:=Y,D:=15,SHOW:=1)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-14.8,POSY:=Y,D:=15,SHOW:=1)
CALL HH_DRAW_DRILL ( VAL POSX:=_RX-26,POSY:=Y,D:=15,SHOW:=1)
END
IF Kante=4
CALL HH_DRAW_DRILL ( VAL POSX:=X,POSY:=3.6,D:=15,SHOW:=1)
CALL HH_DRAW_DRILL ( VAL POSX:=X,POSY:=14.8,D:=15,SHOW:=1)
CALL HH_DRAW_DRILL ( VAL POSX:=X,POSY:=26,D:=15,SHOW:=1)
END
