;ZU für Unterhalb Saugermitte
_ZO := ZMO
_ZU := _ZA
END
IF _ZO<ZMO
_ZO := ZMO
END
IF _ZU<ZMU
_Z := ZMU
END
;Wenn nicht drehbar, dann normale Maße übernehmen
IF _DWakt=0
_ZO := ZMO
_ZU := ZMU
END
ELSE
_ZO := ZMO
_ZU := ZMU
IF _DWakt=180
_ZU := ZMO
_ZO := ZMU
END
END
END;BREAKPOINT
