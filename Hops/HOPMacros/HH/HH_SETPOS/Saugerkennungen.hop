VARS
   SN := '';Saugername
   S2 := 0;Auswertung für rotierbarkeit
   DX := 600;Dimension X
   DY := 400;Dimension Y
   DZ := 19;Dimension Z
   SaugerX := 0;
   Saugerkennung_akt := 50;*VAR*
   SK1 := '';Saugerkennung 1
   SK53 := '';
   Beta := 0;Berechnungswinkel
   R := 0;
   _SB := '';
   X0 := 0;
   Y0 := 0;
   DWhilf := 0;
   ZMO := 0;Zusatzmaß oben
   ZMU := 0;Zusatzmaß unten
START
_SB := 'x';BREAKPOINT
;#
;#
;#
;#
;#
;#
;#
;Bei neuem Sauger:
;Ab hier kopieren
;#
;#
;Saugername aus MTManager
;X0 ist halbe Saugerbreite
;Y0 ist Y-Maß von Saugermitte bis Außenkante Spannfläche
/X0 := 0
/Y0 := 0
;ZMO beschreibt Überstand der Spannfläche über Grundkörper oben
;ZMU beschreibt Überstand der Spannfläche über Grundkörper unten
/ZMO := 85
/ZMU := 85
;Zurücksetzen der Übergabevariablen
/_ZO := 0
/_ZU := 0
/DWhilf := 0
;Auswertung ob Sauger drehbar ist (Bedingt durch _rot im Namen)
/SN := _SB
/SN := IntToStr(StrPos('_rot',SN))
/S2 := StrtoInt(SN)
;negative Winkeleingabe verrechnen
/IF _DWakt<0
/_DWakt := 360+_DWakt
/END
;Wenn drehbar, dann neue Abstandsberechnung über Ecken des Saugers
/IF S2>0
/Beta := ARCTAN((Y0)/(X0))
/R := Y0/SIN(Beta)
/IF _DWakt<=90
/DWhilf := _DWakt
/END
/IF _DWakt>270
/DWhilf := 360-_DWakt
/END
/IF (_DWakt>90)&(_DWakt<=180)
/DWhilf := 180-_DWakt
/END
/IF (_DWakt>180)&(_DWakt<=270)
/DWhilf := _DWakt-180
/END
/IF DWhilf>0
/_ZA := ((SIN(Beta+DWhilf)*R))
/IF _ZA<0
/_ZA := 0
/END
/END
/IF (_DWakt>90)&(_DWakt<=270)
;ZO für Oberhalb Saugermitte
/_ZO := _ZA
/_ZU := ZMU
/ELSE
;ZU für Unterhalb Saugermitte
/_ZO := ZMO
/_ZU := _ZA
/END
/IF _ZO<ZMO
/_ZO := ZMO
/END
/IF _ZU<ZMU
/_Z := ZMU
/END
;Wenn nicht drehbar, dann normale Maße übernehmen
/IF _DWakt=0
/_ZO := ZMO
/_ZU := ZMU
/END
/ELSE
/_ZO := ZMO
/_ZU := ZMU
/IF _DWakt=180
/_ZU := ZMO
/_ZO := ZMU
/END
/END
