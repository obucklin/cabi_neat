;*******************************************
;*******************************************
;Makroeinstellungen bei Inbetriebnahme an Maschine anpassen!
;Adapt macro settings to machine during commissioning!
;*******************************************
;*******************************************
_Anzahl_Konsolen := 8
;#
;Konsolenkonfiguration einstellen
;2=Konsole ohne Beschickungshilfe
;3=Konsole mit Beschickungshilfe
;#
_K1 := 2
_K2 := 2
_K3 := 3
_K4 := 2
_K5 := 3
_K6 := 3
_K7 := 2
_K8 := 2
_K9 := 2
_K10 := 2
_K11 := 3
_K12 := 2
IF (_Anzahl_Konsolen<0)|(_K1<0)|(_K2<0)|(_K3<0)|(_K4<0)|(_K5<0)|(_K6<0)|(_K7<0)|(_K8<0)|(_K9<0)|(_K10<0)|(_K11<0)|(_K12<0)
END
;#
;Konsolenabstände einstellen
;_KON_A_1= Konsolenabstand erste Konsole ab Werkstückanschlag
;_KON_A_X= Konsolenabstand zwischen zwei Konsolen ohne Beschickungshilfe dazwischen
;_KON_A_B= Konsolenabstand zwischen zwei Konsolen mit Beschickungshilfe dazwischen
;_KON_A_D= Konsolenabstand zwischen den beiden mittleren Konsolen (Wichtig für Tischkopplung)
;#
_KON_A_1 := 149
_KON_A_X := 220
_KON_A_B := 255
_KON_A_D := 260
;#
;Saugerschlittenabstände einstellen
;_SAU_1= Min. Abstand Mitte Saugerschlitten zu Anschlag vorne
;_SAU_OHNE= Min. Abstand zweier Saugerschlitten Mitte bis Mitte
;#
_SAU_1 := 114
_SAU_OHNE := 109
;*******************************************
;*******************************************
;Ende der Makroeinstellungen
;End of macro settings
;*******************************************
;*******************************************
;*******************************************
;*******************************************
;Zurücksetzen von Zählern und Speichervariablen
;*******************************************
;*******************************************
_Xa := -1
_Ya := -1
_ZAa := -1
_countG := -1
_count := -1
_countS := -1
