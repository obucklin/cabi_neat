;#
;#
;Name mit Feld Index erweitern
;#
;#
IF _Feld=0
_SZB := STRINSERT(_SZB,'A_',0)
END
IF _Feld=1
_SZB := STRINSERT(_SZB,'D_',0)
END
_SZB := STRINSERT(_SZB,'_',0)
IF (_Tcount+1)>(_Anzahl_Konsolen/2)
IF STRPOS('A',_SZB)>0
_SZB := STRREPLACE(_SZB,'A','D')
ELSE
_SZB := STRREPLACE(_SZB,'D','A')
END
END
;#
;#
;Name um Listennummer erweitern
;#
;#
IF STRPOS('A',_SZB)>0
_SZB := STRINSERT(_SZB,INTTOSTR((_S1*8)+(_S2+1)),0)
END
IF STRPOS('D',_SZB)>0
_SZB := STRINSERT(_SZB,INTTOSTR((_S1*8)+(_S2+1)+100),0)
END
;#
;#
;Name für ersten Sauger generieren
;#
;#
_SN := _SZB
ELSE
;#
;#
