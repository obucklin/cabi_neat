;#
;#
;#
;#
;#
;#
;#
;#
;#
;#
;#
;#
;Positionierung Konsole 5
;count Grundkörperindex wird zurückgesetzt für neue Traverse
count := -1
_Xa := _Xakt
_Ya := 0
_DWa := 0
_ZOalt := 0
_ZO := 0
_ZU := 0
IF X5>0
_Xakt := X5
;Tcount zählt Traversenindex hoch
Tcount := Tcount+1
;Wenn Plausibilität an ist, wird X Position gecheckt
;und bei Kollission überschrieben mit neuem X-Wert
IF Plausibilitaet=1
;Die Konsole (Kx) wird je nach Konfiguration (1-5) auf Kollission geprüft
;1=Konsole ohne Anbauteile
;2=Konsole mit Beschickungshilfe rechts
;3=Konsole mit Beschickungshilfe links
;4=Konsole mit MittelAnschlag rechts
;5=Konsole mit MittelAnschlag links
IF (K4=1)&((K5=1)|(K5=2)|(K5=4))
IF _Xakt<_Xa+(KON_OHNE*2)
_Xakt := _Xa+(KON_OHNE*2)
;Änderung der Traversenposition wird durch rotes Rechteck angezeigt
ZRechteck (_Xakt-KON_OHNE-10,0,(KON_OHNE+10)*2,1500,0,987135,0,5,1,1)
Hinweismeldung ('Konsole: collision check changed position - Please check Result')
END
END
;#
IF ((K4=2)|(K4=6))&((K5=3)|(K5=7))
IF _Xakt<_Xa+KON_BH_L+KON_BH_R
_Xakt := _Xa+KON_BH_L+KON_BH_R
;Änderung der Traversenposition wird durch rotes Rechteck angezeigt
ZRechteck (_Xakt-KON_OHNE-10,0,(KON_OHNE+10)*2,1500,0,987135,0,5,1,1)
Hinweismeldung ('Konsole: collision check changed position - Please check Result')
END
END
;#
IF ((K4=2)|(K4=6))&((K5=4)|(K5=6))
IF _Xakt<_Xa+KON_A_L+KON_BH_R
_Xakt := _Xa+KON_A_L+KON_BH_R
;Änderung der Traversenposition wird durch rotes Rechteck angezeigt
ZRechteck (_Xakt-KON_OHNE-10,0,(KON_OHNE+10)*2,1500,0,987135,0,5,1,1)
Hinweismeldung ('Konsole: collision check changed position - Please check Result')
END
END
;#
IF ((K4=2))&((K5=2)|(K5=1)|(K5=5))
IF _Xakt<_Xa+KON_OHNE+KON_BH_R
_Xakt := _Xa+KON_OHNE+KON_BH_R
;Änderung der Traversenposition wird durch rotes Rechteck angezeigt
ZRechteck (_Xakt-KON_OHNE-10,0,(KON_OHNE+10)*2,1500,0,987135,0,5,1,1)
Hinweismeldung ('Konsole: collision check changed position - Please check Result')
END
END
;#
IF ((K4=3)|(K4=5)|(K4=7))&((K5=7)|(K5=3))
IF _Xakt<_Xa+KON_OHNE+KON_BH_L
_Xakt := _Xa+KON_OHNE+KON_BH_L
;Änderung der Traversenposition wird durch rotes Rechteck angezeigt
ZRechteck (_Xakt-KON_OHNE-10,0,(KON_OHNE+10)*2,1500,0,987135,0,5,1,1)
Hinweismeldung ('Konsole: collision check changed position - Please check Result')
END
END
;#
IF ((K4=3)|(K4=5)|(K4=7))&((K5=4)|(K5=6))
IF _Xakt<_Xa+KON_OHNE+KON_A_L
_Xakt := _Xa+KON_OHNE+KON_A_L
;Änderung der Traversenposition wird durch rotes Rechteck angezeigt
ZRechteck (_Xakt-KON_OHNE-10,0,(KON_OHNE+10)*2,1500,0,987135,0,5,1,1)
Hinweismeldung ('Konsole: collision check changed position - Please check Result')
END
END
;#
IF ((K4=3)|(K4=5)|(K4=7))&((K5=2)|(K5=1)|(K5=5))
IF _Xakt<_Xa+KON_OHNE+KON_OHNE
_Xakt := _Xa+KON_OHNE+KON_OHNE
;Änderung der Traversenposition wird durch rotes Rechteck angezeigt
ZRechteck (_Xakt-KON_OHNE-10,0,(KON_OHNE+10)*2,1500,0,987135,0,5,1,1)
Hinweismeldung ('Konsole: collision check changed position - Please check Result')
END
END
;#
IF ((K4=4)|(K4=6))&((K5=3)|(K5=7))
IF _Xakt<_Xa+KON_A_R+KON_BH_L
_Xakt := _Xa+KON_A_R+KON_BH_L
;Änderung der Traversenposition wird durch rotes Rechteck angezeigt
ZRechteck (_Xakt-KON_OHNE-10,0,(KON_OHNE+10)*2,1500,0,987135,0,5,1,1)
Hinweismeldung ('Konsole: collision check changed position - Please check Result')
END
END
;#
IF ((K4=4))&((K5=4)|(K5=6))
IF _Xakt<_Xa+KON_A_R+KON_A_L
_Xakt := _Xa+KON_A_R+KON_A_L
;Änderung der Traversenposition wird durch rotes Rechteck angezeigt
ZRechteck (_Xakt-KON_OHNE-10,0,(KON_OHNE+10)*2,1500,0,987135,0,5,1,1)
Hinweismeldung ('Konsole: collision check changed position - Please check Result')
END
END
;#
IF ((K4=4))&((K5=2)|(K5=1)|(K5=5))
IF _Xakt<_Xa+KON_A_R+KON_OHNE
_Xakt := _Xa+KON_A_R+KON_OHNE
;Änderung der Traversenposition wird durch rotes Rechteck angezeigt
ZRechteck (_Xakt-KON_OHNE-10,0,(KON_OHNE+10)*2,1500,0,987135,0,5,1,1)
Hinweismeldung ('Konsole: collision check changed position - Please check Result')
END
END
;Ende Plausibilität
END
