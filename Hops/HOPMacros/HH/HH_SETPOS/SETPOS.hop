   X12 := 0;*VAR*Position Konsole 12
   Y1 := 0;*VAR*Sauger 1
   Y2 := 0;*VAR*Sauger 2
   Y3 := 0;*VAR*Sauger 3
   Y4 := 0;*VAR*Sauger 4
   Y5 := 0;*VAR*Sauger 5
   Y6 := 0;*VAR*Sauger 6
   Y7 := 0;*VAR*Sauger 7
