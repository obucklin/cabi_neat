VERXY (_Xakt,_Yakt)
CALL DrawMachineComponent ( VAL DX:=600,DY:=400,DZ:=19)
VERXYEND()
CALL _DrehenBBEnde ()
END
;Wenn nicht rotierbar, dann:
ELSE
;prüfen ob eingetragener Winkel 0 oder 180° ist
