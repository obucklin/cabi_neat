;Änderung der Saugerposition wird durch rotes Rechteck angezeigt
ZRechteck (_Xakt-KON_OHNE,_Yakt-_ZU,KON_OHNE*2,_ZU+_ZO,0,987135,0,5,1,1);BREAKPOINT
Hinweismeldung ('Clamp collision check changed position - Please check Result')
IF Zeichnen_Sauger=0
ZText ('Sauger 15',_Xakt,_Yakt+10,20,0,9,0,'Times New Roman',0,0,0,0,0,1)
END
END
END
IF _Ya>0
IF _Yakt<(_ZOalt+_Ya+_ZU)
_Yakt := _ZOalt+_Ya+_ZU
;Änderung der Saugerposition wird durch rotes Rechteck angezeigt
