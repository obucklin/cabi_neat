;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.5.6.109[Hops.exe]
;BILD=HH_PROBECALIBRATION.WMF
;INFO=
;WZGV=7735D_101
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=Probecalibration
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   MakePoket := 1;*VAR*Kreistasche fräsen - milling pocket
   ToolID := 3;*VAR*WerkzeugID für Kreistasche - tool ID for pocket
   Diameter := 80;*VAR*Durchmesser Kreistasche - Diameter for pocket
   Poketdepth := -7;*VAR*Tiefe Kreistasche - pocket depth
   Cal_Z := 1;*VAR*Kalibierung Z-Richtung - calibrate Z direction
   Cal_XY := 1;*VAR*Kalibierung XY-Richtung - calibrate XY direction
   strvar := '';
   Value := 0;
START
IF MakePoket=1
WZF (ToolID,_VE,_V,_VA,_SD,_ANF,'1')
CALL _Kreistasche_V5 ( VAL X_MITTE:=0,Y_MITTE:=0,RADIUS:=Diameter*0.5,TIEFE:=Poketdepth,ZUSTELLUNG:=0,AB:=2,ABF:=_ANF,INTERPOL:=0,UMKEHREN:=1,ESXY:=9,ESMD:=0,LASER:=0)
CALL HH_Machine_Stop ( VAL MSG:='Reinigen zum Vermessen - clean to calibrate',PARK:=3,X:=0,Y:=0)
ELSE
;Dummybearbeitung - Auflegen im Workcenter ohne Werkzeug geht nicht
WZF (9999,_VE,_V,_VA,_SD,_ANF,'1')
SP (0,0,0,0,0,_ANF,0,0,0,9,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (1,0,0,0,9,2)
EP (0,_ANF,0)
END
;Messtaster Kalibrierprogramm vorbereiten
strvar := 'L CYCLE [NAME=F_MEASCALI.NC @P1=180 @P2=9901'
Value := _RX*0.5
strvar := strvar + ' @P3=' + FLOATTOSTR(Value, 5, 1)
Value := _RY*0.5
strvar := strvar + ' @P4=' + FLOATTOSTR(Value, 5, 1)
Value := _RZ
strvar := strvar + ' @P5=' + FLOATTOSTR(Value,5, 1)
strvar := strvar + ' @P6=' + FLOATTOSTR(Diameter*0.5,5, 1)
Value := Poketdepth
strvar := strvar + ' @P7=' + FLOATTOSTR(Value,5, 1)
Value := 0
IF Cal_Z=1
Value := 1
END
IF Cal_XY=1
Value := Value + 2
END
strvar := strvar + ' @P8=' + INTTOSTR(Value)
strvar := strvar + ']'
NCIExt (80000,'HH7',2,0,0,-1,-1,-1,-1,-1,strvar,'','','','')
