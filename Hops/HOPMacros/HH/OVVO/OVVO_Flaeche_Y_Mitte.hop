;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.6.4.165[Hops.exe]
;BILD=OVVO_FLAECHE_Y_MITTE.WMF
;INFO=
;WZGV=7405_1030
;WZGVCONFIG=
;MASCHINE=SIMU
;NCNAME=OVVO_Flaeche_X_Mitte
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=HHDialogs_OVVO.Dll
;DIALOGPROC=ShowOVVO_FlaecheY
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   DX := 800;
   DY := 500;
   DZ := 19;
   WKZ_NUT := 1420;*VAR*FIX_WERKZEUGNUMMER DES NUTERS
   EITI := 12.9;*VAR*Eintauchtiefe des Werkzeuges 12.7 - 13.1
   APV_1 := 1;*VAR*Auswahl Position Verbinder oben links
   APV_2 := 1;*VAR*Auswahl Position Verbinder oben mitte
   APV_3 := 1;*VAR*Auswahl Position Verbinder oben rechts
   APV_4 := 1;*VAR*Auswahl Position Verbinder unten links
   APV_5 := 1;*VAR*Auswahl Position Verbinder unten mitte
   APV_6 := 1;*VAR*Auswahl Position Verbinder unten rechts
   PDV_X_1 := 60;*VAR*Position des Verbinder in X (oben links)
   PDV_X_2 := 0;*VAR*Position des Verbinder in X (oben mitte)
   PDV_X_3 := 60;*VAR*Position des Verbinder in X (oben rechts)
   PDV_X_4 := 60;*VAR*Position des Verbinder in X (unten links)
   PDV_X_5 := 0;*VAR*Position des Verbinder in X (unten mitte)
   PDV_X_6 := 60;*VAR*Position des Verbinder in X (unten rechts)
   PDV_Y_1 := DZ/2;*VAR*Position des Verbinders in Y (oben links)
   PDV_Y_2 := DZ/2;*VAR*Position des Verbinders in Y (oben mitte)
   PDV_Y_3 := DZ/2;*VAR*Position des Verbinders in Y (oben rechts)
   PDV_Y_4 := DZ/2;*VAR*Position des Verbinders in Y (unten rechts)
   PDV_Y_5 := DZ/2;*VAR*Position des Verbinders in Y (unten mitte)
   PDV_Y_6 := DZ/2;*VAR*Position des Verbinders in Y (unten rechts)
   DIST := 40;Travel Distance (ii)
   OVVO_TYP := 0;*VAR*0=1230 / 1=1240 / 2=free /3=free
START
;OVVO_30.10.2020 S.K INDEX 1.2
Fertigteil (DX,DY,DZ,0,0,0,0,0,'',0,0,0)
IF OVVO_TYP=0
DIST := 20.7
END
IF OVVO_TYP=1
DIST := 39.3
END
IF OVVO_TYP=2
/DIST := 20.7
Fehlermeldung ('_444_Not used, please Check the Makro settings')
END
IF OVVO_TYP=3
/DIST := 20.7
Fehlermeldung ('_445_Not used, please Check the Makro settings')
END
WZF (WKZ_NUT,_VE,_V,_VA,_SD,_ANF,'1')
;######################
;LINKS ################
;Checkbox 1 ( oben links)
IF APV_1=1
SP (PDV_X_1-(DIST/2),_ry-PDV_Y_1,-EITI,0,0,_ANF,0,0,0,0,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (DIST,0,0,0,10,2)
EP (0,_ANF,0)
END
;Checkbox 2 (oben mitte)
IF APV_2=1
SP (_RX/2+PDV_X_2-(DIST/2),_ry-PDV_Y_2,-EITI,0,0,_ANF,0,0,0,0,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (DIST,0,0,0,10,2)
EP (0,_ANF,0)
END
;Checkbox 3 (oben rechts)
IF APV_3=1
SP (_RX-PDV_X_3-(DIST/2),_ry-PDV_Y_3,-EITI,0,0,_ANF,0,0,0,0,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (DIST,0,0,0,10,2)
EP (0,_ANF,0)
END
;Checkbox 3 (unten rechts)
IF APV_4=1
SP (PDV_X_4-(DIST/2),PDV_Y_4,-EITI,0,0,_ANF,0,0,0,0,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (DIST,0,0,0,10,2)
EP (0,_ANF,0)
END
;Checkbox 5 (unten mitte)
IF APV_5=1
SP (_RX/2+PDV_X_5-(DIST/2),PDV_Y_5,-EITI,0,0,_ANF,0,0,0,0,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (DIST,0,0,0,10,2)
EP (0,_ANF,0)
END
;Checkbox 6 (unten rechts)
IF APV_6=1
SP (_RX-PDV_X_6-(DIST/2),PDV_Y_6,-EITI,0,0,_ANF,0,0,0,0,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (DIST,0,0,0,10,2)
EP (0,_ANF,0)
END
