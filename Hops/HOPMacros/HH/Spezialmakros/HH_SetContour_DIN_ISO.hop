;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.0.1.974[Hops.exe]
;BILD=HH_SETCONTOUR_DIN_ISO.BMP
;INFO=
;WZGV=7225K_470
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=HH_SetContour_DIN_ISO
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=HH_Keeppart.bmp
;DIMENSION_UNIT=0
VARS
   Bearbeitungsart := 0;*VAR*0-3=TopSolid||4-7=MasterCAM||8-11=IMOS||12-15=COMPAS||16-19=Sprutcam||20-23=madCAM||24-29=DDX
   Aktiv := 1;*VAR*
   Option := '';*VAR*
START
CALL OPTISTOP_V7 ( VAL TEXT:='')
/CALL Optimierungsstop ()
IF Aktiv=1
;TopSolid = Mode1
IF Bearbeitungsart=0
CALL _DINISO (VAL CODE:='#HSC [BSPLINE PATH_DEV=0.2 TRACK_DEV=5]')
CALL _DINISO (VAL CODE:='#SET SLOPE PROFIL[3]')
END
;TopSolid = 5x-Sweep
IF Bearbeitungsart=1
CALL _DINISO (VAL CODE:='#HSC [BSPLINE PATH_DEV=0.2 TRACK_DEV=5]')
CALL _DINISO (VAL CODE:='#SET SLOPE PROFIL[3]')
END
;TopSolid = 5x-Abrollen / 5x-Kontur
IF Bearbeitungsart=2
CALL _DINISO (VAL CODE:='#HSC [BSPLINE PATH_DEV=0.2 TRACK_DEV=5]')
CALL _DINISO (VAL CODE:='#SET SLOPE PROFIL[3]')
END
;TopSolid = Schruppen / Planfräsen - Ungenau / hohe Dynamik
IF Bearbeitungsart=3
CALL _DINISO (VAL CODE:='#HSC [BSPLINE PATH_DEV=0.2 TRACK_DEV=5]')
CALL _DINISO ( VAL CODE:='#SET SLOPE PROFIL[3]')
END
;MasterCam = Schlichten 1 (Kugelfraeser Flaeche)
IF Bearbeitungsart=4
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=0,CON_ACCEL:=100,CON_JERK:=100,CON_CHECK:=0,CON_METHODE:=2,CON_QUALITY:=2,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;MasterCam = Schruppen 1(Vorzerspanen 5 Achs) Stellachse
IF Bearbeitungsart=5
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=2,CON_ACCEL:=120,CON_JERK:=80,CON_CHECK:=0,CON_METHODE:=1,CON_QUALITY:=3,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;MasterCam = Schruppen 2 (Vorzerspanen 1)
IF Bearbeitungsart=6
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=2,CON_ACCEL:=120,CON_JERK:=80,CON_CHECK:=0,CON_METHODE:=2,CON_QUALITY:=2,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;MasterCam = Schlichten 5 Achs
IF Bearbeitungsart=7
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=2,CON_ACCEL:=120,CON_JERK:=80,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=5,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;IMOS = 3 Achs_GROB
IF Bearbeitungsart=8
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=2,CON_ACCEL:=120,CON_JERK:=80,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=100,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;IMOS = 3/4/5 Achs_FEIN
IF Bearbeitungsart=9
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=1,CON_ACCEL:=110,CON_JERK:=90,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=20,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;IMOS = 5 Achs_FEIN
IF Bearbeitungsart=10
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=2,CON_ACCEL:=120,CON_JERK:=80,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=5,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;IMOS = Standard
IF Bearbeitungsart=11
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=0,CON_ACCEL:=100,CON_JERK:=100,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=1,CON_ASYMETRIC:=0,CON_SETTING:=0)
END
;COMPAS = Mode1_Schruppen
IF Bearbeitungsart=12
CALL HH_SetContourV2_NoDialog ( VAL CON_PROFIL:=2,CON_ACCEL:=100,CON_JERK:=50,CON_METHODE:=13,CON_QUALITY:=100,CON_SETTING:=2,CON_PARA4:=30,CON_PARA5:=4)
END
;COMPAS = Mode2_grob_Schlichten
;COMPAS = 3Achs Kontur
IF Bearbeitungsart=13
CALL HH_SetContourV2_NoDialog ( VAL CON_PROFIL:=2,CON_ACCEL:=150,CON_JERK:=50,CON_METHODE:=13,CON_QUALITY:=10,CON_SETTING:=2,CON_PARA4:=30,CON_PARA5:=0)
END
;COMPAS = Mode3_fein_Schlichten_Horitaschen
IF Bearbeitungsart=14
CALL HH_SetContourV2_NoDialog ( VAL CON_PROFIL:=2,CON_ACCEL:=80,CON_JERK:=120,CON_METHODE:=13,CON_QUALITY:=10,CON_SETTING:=2,CON_PARA4:=5,CON_PARA5:=4)
/CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=-2,CON_ACCEL:=80,CON_JERK:=120,CON_CHECK:=0,CON_METHODE:=13,CON_QUALITY:=10,CON_ASYMETRIC:=0,CON_SETTING:=2,CON_PARA4:=4,CON_PARA5:=5)
END
;COMPAS = Mode4_Spezial_Surface
IF Bearbeitungsart=15
CALL HH_SetContourV2_NoDialog ( VAL CON_PROFIL:=2,CON_ACCEL:=80,CON_JERK:=120,CON_METHODE:=12,CON_QUALITY:=1,CON_SETTING:=2,CON_PARA4:=5,CON_PARA5:=4)
/CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=0,CON_ACCEL:=100,CON_JERK:=100,CON_CHECK:=0,CON_METHODE:=12,CON_QUALITY:=1,CON_ASYMETRIC:=0,CON_SETTING:=2,CON_PARA4:=5,CON_PARA5:=4)
END
;Sprutcam= Mode1
IF Bearbeitungsart=16
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=2,CON_ACCEL:=120,CON_JERK:=80,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=100,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;Sprutcam = Mode2
IF Bearbeitungsart=17
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=1,CON_ACCEL:=110,CON_JERK:=90,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=20,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;Sprutcam = Mode3
IF Bearbeitungsart=18
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=2,CON_ACCEL:=120,CON_JERK:=80,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=5,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;Sprutcam = Mode4
IF Bearbeitungsart=19
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=0,CON_ACCEL:=100,CON_JERK:=100,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=1,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;madCAM = Mode1
IF Bearbeitungsart=20
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=2,CON_ACCEL:=120,CON_JERK:=80,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=100,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;madCAM = Mode2
IF Bearbeitungsart=21
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=1,CON_ACCEL:=110,CON_JERK:=90,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=20,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;madCAM = Mode3
IF Bearbeitungsart=22
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=2,CON_ACCEL:=120,CON_JERK:=80,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=5,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;madCAM = Mode4
IF Bearbeitungsart=23
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=0,CON_ACCEL:=100,CON_JERK:=100,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=1,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;DDX = Standard
IF Bearbeitungsart=24
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=1,CON_ACCEL:=110,CON_JERK:=90,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=15,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;DDX = Schnell
IF Bearbeitungsart=25
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=1,CON_ACCEL:=110,CON_JERK:=90,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=15,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;DDX = Kanten und Radien
IF Bearbeitungsart=26
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=1,CON_ACCEL:=110,CON_JERK:=90,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=15,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;DDX = Tangenzen
IF Bearbeitungsart=27
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=1,CON_ACCEL:=110,CON_JERK:=90,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=15,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;DDX = Hohe Genauigkeit
IF Bearbeitungsart=28
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=1,CON_ACCEL:=110,CON_JERK:=90,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=15,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;DDX = Hohe Geschwindigkeit
IF Bearbeitungsart=29
CALL HH_SetContourV2_on ( VAL CON_PROFIL:=2,CON_DYNLEVEL:=1,CON_ACCEL:=110,CON_JERK:=90,CON_CHECK:=0,CON_METHODE:=10,CON_QUALITY:=15,CON_ASYMETRIC:=0,CON_SETTING:=2)
END
;Konturglättung deaktivieren
ELSE
CALL _DINISO ( VAL CODE:='$IF V.G.HSC_ACTIVE==1')
CALL _DINISO ( VAL CODE:='#HSC OFF')
CALL _DINISO ( VAL CODE:='$ENDIF')
CALL _DINISO (VAL CODE:='#SET SLOPE PROFIL')
CALL HH_SetContourV2_off ()
END
