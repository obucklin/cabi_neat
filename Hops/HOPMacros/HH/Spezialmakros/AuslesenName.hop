;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.0.2.65[Hops.exe]
;BILD=AUSLESENNAME.WMF
;INFO=
;WZGV=7225K_522
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=AuslesenName
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   StrLen := 0;Länge des Pfads
   Name := '';Name Pfad
   _SubStr := '';Name des Programm
START
;Auslesen Programm Name
Name := _ACT_MACRO_NAME
StrLen := STRLENGTH(Name)
_SubStr := STRCOPY(Name,61,(StrLen-61-3))
WZF (9999,_VE,_V,_VA,_SD,_ANF,'1')
/CALL _ExecuteText_V5 ( VAL TEXT:=_SubStr,HEIGHT:=35,CHARSPACE:=0,FONTNAME:='Arial',FONTSTYLE:=0,ALIGN_H:=1,ALIGN_V:=0,MIRRORINVERTED:=0,ALIGNMENTAT:=0,PX:=0,PY:=20,ESXYP:=9,SX:=0,SY:=0,ESXYSP:=0,EX:=0,EY:=0,ESXYEP:=0,ANGLE:=0,LENGTH:=0,LINETYPE:=0,MX:=0,MY:=0,ESXYMP:=0,RADIUS:=0,SANGLE:=0,EANGLE:=0,ROT_DIR:=0,TOLERANCE:=0.8,MILLMODE:=1,TIEFE:=-2,ESMD:=0,MAXZ:=_AT_MAXDEPTH,ANZAHL:=0,POCKETAA:=0,POCKETUEBERLAPPUNG:=67,POCKETMODE:=0,POCKETANGLE:=0,POCKETRD:=0,POCKETFLIEGENDEINTAUCHEN:=0,POCKETMAXEINTAUCHLAENGE:=20,RKBART:=0,PARA1:=0,PARA2:=0,PARA3:=0)
;Werkstückmaße
CALL _ExecuteText_V5 ( VAL TEXT:=INTTOSTR(_RX) +'x' +INTTOSTR(_RY),HEIGHT:=35,CHARSPACE:=0,FONTNAME:='Arial',FONTSTYLE:=0,ALIGN_H:=1,ALIGN_V:=0,MIRRORINVERTED:=0,ALIGNMENTAT:=0,PX:=0,PY:=-20,ESXYP:=9,SX:=0,SY:=0,ESXYSP:=0,EX:=0,EY:=0,ESXYEP:=0,ANGLE:=0,LENGTH:=0,LINETYPE:=0,MX:=0,MY:=0,ESXYMP:=0,RADIUS:=0,SANGLE:=0,EANGLE:=0,ROT_DIR:=0,TOLERANCE:=0.8,MILLMODE:=1,TIEFE:=-2,ESMD:=0,MAXZ:=_AT_MAXDEPTH,ANZAHL:=0,POCKETAA:=0,POCKETUEBERLAPPUNG:=67,POCKETMODE:=0,POCKETANGLE:=0,POCKETRD:=0,POCKETFLIEGENDEINTAUCHEN:=0,POCKETMAXEINTAUCHLAENGE:=20,RKBART:=0,PARA1:=0,PARA2:=0,PARA3:=0)
