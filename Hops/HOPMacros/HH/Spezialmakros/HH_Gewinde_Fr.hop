;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.7.12.80[Hops.exe]
;BILD=HH_GEWINDE_FR.WMF
;INFO=
;WZGV=7225K_SCHULUNG
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=HH_Gewinde_Fr
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0
;DIALOGDLL=DialogBA_2.Dll
;DIALOGPROC=Show_Gewinde_Fraesen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   DX := 600;Dimension X
   DY := 400;Dimension Y
   DZ := 19;Dimension Z
   M_X :=10;*VAR*Mittelpunkt in X
   M_Y :=60;*VAR*Mittelpunkt in Y
   Tiefe :=-15;*VAR*Gewinde Tiefe
   Typ :=0;*VAR*Gewinde Typ / Rechts oder Links
   Gewinde_DM :=4;*VAR*Gewinde DM 0=3/1=4/2=5/3=6/4=8/5=10/6=12/7=14/8=16
   VorBohren :=0;*VAR*Vohrbohren Ja/Nein
   VB_Typ :=10;*VAR*Werkzeugtyp Vohrbohren
   VB_Speed :=3000;*VAR*Vorschub Vohrbohren
   VB_Tiefe :=-15;*VAR*Tiefe Vohrbohren
   Kern_DM :=6,75;*VAR*Kerndurchmesser bei Vohrbohren Ja
   SnapXY :=124;*VAR*Kerndurchmesser bei Vohrbohren Ja
   G_Wkz_ID := 113;*VAR*Gewinde Wkz ID
   VB_Wkz_ID :=501;*VAR*Vorbohren Wkz ID
   Steigung := 1.25;*VAR*Gewinde Steigung
   Drehzahl :=8000;*VAR*Drehzahl
   Speed :=5000;*VAR*Vorschub in mm pro Min.
   SenkTiefe :=18,4;*VAR*Senktiefe
   Material :=0;*VAR*Material 0= Holz/1= Alu
   Vor1 := Speed / 2;Gewindevorschub
   GDM := 0.00;GewindeDM
   ZusT := 5;Zustellung bei ALU
   Snap_Z :=0;*VAR*Easy Snap in Z
   Drehung :=0;*VAR*Drehung der Ebene
   Neigung :=0;*VAR*Neigung der Ebene
   Hoehe_Z :=0;*VAR*Höhe in Z
START
Fertigteil (DX,DY,DZ,0,0,0,0,0,'',0,0,0)
IF Material=0
;Holz
Vor1 := Speed
ELSE
;Alu
Vor1 := Speed / 2
END
IF Gewinde_Dm=0
GDM := 3
END
IF Gewinde_Dm=1
GDM := 4
END
IF Gewinde_Dm=2
GDM := 5
END
IF Gewinde_Dm=3
GDM := 6
END
IF Gewinde_Dm=4
GDM := 8
END
IF Gewinde_Dm=5
GDM := 10
END
IF Gewinde_Dm=6
GDM := 12
END
IF Gewinde_Dm=7
GDM := 14
END
IF Gewinde_Dm=8
GDM := 16
END
;Fehlermeldung wenn Drehung und Neigung <> 0
IF (Drehung <> 0) | (Neigung <> 0) | (Hoehe_Z <> 0)| (Snap_Z = 1)
Fehlermeldung ('Not used (Drehung <> 0) | (Neigung <> 0) | (Hoehe_Z <> 0)| (Snap_Z = 1) ')
EXITMACRO
END
;HB Optik ein
WZF (9999,_VE,_V,_VA,_SD,_ANF,'1')
CALL _Kreisbahn_V5 ( VAL X_MITTE:=m_x,Y_MITTE:=m_y,TIEFE:=Tiefe,ZUTIEFE:=Tiefe/2,RADIUS:=Kern_DM/2,RADIUSKORREKTUR:=1,AB:=0,AUFMASS:=0,BEARB_UMKEHREN:=0,WINKEL:=360,ANF:=1,ABF:=1,RAMPE:=1,INTERPOL:=1,ESXY:=0,ESMD:=0,LASER:=0)
;HB Optik aus
ZKBCCW (M_X,M_Y,M_X- GDM,M_Y,M_X - GDM,M_Y,8388863,SnapXY,SnapXY,SnapXY)
ZText ('M' + FloatToStr((GDM),1,0),M_X,M_Y,20,0,1,0,'Arial',0,0,0,0,0)
IF Vorbohren = -1;BREAKPOINT
CALL GROUPSTART_V7 ( VAL NAME:='HH_Gewinde_Fr_1')
WZB (VB_Wkz_ID,_VE,VB_Speed,_VA,_SD,_ANF,'1')
Bohrung (M_X,M_Y,Kern_DM,VB_Tiefe,VB_Typ,0,0,0,0,0,0,0)
CALL GROUPEND_V7 ( VAL NAME:='HH_Gewinde_Fr_1')
END
CALL GROUPSTART_V7 ( VAL NAME:='HH_Gewinde_Fr_2')
WZF (G_Wkz_ID,_VE,_V,_VA,Drehzahl,_ANF,'1')
;Rechtsgewinde mit EMUGE Gewindefräser
IF Typ=0;BREAKPOINT
IF Material = 0
;Holz
CALL PROCESS_NCI_77710 ( VAL TC:=1,SPEED:=1,VC:=1,LIFTPOS:=0,X1:=M_X,Y1:=M_Y,Z1:=0,X2:=M_X,Y2:=M_Y,Z2:=0,STR1:='',STR2:='')
CALL _DINISO ( VAL CODE:='G90 G01  Z' + FloatToStr(Tiefe,5,3) + ' F' + FloatToStr(Vor1,5,0))
CALL _DINISO ( VAL CODE:='G04 X0.5')
CALL _DINISO ( VAL CODE:='G01 G91 Z' + FloatToStr((Steigung / 3),5,3))
CALL _DINISO ( VAL CODE:='G41 X' + FloatToStr(-(Kern_Dm/2),5,3) + ' Y0 F' + FloatToStr(Vor1,5,3))
CALL _DINISO ( VAL CODE:='G03 X' + FloatToStr(((GDM + Kern_Dm) / 2),5,3) + ' Y0  Z' + FloatToStr((Steigung / 2),5,3) + ' I' + FloatToStr(((GDM + Kern_DM)/4),5,3) + ' J0')
CALL _DINISO ( VAL CODE:='G03 X0 Y0 Z' +FloatToStr(Steigung,5,3) + ' I-' + FloatToStr((GDM / 2),5,3) + ' J0')
CALL _DINISO ( VAL CODE:='G03 X-' + FloatToStr(((GDM + Kern_DM) / 2),5,3) + ' Y0 Z' + FloatToStr((Steigung / 2),5,3) + ' I-' + FloatToStr(((GDM + Kern_DM)/4),5,3) + ' J0')
CALL _DINISO ( VAL CODE:='G00 G40 X' +FloatToStr((Kern_DM / 2),5,3) + ' Y0')
CALL _DINISO ( VAL CODE:='G90 Z5')
END
IF Material = 1
;Alu
CALL PROCESS_NCI_77710 ( VAL TC:=1,SPEED:=1,VC:=1,LIFTPOS:=0,X1:=M_X,Y1:=M_Y,Z1:=0,X2:=M_X,Y2:=M_Y,Z2:=0,STR1:='',STR2:='')
ZusT := 0
WHILE abs(ZusT)  <  abs(Tiefe)
ZusT := (ZusT + 5)
IF abs(Zust) > abs(Tiefe)
;Auf Endtiefe bohren
CALL _DINISO ( VAL CODE:='G90 G01 Z' + FloatToStr((Tiefe),5,3) + ' F' + FloatToStr(Speed,5,0))
ELSE
CALL _DINISO ( VAL CODE:='G90 G01 Z' + FloatToStr((ZusT * -1),5,3) + ' F' + FloatToStr(Speed,5,0))
CALL _DINISO ( VAL CODE:='G90 G01 Z5 F5000')
END
END
CALL _DINISO ( VAL CODE:='G04 X0.5')
CALL _DINISO ( VAL CODE:='G01 G91 Z' + FloatToStr((Steigung / 3),5,3))
CALL _DINISO ( VAL CODE:='G41 X' + FloatToStr(-(Kern_Dm/2),5,3) + 'Y0 F' + FloatToStr(Vor1,5,3))
CALL _DINISO ( VAL CODE:='G03 X' + FloatToStr(((GDM + Kern_Dm) / 2),5,3) + ' Y0 Z' + FloatToStr((Steigung / 2),5,3) + ' I' + FloatToStr(((GDM + Kern_DM)/4),5,3) + ' J0')
CALL _DINISO ( VAL CODE:='G03 X0 Y0 Z' +FloatToStr(Steigung,5,3) + ' I-' + FloatToStr((GDM / 2),5,3) + ' J0')
CALL _DINISO ( VAL CODE:='G03 X-' + FloatToStr(((GDM + Kern_DM) / 2),5,3) + ' Y0 Z' + FloatToStr((Steigung / 2),5,3) + ' I-' + FloatToStr(((GDM + Kern_DM)/4),5,3) + ' J0')
CALL _DINISO ( VAL CODE:='G00 G40 X' +FloatToStr((Kern_DM / 2),5,3) + ' Y0')
CALL _DINISO ( VAL CODE:='G90 Z5')
END
ELSE
;Linksgewinde mit EMUGE Gewindefräser
IF Material = 0
;Holz
CALL PROCESS_NCI_77710 ( VAL TC:=1,SPEED:=1,VC:=1,LIFTPOS:=0,X1:=M_X,Y1:=M_Y,Z1:=0,X2:=M_X,Y2:=M_Y,Z2:=0,STR1:='',STR2:='')
CALL _DINISO ( VAL CODE:='G90 G01 Z' + FloatToStr(Tiefe,5,3) + ' F' + FloatToStr(Vor1,5,0))
CALL _DINISO ( VAL CODE:='G04 X0.5')
CALL _DINISO ( VAL CODE:='G01 G91 Z' + FloatToStr((Steigung / 3),5,3))
CALL _DINISO ( VAL CODE:='G41 X' + FloatToStr((Kern_Dm/2),5,3) + ' Y0 F' + FloatToStr(Vor1,5,3))
CALL _DINISO ( VAL CODE:='G03 X-' + FloatToStr(((GDM + Kern_Dm) / 2),5,3) + ' Y0 Z' + FloatToStr((Steigung / 2),5,3) + ' I-' + FloatToStr(((GDM + Kern_DM)/4),5,3) + ' J0')
CALL _DINISO ( VAL CODE:='G03 X0 Y0 Z' +FloatToStr(Steigung,5,3) + ' I' + FloatToStr((GDM / 2),5,3) + ' J0')
CALL _DINISO ( VAL CODE:='G03 X' + FloatToStr(((GDM + Kern_DM) / 2),5,3) + ' Y0 Z' + FloatToStr((Steigung / 2),5,3) + ' I' + FloatToStr(((GDM + Kern_DM)/4),5,3) + ' J0')
CALL _DINISO ( VAL CODE:='G00 G40 X-' +FloatToStr((Kern_DM / 2),5,3) + ' Y0')
CALL _DINISO ( VAL CODE:='G90 Z5')
END
IF Material = 1
;Alu
CALL PROCESS_NCI_77710 ( VAL TC:=1,SPEED:=1,VC:=1,LIFTPOS:=0,X1:=M_X,Y1:=M_Y,Z1:=0,X2:=M_X,Y2:=M_Y,Z2:=0,STR1:='',STR2:='')
ZusT := 0
WHILE abs(ZusT)  <  abs(Tiefe)
ZusT := (ZusT + 5)
IF abs(Zust) > abs(Tiefe)
;Auf Endtiefe bohren
CALL _DINISO ( VAL CODE:='G90 G01 Z' + FloatToStr((Tiefe),5,3) + ' F' + FloatToStr(Vor1,5,0))
ELSE
CALL _DINISO ( VAL CODE:='G90 G01 Z' + FloatToStr((ZusT * -1),5,3) + ' F' + FloatToStr(Vor1,5,0))
CALL _DINISO ( VAL CODE:='G90 G01 Z2 F5000')
END
END
CALL _DINISO ( VAL CODE:='G04 X0.5')
CALL _DINISO ( VAL CODE:='G01 G91 Z' + FloatToStr((Steigung /3),5,3))
CALL _DINISO ( VAL CODE:='G42 X' + FloatToStr(-(Kern_Dm/2),5,3) + ' F' + FloatToStr(Vor1,5,3))
CALL _DINISO ( VAL CODE:='G02 X' + FloatToStr(((GDM + Kern_Dm) / 2),5,3) + ' Y0 Z-' + FloatToStr((Steigung / 2),5,3) + ' I' + FloatToStr(((GDM + Kern_DM)/4),5,3) + ' J0')
CALL _DINISO ( VAL CODE:='G02 X0 Y0 Z-' +FloatToStr(Steigung,5,3) + ' I-' + FloatToStr((GDM / 2),5,3) + ' J0')
CALL _DINISO ( VAL CODE:='G02 X-' + FloatToStr(((GDM + Kern_DM) / 2),5,3) + ' Y0 Z-' + FloatToStr((Steigung / 2),5,3) + ' I-' + FloatToStr(((GDM + Kern_DM)/4),5,3) + ' J0')
CALL _DINISO ( VAL CODE:='G00 G40 X' +FloatToStr((Kern_DM / 2),5,3) + ' Y0')
CALL _DINISO ( VAL CODE:='G90 Z2')
END
END
CALL GROUPEND_V7 ( VAL NAME:='HH_Gewinde_Fr_2')
