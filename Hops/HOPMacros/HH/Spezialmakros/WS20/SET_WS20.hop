CALL WS20_A ( VAL X_POS_CLAMP:=XPOS_A1,EINSPANN_Y_1:=YPOS_A1)
IF TEXT=1
WZF (9999,_VE,_V,_VA,_SD,_ANF,'110')
CALL _ExecuteText_V5 ( VAL TEXT:='A1',HEIGHT:=50,CHARSPACE:=0,FONTNAME:='Arial',FONTSTYLE:=0,ALIGN_H:=1,ALIGN_V:=0,MIRRORINVERTED:=0,ALIGNMENTAT:=0,PX:=XPOS_A1,PY:=-350,ESXYP:=7,SX:=0,SY:=0,ESXYSP:=0,EX:=0,EY:=0,ESXYEP:=0,ANGLE:=0,LENGTH:=0,LINETYPE:=0,MX:=0,MY:=0,ESXYMP:=0,RADIUS:=0,SANGLE:=0,EANGLE:=0,ROT_DIR:=0,TOLERANCE:=0.8,MILLMODE:=1,TIEFE:=-2,ESMD:=0,MAXZ:=_AT_MAXDEPTH,ANZAHL:=0,POCKETAA:=0,POCKETUEBERLAPPUNG:=67,POCKETMODE:=0,POCKETANGLE:=0,POCKETRD:=0,POCKETFLIEGENDEINTAUCHEN:=0,POCKETMAXEINTAUCHLAENGE:=20,RKBART:=0,PARA1:=0,PARA2:=0,PARA3:=0)
