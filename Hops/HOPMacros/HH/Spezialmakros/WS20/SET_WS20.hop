;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.7.12.80[Hops.exe]
;BILD=SET_WS20.WMF
;INFO=
;WZGV=7225K_606
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=SET_WS20
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0
;DIALOGDLL=WS20.Dll
;DIALOGPROC=ShowWS20_Funktion
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   XPOS_A1 := 200;*VAR*X-POS KonsoleA1
   XPOS_A2 := 600;*VAR*X-POS KonsoleA2
   XPOS_A3 := 1000;*VAR*X-POS KonsoleA3
   XPOS_A4 := 1400;*VAR*X-POS KonsoleA4
   XPOS_A5 := 1800;*VAR*X-POS KonsoleA5
   XPOS_A6 := 2200;*VAR*X-POS KonsoleA6
   XPOS_D1 := 200;*VAR*X-POS KonsoleD1
   XPOS_D2 := 600;*VAR*X-POS KonsoleD2
   XPOS_D3 := 1000;*VAR*X-POS KonsoleD3
   XPOS_D4 := 1400;*VAR*X-POS KonsoleD4
   XPOS_D5 := 1400;*VAR*X-POS KonsoleD5
   XPOS_D6 := DX-2600;*VAR*X-POS KonsoleD6
   YPOS_A1 := 20;*VAR*Y Einspannung A1
   YPOS_A2 := 20;*VAR*Y Einspannung A2
   YPOS_A3 := 20;*VAR*Y Einspannung A3
   YPOS_A4 := 20;*VAR*Y Einspannung A4
   YPOS_A5 := 20;*VAR*Y Einspannung A5
   YPOS_A6 := 20;*VAR*Y Einspannung A6
   YPOS_D1 := 20;*VAR*Y Einspannung D1
   YPOS_D2 := 20;*VAR*Y Einspannung D2
   YPOS_D3 := 20;*VAR*Y Einspannung D3
   YPOS_D4 := 20;*VAR*Y Einspannung D4
   YPOS_D5 := 20;*VAR*Y Einspannung D5
   YPOS_D6 := 20;*VAR*Y Einspannung D6
   SHOWA1 := 0;*VAR*Sichtbar A1
   SHOWA2 := 0;*VAR*Sichtbar A2
   SHOWA3 := 0;*VAR*Sichtbar A3
   SHOWA4 := 0;*VAR*Sichtbar A4
   SHOWA5 := 0;*VAR*Sichtbar A5
   SHOWA6 := 0;*VAR*Sichtbar A6
   SHOWD1 := 1;*VAR*Sichtbar D1
   SHOWD2 := 1;*VAR*Sichtbar D2
   SHOWD3 := 1;*VAR*Sichtbar D3
   SHOWD4 := 0;*VAR*Sichtbar D4
   SHOWD5 := 0;*VAR*Sichtbar D5
   SHOWD6 := 0;*VAR*Sichtbar D6
   TEXT := 0;Show Text Trav_ID
   Count_Konsole := 0;*VAR*Anzahl Konsolen / 0=6 / 1=8 / 2=10 / 3=12
   _Global_Count := -999;
   Max_Y := 39;Max Einspannung
   X_Abstand_min := 255;Minimaler Abstand in X Richtung
START
;Abfrage max Y Wert
IF (YPOS_A1>Max_Y)|(YPOS_A2>Max_Y)|(YPOS_A3>Max_Y)|(YPOS_A4>Max_Y)|(YPOS_A5>Max_Y)|(YPOS_A6>Max_Y)
Fehlermeldung ('Y Wert Feld A prüfen')
EXITMACRO
ELSE
IF (YPOS_D6>Max_Y)|(YPOS_D5>Max_Y)|(YPOS_D4>Max_Y)|(YPOS_D3>Max_Y)|(YPOS_D2>Max_Y)|(YPOS_D1>Max_Y)
Fehlermeldung ('Y Wert Feld D prüfen')
EXITMACRO
ELSE
;Definition welche ID die Feld D Traversen bekommen
IF Count_Konsole=0
_Global_Count := 3
END
IF Count_Konsole=1
_Global_Count := 4
END
IF Count_Konsole=2
_Global_Count := 5
END
IF Count_Konsole=3
_Global_Count := 6
END
;FELD A Standard
