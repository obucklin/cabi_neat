;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.5.6.109[Hops.exe]
;BILD=HH_TRCCHECK.WMF
;INFO=
;WZGV=7735D_101
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=HH_TRCCheck
;KOMMENTAR=
;DX=0.000
;DY=0.000
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   CON_CHECK_DEACTIVE := 0;*VAR*Contourcheck deaktiv
   CON_CIR_TO_LIN := 0;*VAR*Circular to linear aktiv
   CON_KERF_MASK := 0;*VAR*Kerf masking aktiv
   CON_REVERSE := 0;*VAR*Reverse aktiv
   CON_IGNORE_DAMAGE := 0;*VAR*Ignore Contour damage aktiv
START
IF _HOPSVERSION=7
CALL OPTISTOP_V7 ( VAL TEXT:='')
IF CON_CHECK_DEACTIVE=1
IF CON_CIR_TO_LIN=1
NCIExt (70000,'HH7',1,0,1,10,0,0,0,0,'#TRC [CONV_CIR_TO_LIN=1]');BREAKPOINT
Hinweismeldung ('#TRC [CONV_CIR_TO_LIN=1]')
ELSE
NCIExt (70000,'HH7',1,0,1,10,0,0,0,0,'#TRC [CONV_CIR_TO_LIN=0]')
Hinweismeldung ('#TRC [CONV_CIR_TO_LIN=0]')
END
IF CON_KERF_MASK=1
NCIExt (70000,'HH7',1,0,1,10,0,0,0,0,'#TRC [KERF_MASKING=1]')
Hinweismeldung ('#TRC [KERF_MASKING=1]')
ELSE
NCIExt (70000,'HH7',1,0,1,10,0,0,0,0,'#TRC [KERF_MASKING=0]')
Hinweismeldung ('#TRC [KERF_MASKING=0]')
END
IF CON_REVERSE=1
NCIExt (70000,'HH7',1,0,1,10,0,0,0,0,'#TRC [REVERSE=1]')
Hinweismeldung ('#TRC [REVERSE=1]')
ELSE
NCIExt (70000,'HH7',1,0,1,10,0,0,0,0,'#TRC [REVERSE=0]')
Hinweismeldung ('#TRC [REVERSE=0]')
END
IF CON_IGNORE_DAMAGE=1
NCIExt (70000,'HH7',1,0,1,10,0,0,0,0,'#TRC [IGNORE_CONT_DAMAGE=1]')
Hinweismeldung ('#TRC [IGNORE_CONT_DAMAGE=1]')
ELSE
NCIExt (70000,'HH7',1,0,1,10,0,0,0,0,'#TRC [IGNORE_CONT_DAMAGE=0]')
Hinweismeldung ('#TRC [IGNORE_CONT_DAMAGE=0]')
END
NCIExt (70000,'HH7',1,0,1,10,0,0,0,0,'G141')
Hinweismeldung ('G141')
ELSE
NCIExt (70000,'HH7',1,0,1,10,0,0,0,0,'G140')
Hinweismeldung ('G140')
END
ELSE
CALL Optimierungsstop ()
IF CON_CHECK_DEACTIVE=1
IF CON_CIR_TO_LIN=1
NCINFO (200,0,0,0,0,0,0,'#TRC [CONV_CIR_TO_LIN=1]',0,0,0)
ELSE
NCINFO (200,0,0,0,0,0,0,'#TRC [CONV_CIR_TO_LIN=0]',0,0,0)
END
IF CON_KERF_MASK=1
NCINFO (200,0,0,0,0,0,0,'#TRC [KERF_MASKING=1]',0,0,0)
ELSE
NCINFO (200,0,0,0,0,0,0,'#TRC [KERF_MASKING=0]',0,0,0)
END
IF CON_REVERSE=1
NCINFO (200,0,0,0,0,0,0,'#TRC [REVERSE=1]',0,0,0)
ELSE
NCINFO (200,0,0,0,0,0,0,'#TRC [REVERSE=0]',0,0,0)
END
IF CON_IGNORE_DAMAGE=1
NCINFO (200,0,0,0,0,0,0,'#TRC [IGNORE_CONT_DAMAGE=1]',0,0,0)
ELSE
NCINFO (200,0,0,0,0,0,0,'#TRC [IGNORE_CONT_DAMAGE=0]',0,0,0)
END
NCINFO (200,0,0,0,0,0,0,'G141',0,0,0)
ELSE
NCINFO (200,0,0,0,0,0,0,'G140',0,0,0)
END
END
