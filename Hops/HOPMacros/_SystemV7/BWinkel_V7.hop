;MAKROTYP=1
;DIALOGDLL=DialogsHopSys.Dll
;DIALOGPROC=ShowBWinkel_V7Dialog
;AUTOSCRIPTSTART=0
VARS
   P1X := 100;*VAR*Punkt1 X Wert
   P1Y := 0;*VAR*Punkt1 Y Wert
   P2X := 0;*VAR*Punkt2 X Wert
   P2Y := 100;*VAR*Punkt2 Y Wert
   MX := 0;*VAR*Mittelpunkt in X
   MY := 0;*VAR*Mittelpunkt in Y
   Abstand := -100;*VAR*Abstand der Bemaßung
   AbstandBem := 15;*VAR*Additiver Abstand
   Farbe := 0;*VAR*
   Text := '';*VAR*Text zum überschreiben
   TextHoehe := 20;*VAR*Texthöhe
   Pfeillaenge := 30mm;*VAR*
   PfeileInnerhalb := 0;*VAR*Bemaßungspfeile innerhalb
   WCS := 1;*VAR*Workcenter sichtbar
   _AktDimValue := 0;
   L2 := 0;
   L1 := 0;
   V1XN := 0;
   V1YN := 0;
   V2XN := 0;
   V2YN := 0;
   V1X := 0;
   V1Y := 0;
   V2X := 0;
   V2Y := 0;
   TPX := 0;
   TPY := 0;
   LTP := 0;
   WinkelBem := 0;
   WinkelDiff := 0;
   EndPos1X := 0;
   EndPos1Y := 0;
   EndPos2X := 0;
   EndPos2Y := 0;
   HilfsLinienL := Pfeillaenge;
   L := 0;
   Pfeilwinkel := 15;
   esxy1 := 0;*VAR*
   esxy2 := 0;*VAR*
   esxy3 := 0;*VAR*
START
;DIRECT CNC SYSTEME NCHOPS Version 7.x
transesxy (P1x,P1y,esxy1,0)
transesxy (P2x,P2y,esxy2,0)
transesxy (Mx,My,esxy3,0)
Rohteil (1000,2000,19,0,0)
L1 := sqrt(sqr(MX-P1X)+sqr(MY-P1Y))
L2 := sqrt(sqr(MX-P2X)+sqr(MY-P2Y))
HilfsLinienL := Pfeillaenge*2
Pfeillaenge := abs(Pfeillaenge)
IF (L1<>0)&(L2<>0)
IF Abstand<0
Abstand := -Abstand
END
V1X := -MX+P1X
V1Y := -MY+P1Y
V2X := -MX+P2X
V2Y := -MY+P2Y
V1XN := V1X/L1
V1YN := V1Y/L1
V2XN := V2X/L2
V2YN := V2Y/L2
V1X := Abstand*V1XN
V1Y := Abstand*V1YN
V2X := Abstand*V2XN
V2Y := Abstand*V2YN
IF PfeileInnerhalb
CALL Pfeil_V7 ( VAL P1X:=MX+V1X,P1Y:=MY+V1Y,P2X:=MX+V1X-V1Y,P2Y:=MY+V1Y+V1X,LÄNGE:=Pfeillaenge,FARBE:=Farbe,PFEILWINKEL:=Pfeilwinkel,WCS:=WCS)
CALL Pfeil_V7 ( VAL P1X:=MX+V2X,P1Y:=MY+V2Y,P2X:=MX+V2X+V2Y,P2Y:=MY+V2Y-V2X,LÄNGE:=Pfeillaenge,FARBE:=Farbe,PFEILWINKEL:=Pfeilwinkel,WCS:=WCS)
ZKBCCW (MX,MY,MX+V1X,MY+V1Y,MX+V2X,MY+V2Y,Farbe,0,0,0,0,0,WCS)
ELSE
CALL Pfeil_V7 ( VAL P1X:=MX+V1X,P1Y:=MY+V1Y,P2X:=MX+V1X+V1Y,P2Y:=MY+V1Y-V1X,LÄNGE:=Pfeillaenge,FARBE:=Farbe,PFEILWINKEL:=Pfeilwinkel,WCS:=WCS)
CALL Pfeil_V7 ( VAL P1X:=MX+V2X,P1Y:=MY+V2Y,P2X:=MX+V2X-V2Y,P2Y:=MY+V2Y+V2X,LÄNGE:=Pfeillaenge,FARBE:=Farbe,PFEILWINKEL:=Pfeilwinkel,WCS:=WCS)
ZKBCCW (MX,MY,MX+V1X,MY+V1Y,MX+V2X,MY+V2Y,Farbe,0,0,0,0,0,WCS)
CALL Dist2P_V4 (REF Dist:=L VAL P1X:=0,P1Y:=0,P2X:=V1Y,P2Y:=V1X)
ZLinie (MX+V1X,MY+V1Y,MX+V1X+V1Y*(HilfsLinienL/L),MY+V1Y-V1X*(HilfsLinienL/L),Farbe,0,0,0,0,WCS)
CALL Dist2P_V4 (REF Dist:=L VAL P1X:=0,P1Y:=0,P2X:=V2Y,P2Y:=V2X)
ZLinie (MX+V2X,MY+V2Y,MX+V2X-V2Y*(HilfsLinienL/L),MY+V2Y+V2X*(HilfsLinienL/L),Farbe,0,0,0,0,WCS)
END
ZLinie (MX,MY,MX+V1X + (V1XN*Pfeillaenge/3),MY+V1Y + (V1YN*Pfeillaenge/3),Farbe,0,0,1,0,WCS)
ZLinie (MX,MY,MX+V2X + (V2XN*Pfeillaenge/3),MY+V2Y + (V2YN*Pfeillaenge/3),Farbe,0,0,0,0,WCS)
;Winkel berechnen
CALL GetWinkelDiff3P_V4 (REF WinkelDiff3P:=WinkelDiff VAL P1X:=P1X,P1Y:=P1Y,MX:=MX,MY:=MY,P3X:=P2X,P3Y:=P2Y)
IF StrLength(Text)=0
CALL FloatToStr_V4 (REF StrWert:=Text VAL Wert:=WinkelDiff)
_AktDimValue := WinkelDiff
Text := Text+'°'
END
;Text einfügen
V1X := V1XN+V2XN
V1Y := V1YN+V2YN
IF WinkelDiff>180
V1X := -V1X
V1Y := -V1Y
END
LTP := sqrt(sqr(V1X)+sqr(V1Y))
IF LTP>0
V1XN := V1X/LTP
V1YN := V1Y/LTP
ELSE
V1X := -MX+P1X
V1Y := -MY+P1Y
V1XN := -V1Y/L1
V1YN := V1X/L1
END
TPX := MX+(AbstandBem+Abstand)*V1XN
TPY := MY+(AbstandBem+Abstand)*V1YN
;Winkel berechnen für Textausrichtung
CALL GetWinkel2P_V4 (REF Winkel2P:=WinkelBem VAL P1X:=MX,P1Y:=MY,P2X:=TPX,P2Y:=TPY)
IF ((WinkelBem>180)&(WinkelBem<=360))
WinkelBem := WinkelBem-90
WinkelBem := WinkelBem+180
ELSE
IF (WinkelBem=0)
IF V1XN<0
WinkelBem := WinkelBem-90
ELSE
WinkelBem := WinkelBem+90
END
ELSE
WinkelBem := WinkelBem-90
END
END
ZText (Text,TPX,TPY,Texthoehe,WinkelBem,9,Farbe,'',0,0,0,0,0,WCS)
END
