;MAKROTYP=0
;INSTVERSION=
;EXEVERSION=7.5.4.618[Hops.exe]
;BILD=OPENPOCKET_GEOFINISH.WMF
;INFO=18138609
;WZGV=THEUNS_HUELLHORST
;WZGVCONFIG=
;MASCHINE=THEUNS_HUELLHORST
;NCNAME=OpenPocket_GeoFinish
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=Dialoge.Dll
;DIALOGPROC=StandardFormAnzeigen
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   DX := 800;Dimension X
   DY := 600;Dimension Y
   DZ := 38;Dimension Z
   K := 'Pocket1';*VAR*Konturname
   Ecke := 7;*VAR*0=LU / 1=U / 2=RU.......
   Dim_X := 200;*VAR*Länge in X
   Dim_Y := 300;*VAR*Länge in Y
   Rad := 50;*VAR*Radius
   PosX := 400;*VAR*Positiion in X
   PosY := 200;*VAR*Positiion in Y
   Dist := 0;
START
;--------------------------------------------------------------------------------------------
;- direkt cnc systeme NC-HOPS (Version 7.5.5.x)
;--------------------------------------------------------------------------------------------
Fertigteil (DX,DY,DZ,0,0,0,0,0,'',0,0,0,0)
;--------------------------------------------------------------------------------------------
;- Rectangel pocket open
;- 0 = LU
;- 1 = U
;- 2 = RU
;- 3 = R
;- 4 = RO
;- 5 = O
;- 6 = LO
;- 7 = L
;--------------------------------------------------------------------------------------------
IF Rad>0
IF (Rad > Dim_X) | (Rad > Dim_Y)
Rad := 0
END
END
;--------------------------------------------------------------------------------------------
;- Geometry
IF Ecke=0
;- Edge LU
KB (K,'',Dim_X,0,0,'',1,0)
KG01 ('',Dim_X,Dim_Y,0,'',1,2)
IF Rad>0
KVerrundung ('',0,Rad,'',2)
END
KG01 ('',0,Dim_Y,0,'',1,2)
END
;-
IF Ecke=1
;- U
KB (K,'',PosX + Dim_X/2,0,0,'',1,0)
KG01 ('',_X,Dim_Y,0,'',1,2)
IF Rad>0
KVerrundung ('',0,Rad,'',2)
END
KG01 ('',PosX - Dim_X/2,Dim_Y,0,'',1,2)
IF Rad>0
KVerrundung ('',0,Rad,'',2)
END
KG01 ('',PosX - Dim_X/2,0,0,'',1,2)
END
;-
IF Ecke=2
;- Edge RU
KB (K,'',0,Dim_Y,0,'',3,0)
KG01 ('',Dim_X,Dim_Y,0,'',3,2)
IF Rad>0
KVerrundung ('',0,Rad,'',2)
END
KG01 ('',Dim_X,0,0,'',3,2)
END
;-
IF Ecke=3
;- R
KB (K,'',0,PosY + Dim_Y/2,0,'',3,0)
KG01 ('',Dim_X,_Y,0,'',3,2)
IF Rad>0
KVerrundung ('',0,Rad,'',2)
END
KG01 ('',Dim_X,PosY - Dim_Y/2,0,'',3,2)
IF Rad>0
KVerrundung ('',0,Rad,'',2)
END
KG01 ('',0,PosY - Dim_Y/2,0,'',3,2)
END
;-
IF Ecke=4
;- Edge RO
KB (K,'',Dim_X,0,0,'',5,0)
KG01 ('',Dim_X,Dim_Y,0,'',5,2)
IF Rad>0
KVerrundung ('',0,Rad,'',2)
END
KG01 ('',0,Dim_Y,0,'',5,2)
END
;-
IF Ecke=5
;- O
KB (K,'',PosX - Dim_X/2,0,0,'',7,0)
KG01 ('',_X,Dim_Y,0,'',7,2)
IF Rad>0
KVerrundung ('',0,Rad,'',2)
END
KG01 ('',PosX + Dim_X/2,Dim_Y,0,'',7,2)
IF Rad>0
KVerrundung ('',0,Rad,'',2)
END
KG01 ('',PosX + Dim_X/2,0,0,'',7,2)
END
;-
IF Ecke=6
;- Edge LO
KB (K,'',0,Dim_Y,0,'',7,0)
KG01 ('',Dim_X,Dim_Y,0,'',7,2)
IF Rad>0
KVerrundung ('',0,Rad,'',2)
END
KG01 ('',Dim_X,0,0,'',7,2)
END
;-
IF Ecke=7
;- L
KB (K,'',0,PosY - Dim_Y/2,0,'',1,0)
KG01 ('',Dim_X,_Y,0,'',1,2)
IF Rad>0
KVerrundung ('',0,Rad,'',2)
END
KG01 ('',Dim_X,PosY + Dim_Y/2,0,'',1,2)
IF Rad>0
KVerrundung ('',0,Rad,'',2)
END
KG01 ('',0,PosY + Dim_Y/2,0,'',1,2)
END
