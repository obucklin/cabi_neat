;MAKROTYP=1
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowPointPosContourDialog
;AUTOSCRIPTSTART=0
VARS
   CONTOURNAME_CONTOURNAME := '';*VAR*
   X := 0;*VAR*
   Y := 0;*VAR*
   Pos := 0;*VAR**REF*
START
;Punkt in Kontur über DLL
CALLDLL POINTINCONTOURPARSEREXTCONTOURS (Extensions,DefaultStr,REF POS:=Pos VAL CONTOURNAME_CONTOURNAME:=CONTOURNAME_CONTOURNAME,X:=X,Y:=Y)
