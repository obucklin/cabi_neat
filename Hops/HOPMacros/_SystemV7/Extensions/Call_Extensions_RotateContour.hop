;MAKROTYP=1
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowROTATESINGLEPARSEREXTCONTOURSDialog
;AUTOSCRIPTSTART=0
VARS
   CONTOURNAME_CONTOURNAME := '';*VAR*
   NewContourName := '';*VAR*
   NewContourInfo := '';*VAR*
   NewContourLayer := '';*VAR*
   cx := 0;*VAR*
   cy := 0;*VAR*
   Angle := 0;*VAR*
START
;Rotate Kontur über DLL
CALLDLL ROTATESINGLEPARSEREXTCONTOURS(Extensions,DefaultStr,REF CX:=cx,CY:=cy,ANGLE:=Angle VAL CONTOURNAME_CONTOURNAME:=CONTOURNAME_CONTOURNAME,NEWCONTOURNAME:=NewContourName,NEWCONTOURINFO:=NewContourInfo,NEWCONTOURLAYER:=NewContourLayer)
