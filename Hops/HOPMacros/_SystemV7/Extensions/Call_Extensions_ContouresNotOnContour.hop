;MAKROTYP=1
;AUTOSCRIPTSTART=0
VARS
   CONTOURNAME_FPContourname := '';*VAR*
   CONTOURNAME_CONTOURNAME := '';*VAR*
   ContourName := '';*VAR*
   ContourInfo := '';*VAR*
   ContourLayer := '';*VAR*
   MaxTol := 0.0001;*VAR*
   Count := 0;*VAR**REF*
START
CALLDLL GETCONTOURSNOTONCONTOURPARSEREXTCONTOURS(Extensions,DefaultStr,REF COUNT:=Count VAL CONTOURNAME_FPCONTOURNAME:=CONTOURNAME_FPContourname,CONTOURNAME_CONTOURNAME:=CONTOURNAME_CONTOURNAME,CONTOURNAME:=ContourName,CONTOURINFO:=ContourInfo,CONTOURLAYER:=ContourLayer,MAXTOL:=MaxTol)
