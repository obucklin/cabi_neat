;MAKROTYP=1
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowLINKPARSEREXTCONTOURSDialog
;AUTOSCRIPTSTART=0
VARS
   CONTOURNAME_CONTOURNAMES := '';*VAR*
   NewContourName := '';*VAR*
   NewContourInfo := '';*VAR*
   NewContourLayer := '';*VAR*
   Auto := 1;*VAR*
START
;Konturen aneinanderhängen über DLL
CALLDLL LINKPARSEREXTCONTOURS(Extensions,DefaultStr, VAL CONTOURNAME_CONTOURNAMES:=CONTOURNAME_CONTOURNAMES,NEWCONTOURNAME:=NewContourName,NEWCONTOURINFO:=NewContourInfo,NEWCONTOURLAYER:=NewContourLayer,AUTO:=Auto)
