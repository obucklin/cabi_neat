;MAKROTYP=1
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowVIEW2ABSOLUTCONTOURPARSEREXTCONTOURSDialog
;AUTOSCRIPTSTART=0
VARS
   CONTOURNAME_CONTOURNAME := '';*VAR*
   NewContourName := '';*VAR*
   NewContourInfo := '';*VAR*
   NewContourLayer := '';*VAR*
   Tol := 0.1mm;*VAR*
   Vx := 0;*VAR*
   Vy := 0;*VAR*
   Vz := 0;*VAR*
   RA := 0;*VAR*
   TA := 0;*VAR*
START
CALLDLL VIEW2ABSOLUTCONTOURPARSEREXTCONTOURS(Extensions,DefaultStr, VAL CONTOURNAME_CONTOURNAME:=CONTOURNAME_CONTOURNAME,NEWCONTOURNAME:=NewContourName,NEWCONTOURINFO:=NewContourInfo,NEWCONTOURLAYER:=NewContourLayer,TOL:=Tol,VX:=Vx,VY:=Vy,VZ:=Vz,RA:=RA,TA:=TA)
