;MAKROTYP=1
;AUTOSCRIPTSTART=0
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowGRAVITYPARSEREXTCONTOURSDialog
VARS
   CONTOURNAME_CONTOURNAME := '';*VAR*
   SX := ;*VAR**REF*
   SY := ;*VAR**REF*
   Closed := 0;
   x1 := 0;
   y1 := 0;
   z1 := 0;
   x2 := 0;
   y2 := 0;
   z2 := 0;
   Tol := 0.00001;
START
;Schwerpunkt Konturen über DLL
x1 := GETCP_X(CONTOURNAME_CONTOURNAME,0)
y1 := GETCP_Y(CONTOURNAME_CONTOURNAME,0)
z1 := GETCP_Z(CONTOURNAME_CONTOURNAME,0)
x2 := GETCP_X(CONTOURNAME_CONTOURNAME,GETCE_COUNT(CONTOURNAME_CONTOURNAME))
y2 := GETCP_Y(CONTOURNAME_CONTOURNAME,GETCE_COUNT(CONTOURNAME_CONTOURNAME))
z2 := GETCP_Z(CONTOURNAME_CONTOURNAME,GETCE_COUNT(CONTOURNAME_CONTOURNAME))
Closed := (abs(x1-x2)<Tol) & (abs(y1-y2)<Tol) & (abs(z1-z2)<Tol)
IF Closed
CALLDLL GRAVITYPARSEREXTCONTOURS(Extensions,DefaultStr,REF SX:=SX,SY:=SY VAL CONTOURNAME_CONTOURNAME:=CONTOURNAME_CONTOURNAME)
ELSE
Fehlermeldung (GETMESSAGETEXT('48','Kontur ist nicht geschlossen'))
END
