;MAKROTYP=1
;AUTOSCRIPTSTART=0
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowROTATEPARSEREXTCONTOURSDialog
VARS
   CONTOURNAME_CONTOURNAMES := '';*VAR*
   CONTOURNAME := '';*VAR*
   cx := 0;*VAR*
   cy := 0;*VAR*
   Angle := 0;*VAR*
START
;Rotate Konturen über DLL
CALLDLL ROTATEPARSEREXTCONTOURS(Extensions,DefaultStr,REF CX:=cx,CY:=cy,ANGLE:=Angle VAL CONTOURNAME_CONTOURNAMES:=CONTOURNAME_CONTOURNAMES,CONTOURNAME:=CONTOURNAME)
