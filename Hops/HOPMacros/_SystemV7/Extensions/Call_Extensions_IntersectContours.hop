;MAKROTYP=1
;AUTOSCRIPTSTART=0
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowINTERSECTCONTOURSPARSEREXTCONTOURSDialog
VARS
   CONTOURNAME_CONTOURNAMES := '';*VAR*
   CONTOURNAME_INTERSECTCONTOURNAME := '';*VAR*
   ContourName := '';*VAR*
   ContourInfo := '';*VAR*
   ContourLayer := '';*VAR*
   IndexStart := -9999;*VAR*
   IndexEnd := 9999;*VAR*
   ArcWithTangLines := 0;*VAR*
   CutEle := 0;*VAR*
START
;Konturen scheiden über DLL
CALLDLL INTERSECTCONTOURSPARSEREXTCONTOURS(Extensions,DefaultStr, VAL CONTOURNAME_CONTOURNAMES:=CONTOURNAME_CONTOURNAMES,CONTOURNAME_INTERSECTCONTOURNAME:=CONTOURNAME_INTERSECTCONTOURNAME,CONTOURNAME:=ContourName,CONTOURINFO:=ContourInfo,CONTOURLAYER:=ContourLayer,INDEXSTART:=IndexStart,INDEXEND:=IndexEnd,ARCWITHTANGLINES:=ArcWithTangLines,CutEle:=CutEle)
        
