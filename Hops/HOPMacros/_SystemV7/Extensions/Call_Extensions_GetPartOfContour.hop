;MAKROTYP=1
;AUTOSCRIPTSTART=0
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowGETPARTOFCONTOURPARSEREXTCONTOURSDialog
VARS
   CONTOURNAME_CONTOURNAMES := '';*VAR*
   ContourName := '';*VAR*
   ContourInfo := '';*VAR*
   ContourLayer := '';*VAR*
   IndexStart := -9999;*VAR*
   IndexEnd := 9999;*VAR*
START
;Teilkontur teilen über DLL
CALLDLL GETPARTOFCONTOURPARSEREXTCONTOURS(Extensions,DefaultStr, VAL CONTOURNAME_CONTOURNAMES:=CONTOURNAME_CONTOURNAMES,CONTOURNAME:=ContourName,CONTOURINFO:=ContourInfo,CONTOURLAYER:=ContourLayer,INDEXSTART:=IndexStart,INDEXEND:=IndexEnd)
