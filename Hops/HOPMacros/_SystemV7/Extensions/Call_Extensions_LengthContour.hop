;MAKROTYP=1
;AUTOSCRIPTSTART=0
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowCONTOURLENGTHPARSEREXTCONTOURSDialog
VARS
   CONTOURNAME_CONTOURNAME := '';*VAR*
   IndexStart := -9999;*VAR*
   IndexEnd := 9999;*VAR*
   ContourLength := ;*VAR**REF*
START
;Length Konturen über DLL
CALLDLL CONTOURLENGTHPARSEREXTCONTOURS(Extensions,DefaultStr,REF CONTOURLENGTH:=ContourLength VAL CONTOURNAME_CONTOURNAME:=CONTOURNAME_CONTOURNAME,INDEXSTART:=IndexStart,INDEXEND:=IndexEnd)
