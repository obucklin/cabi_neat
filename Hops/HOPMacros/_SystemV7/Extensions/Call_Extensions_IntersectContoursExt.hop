;MAKROTYP=1
;AUTOSCRIPTSTART=0
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowINTERSECTCONTOURSEXTPARSEREXTCONTOURSDialog
VARS
   CONTOURNAME_CONTOURNAMES := '';*VAR*
   CONTOURNAME_INTERSECTCONTOURNAME := '';*VAR*
   ContourName := '';*VAR*
   ContourInfo := '';*VAR*
   ContourLayer := '';*VAR*
   IndexStart := -9999;*VAR*
   IndexEnd := 9999;*VAR*
   Offset := 0;*VAR*
   ExtraLength := 0;*VAR*
   MaxLength := 0;*VAR*
START
;Konturen scheiden über DLL
CALLDLL INTERSECTCONTOURSEXTPARSEREXTCONTOURS(Extensions,DefaultStr, VAL CONTOURNAME_CONTOURNAMES:=CONTOURNAME_CONTOURNAMES,CONTOURNAME_INTERSECTCONTOURNAME:=CONTOURNAME_INTERSECTCONTOURNAME,CONTOURNAME:=ContourName,CONTOURINFO:=ContourInfo,CONTOURLAYER:=ContourLayer,INDEXSTART:=IndexStart,INDEXEND:=IndexEnd,OFFSET:=Offset,EXTRALENGTH:=ExtraLength,MAXLENGTH:=MaxLength)
