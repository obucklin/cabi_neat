;MAKROTYP=1
;DIALOGDLL=DialogsHopSys.Dll
;DIALOGPROC=ShowB2Punkte_V7Dialog
;AUTOSCRIPTSTART=0
VARS
   P1X := 0;*VAR*Punkt1 X Wert
   P1Y := 0;*VAR*Punkt1 Y Wert
   P2X := 100;*VAR*Punkt2 X Wert
   P2Y := 0;*VAR*Punkt2 Y Wert
   Abstand := -120;*VAR*Abstand der Bemaßung
   Farbe := 0;*VAR*Farbe der Bemaßung
   Text := '';*VAR*Text zum überschreiben
   TextHoehe := 20;*VAR*Texthöhe
   Pfeillaenge := 30mm;*VAR*Länge des Bemaßungspfeils
   PfeileInnerhalb := 0;*VAR*Bemaßungspfeile innerhalb
   WCS := 1;*VAR*Workcenter sichtbar
   _AktDimValue := 0;
   dx := 0;
   dy := 0;
   dxn := 0;
   dyn := 0;
   w := 0;
   Dist := 0;
   dxHilf := 0;
   dyHilf := 0;
   HilfsLinienL := Pfeillaenge*2;
   Pfeilwinkel := 10;
   PfeilBreite := 0;
   dyPfeil := 0;
   dxPfeil := 0;
   esxy1 := 0;*VAR*
   esxy2 := 0;*VAR*
   vorzeichen := 1;
START
;DIRECT CNC SYSTEME NCHOPS Version 7.x
Rohteil (1000,400,19,0,0)
transesxy (P1x,P1y,esxy1,0)
transesxy (P2x,P2y,esxy2,0)
HilfsLinienL := Pfeillaenge*2
IF (P1X=P2X)&(P1Y=P2Y)
Fehlermeldung (GetMessageText('1','Bitte 2 Punkte eintragen'))
END
dx := P2X-P1X
dy := P2Y-P1Y
dx := (round(dx*1000))/1000
dy := (round(dy*1000))/1000
Pfeillaenge := abs(Pfeillaenge)
IF (dx<>0) | (dy<>0)
CALL Dist2P_V4 (REF Dist:=Dist VAL P1X:=P1X,P1Y:=P1Y,P2X:=P2X,P2Y:=P2Y)
PfeilBreite := tan(Pfeilwinkel)*Pfeillaenge
dxn := Abstand*(dy/Dist)
dyn := -Abstand*(dx/Dist)
IF Abstand<>0
vorzeichen := abs(Abstand)/Abstand
END
dxPfeil := vorzeichen*Pfeilbreite*(dy/Dist)
dyPfeil := -vorzeichen*Pfeilbreite*(dx/Dist)
ZLinie (P1X,P1Y,P1X+dxn+dxPfeil,P1Y+dyn+dyPfeil,Farbe,0,0,0,0,WCS)
ZLinie (P2X,P2Y,P2X+dxn+dxPfeil,P2Y+dyn+dyPfeil,Farbe,0,0,0,0,WCS)
IF PfeileInnerhalb
CALL Pfeil_V7 ( VAL P1X:=P1X+dxn,P1Y:=P1Y+dyn,P2X:=P2X+dxn,P2Y:=P2Y+dyn,LÄNGE:=Pfeillaenge,FARBE:=Farbe,PFEILWINKEL:=Pfeilwinkel,WCS:=WCS)
CALL Pfeil_V7 ( VAL P1X:=P2X+dxn,P1Y:=P2Y+dyn,P2X:=P1X+dxn,P2Y:=P1Y+dyn,LÄNGE:=Pfeillaenge,FARBE:=Farbe,PFEILWINKEL:=Pfeilwinkel,WCS:=WCS)
ZLinie (P1X+dxn,P1Y+dyn,P2X+dxn,P2Y+dyn,Farbe,0,0,0,0,WCS)
ELSE
dxHilf := HilfsLinienL*dx/Dist
dyHilf := HilfsLinienL*dy/Dist
CALL Pfeil_V7 ( VAL P1X:=P1X+dxn,P1Y:=P1Y+dyn,P2X:=P1X-dx+dxn,P2Y:=P1Y-dy+dyn,LÄNGE:=Pfeillaenge,FARBE:=Farbe,PFEILWINKEL:=Pfeilwinkel,WCS:=WCS)
CALL Pfeil_V7 ( VAL P1X:=P2X+dxn,P1Y:=P2Y+dyn,P2X:=P2X+dx+dxn,P2Y:=P2Y+dy+dyn,LÄNGE:=Pfeillaenge,FARBE:=Farbe,PFEILWINKEL:=Pfeilwinkel,WCS:=WCS)
ZLinie (P1X+dxn,P1Y+dyn,P2X+dxn,P2Y+dyn,Farbe,0,0,0,0,WCS)
ZLinie (P1X+dxn,P1Y+dyn,P1X+dxn-dxHilf,P1Y+dyn-dyHilf,Farbe,0,0,0,0,WCS)
ZLinie (P2X+dxn,P2Y+dyn,P2X+dxn+dxHilf,P2Y+dyn+dyHilf,Farbe,0,0,0,0,WCS)
END
END
IF StrLength(Text)=0
CALL FloatToStr_V4 (REF StrWert:=Text VAL Wert:=Dist)
_AktDimValue := Dist
END
IF dx <> 0
w := arctan(dy/dx)
ELSE
w := 90
END
IF (dyn<0)|((dyn=0)&(dxn>0))
w := w+180
END
IF (w>90.01) & (w<=270)
w := w-180
Abstand := Abstand*0.9
dxn := Abstand*(dy/Dist)
dyn := -Abstand*(dx/Dist)
ELSE
Abstand := Abstand*1.1
dxn := Abstand*(dy/Dist)
dyn := -Abstand*(dx/Dist)
END
ZText (Text,p2x+dxn-dx/2,p2y+dyn-dy/2,Texthoehe,w,8,Farbe,'',0,0,0,0,0,WCS)
END
