;MAKROTYP=1
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowGetArcDWDialog
;AUTOSCRIPTSTART=0
VARS
   SX := 0;*VAR*
   SY := 0;*VAR*
   EX := 0;*VAR*
   EY := 0;*VAR*
   MX := 0;*VAR*
   MY := 0;*VAR*
   GTyp := 2;*VAR*
   DW := ;*VAR**REF*
START
IF GTyp=3
CALL GetWinkelDiff3P_V4 (REF WINKELDIFF3P:=DW VAL P1X:=SX,P1Y:=SY,MX:=MX,MY:=MY,P3X:=EX,P3Y:=EY)
ELSE
CALL GetWinkelDiff3P_V4 (REF WINKELDIFF3P:=DW VAL P1X:=EX,P1Y:=EY,MX:=MX,MY:=MY,P3X:=SX,P3Y:=SY)
END
