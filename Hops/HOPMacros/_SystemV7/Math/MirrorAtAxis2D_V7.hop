;MAKROTYP=1
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowMirrorAtAxis2D_V7Dialog
;AUTOSCRIPTSTART=0
VARS
   P1X := ;*VAR**REF*
   P1Y := ;*VAR**REF*
   x1 := 10;*VAR*
   y1 := 0;*VAR*
   x2 := 110;*VAR*
   y2 := 100;*VAR*
   DW := 0;
START
P1X := -P1X
CALL GetWinkel2P_V7 (REF WINKEL2P:=DW VAL P1X:=x1,P1Y:=y1,P2X:=x2,P2Y:=y2)
CALL MovePoint2D_V7 (REF P1X:=P1X,P1Y:=P1Y VAL FACTOR:=1,VX:=-x1,VY:=-y1)
CALL RotPoint00 (REF PX:=P1X,PY:=P1Y VAL W:=DW)
CALL MirrorAtXAxis2D_V7 (REF P1X:=P1X,P1Y:=P1Y)
CALL RotPoint00 (REF PX:=P1X,PY:=P1Y VAL W:=-DW)
CALL MovePoint2D_V7 (REF P1X:=P1X,P1Y:=P1Y VAL FACTOR:=1,VX:=x1,VY:=y1)
