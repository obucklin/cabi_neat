;MAKROTYP=1
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowGetMedPoint3D_V7Dialog
VARS
   x1 := 0;*VAR*
   y1 := 0;*VAR*
   z1 := 0;*VAR*
   x2 := 0;*VAR*
   y2 := 0;*VAR*
   z2 := 0;*VAR*
   mx := ;*VAR**REF*
   my := ;*VAR**REF*
   mz := ;*VAR**REF*
START
mx := (x1 + x2) / 2
my := (y1 + y2) / 2
mz := (z1 + z2) / 2
