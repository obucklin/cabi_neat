;MAKROTYP=1
;DIALOGDLL=DialogsHopSys_2.Dll
;DIALOGPROC=ShowUmZAchseRotieren_V7Dialog
;AUTOSCRIPTSTART=0
VARS
   x := ;*VAR**REF*X-Wert des Normalenvektors
   y := ;*VAR**REF*Y-Wert des Normalenvektors
   z := ;*VAR**REF*Z-Wert des Normalenvektors
   DW := 45;*VAR*
   x1 := 0;
   y1 := 0;
START
x1 := x*cos(DW)-y*sin(DW)
y1 := x*sin(DW)+y*cos(DW)
x := x1
y := y1
