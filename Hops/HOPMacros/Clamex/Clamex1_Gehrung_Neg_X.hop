;MAKROTYP=1
;INSTVERSION=6.4.0.4
;EXEVERSION=6.6.2.165[Hops.exe]
;BILD=Clamex1_Gehrung_Neg_X.wmf
;INFO=
;WZGV=7225K_138
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=Clamex1_Gehrung_Neg_X
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=DialogBA_7.Dll
;DIALOGPROC=ShowTClamex_Neg_X_GehrungDialog
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   DX := 600;Dimension X
   DY := 400;Dimension Y
   DZ := 19;Dimension Z
   F_Tool :=1108;*VAR*Clamex WKZ
   B_Tool :=112;*VAR*Clamex Bohrer
   Bohren_H :=-1;*VAR*Bohren hinten ja/nein
   Bohren_V :=-1;*VAR*Bohren vorne ja/nein
   CL_BoPos :=7.5;*VAR*Bohrposition
   B_Dm :=6.8;*VAR*Bohr DMz
   Winkel_H :=45;*VAR*Winkel hinten
   Winkel_V :=45;*VAR*Winkel vorne
   X1 :=60.00;*VAR*X_Wert Li hinten
   Y1 :=00.00;*VAR*Y_Wert Li hinten
   X2 :=00.00;*VAR*X_Wert Hi mitte
   Y2 :=00.00;*VAR*Y_Wert Hi mitte
   X3 :=60.00;*VAR*X_Wert Re hinten
   Y3 :=00.00;*VAR*Y_Wert Re hinten
   X4 :=60.00;*VAR*X_Wert Li vorne
   Y4 :=00.00;*VAR*Y_Wert Li vorne
   X5 :=00.00;*VAR*X_Wert Vo mitte
   Y5 :=00.00;*VAR*Y_Wert Vo mitte
   X6 :=60.00;*VAR*X_Wert Re vorne
   Y6 :=00.00;*VAR*Y_Wert Re vorne
   C1 :=-1;*VAR*Clamex links hinten
   C2 :=-1;*VAR*Clamex hinten mitte
   C3 :=-1;*VAR*Clamex hinten rechts
   C4 :=-1;*VAR*Clamex vorne links
   C5 :=-1;*VAR*Clamex vorne mitte
   C6 :=-1;*VAR*Clamex rechts vorne
   C_Tiefe :=15.00;*VAR*Tiefe je nach Clamex Typ
   CL_Typ :=0;*VAR*Clamex Typ
   Pos1 := 0;*VAR*Pos des Clamex in Z
   Pos2 := 0;*VAR*Dummy
   Dreh_W_H :=0;*VAR*Drehwinkel hinten
   Dreh_W_V :=0;*VAR*Drehwinkel vorne
   Ref_XH :=0.00;*VAR*Ref. für Drehwinkel hinten
   Ref_XV :=0.00;*VAR*Ref. für Drehwinkel vorne
   Hoehe := _Eh_RZ;Hohe in der Ebene
   T := 110 - _Wzr;
   PL_Dicke := _Rz;Plattendicke
   Bo_Diff := 0;Korrektur des Bohrabstandes
   Bo_Tiefe := 0;Bohrtiefe
START
Fertigteil (DX,DY,DZ,0,0,0,0,0,'',0,0,0)
;++++++++++++++++++++++++++++++++++++++++++++
Pl_Dicke := _Rz
CALL Clamex_Par (REF POS1:=Pos1,POS2:=Pos2 VAL WINKEL:=Winkel_H,DICKE:=Pl_Dicke)
Winkel_H := 90 -Winkel_H
;Bohren
WZB (B_Tool,_VE,_V,_VA,_SD,_ANF,'1')
EbeneF (0,Y1,0,90- Winkel_H,-180,7,0)
Hoehe := _EH_Rz - Pos1
IF _AT_USEABLELENGTH < Hoehe
Hinweismeldung (GetMessageTextOem('51','Wkz zu kurz!! Loch muss nachgebohrt werden'))
Bo_Tiefe := _AT_USEABLELENGTH
ELSE
Bo_Tiefe := Hoehe
END
EbeneF (Ref_XH,Y1,_Rz,Winkel_H,- 180 - Dreh_W_H,7,0)
;Links hinten
IF (C1= -1) & (Bohren_H= -1)
Bohrung (X1,-CL_BoPos + Bo_Diff,B_DM,-Bo_Tiefe,10,0,0,5,0,0,0,0);BREAKPOINT
END
;Hinten mitte
IF (C2= -1) & (Bohren_H = -1)
Bohrung (X2 * -1,-CL_BoPos + Bo_Diff,B_DM,-Bo_Tiefe,10,0,0,6,0,0,0,0)
END
;Hinten rechts
IF (C3= -1) & (Bohren_H= -1)
Bohrung (X3,-CL_BoPos + Bo_Diff,B_DM,-Bo_Tiefe,10,0,0,7,0,0,0,0)
END
CALL Clamex_Par (REF POS1:=Pos1,POS2:=Pos2 VAL WINKEL:=Winkel_V,DICKE:=PL_Dicke)
Winkel_V := Winkel_V
EbeneF (0,Y4,0,Winkel_V,0,1,0)
Hoehe := _EH_Rz -Pos1
IF _AT_USEABLELENGTH < Hoehe
Hinweismeldung (GetMessageTextOem('51','Wkz zu kurz!! Loch muss nachgebohrt werden'))
Bo_Tiefe := _AT_USEABLELENGTH
ELSE
Bo_Tiefe := Hoehe
END
EbeneF (Ref_XV,Y4,_Rz,90-Winkel_V,0 + Dreh_W_V,1,0);BREAKPOINT
;Vorne rechts
IF (C4= -1) & (Bohren_V= -1)
Bohrung (X4,-(CL_BoPos +Bo_Diff),B_DM,-Bo_Tiefe,10,0,0,7,0,0,0,0)
END
;Vorne mitte
IF (C5= -1) & (Bohren_V= -1)
Bohrung (X5,-(CL_BoPos + Bo_Diff),B_DM,-Bo_Tiefe,10,0,0,6,0,0,0,0)
END
;Vorne rechts
IF (C6= -1) & (Bohren_V = -1)
Bohrung (X6,- (CL_BoPos +Bo_Diff),B_DM,-Bo_Tiefe,10,0,0,5,0,0,0,0)
END
Ebene0()
EbeneF (0,Y1,0,90 - Winkel_H,-180,7,0)
Hoehe := _EH_Rz
EbeneF (Ref_XH,Y1,_Rz,Winkel_H,- 180 - Dreh_W_H,7,0)
;++++++++++++++++++++++++++++++++++++++++++++++
;Hinten links
WZF (F_Tool,_VE,_V,_VA,_SD,_ANF,'1')
T := 110 - _WzR
IF (C1=-1)
SP (X1,0,10,0,0,_ANF,0,0,0,5,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (0,- T,0,0,10,2)
G01 (0,0,- (Hoehe -Pos1 ),0,10,0)
G01 (0,(T -_WzR) + C_Tiefe,0,0,10,2)
G01 (0,0,-1.4,0,10,2)
G01 (0,0,2.8,0,10,2)
G01 (0,0,-1.4,0,10,2)
G01 (0,- (T - _WzR +C_Tiefe),0,0,10,2)
EP (0,_ANF,0)
END
;Mitte Hinten
IF (C2=-1)
SP (X2 * -1,0,10,0,0,_ANF,0,0,0,6,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (0,- T,0,0,10,2)
G01 (0,0,- (Hoehe -Pos1 ),0,10,0)
G01 (0,(T -_WzR) + C_Tiefe,0,0,10,2)
G01 (0,0,-1.4,0,10,2)
G01 (0,0,2.8,0,10,2)
G01 (0,0,-1.4,0,10,2)
G01 (0,- (T - _WzR +C_Tiefe),0,0,10,2)
EP (0,_ANF,0)
END
;Hinten Rechts
IF (C3=-1)
SP (X3,0,10,0,0,_ANF,0,0,0,7,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (0,- T,0,0,10,2)
G01 (0,0,- (Hoehe -Pos1 ),0,10,0)
G01 (0,(T -_WzR) + C_Tiefe,0,0,10,2)
G01 (0,0,-1.4,0,10,2)
G01 (0,0,2.8,0,10,2)
G01 (0,0,-1.4,0,10,2)
G01 (0,- (T - _WzR +C_Tiefe),0,0,10,2)
EP (0,_ANF,0)
END
;Vorne
EbeneF (0,Y4,0,Winkel_V,0,1,0)
Hoehe := _EH_Rz
EbeneF (Ref_XV,Y4,_Rz,90-Winkel_V,0 + Dreh_W_V,1,0)
;Vorne links
IF (C4=-1)
SP (X4,0,10,0,0,_ANF,0,0,0,7,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (0,- T,0,0,10,2)
G01 (0,0,- (Hoehe -Pos1 ),0,10,0)
G01 (0,(T -_WzR) + C_Tiefe,0,0,10,2)
G01 (0,0,-1.4,0,10,2)
G01 (0,0,2.8,0,10,2)
G01 (0,0,-1.4,0,10,2)
G01 (0,- (T - _WzR +C_Tiefe),0,0,10,2)
EP (0,_ANF,0)
END
;Vorne mitte
IF (C5=-1)
SP (X5,0,10,0,0,_ANF,0,0,0,2,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (0,- T,0,0,10,2)
G01 (0,0,- (Hoehe -Pos1 ),0,10,0)
G01 (0,(T -_WzR) + C_Tiefe,0,0,10,2)
G01 (0,0,-1.4,0,10,2)
G01 (0,0,2.8,0,10,2)
G01 (0,0,-1.4,0,10,2)
G01 (0,- (T - _WzR +C_Tiefe),0,0,10,2)
EP (0,_ANF,0)
END
;Vorne rechts
IF (C6=-1)
SP (X6,0,10,0,0,_ANF,0,0,0,3,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (0,- T,0,0,10,2)
G01 (0,0,- (Hoehe -Pos1 ),0,10,0)
G01 (0,(T -_WzR) + C_Tiefe,0,0,10,2)
G01 (0,0,-1.4,0,10,2)
G01 (0,0,2.8,0,10,2)
G01 (0,0,-1.4,0,10,2)
G01 (0,- (T - _WzR +C_Tiefe),0,0,10,2)
EP (0,_ANF,0)
END
Ebene0()
