;MAKROTYP=1
;INSTVERSION=
;EXEVERSION=7.0.2.1[Hops.exe]
;BILD=CLAMEX1_STUMPF_X.WMF
;INFO=
;WZGV=7225K_138
;WZGVCONFIG=
;MASCHINE=HOLZHER
;NCNAME=Clamex1_Stumpf_X
;KOMMENTAR=
;DX=0
;DY=0
;DZ=0
;DIALOGDLL=DialogBA_7.Dll
;DIALOGPROC=ShowTClamex_FDialog_X
;DIALOGKIND=0
;AUTOSCRIPTSTART=1
;BUTTONBILD=
;DIMENSION_UNIT=0
VARS
   CLAMEX_ID := 1108;*VAR*Fräswkz
   CLAMEX_ID_H := 1108;*VAR*Fräswkz horizontal
   Clamex_B_ID := 1102;*VAR*Bohrwkz
   Art := 1;*VAR*0 = stirnseitig (mitLoch) / 1 = Flachseitig (Ohne Loch)
   B_Pos := 7.5;*VAR*Bohrposition
   B_DM := 7;*VAR*BohrungsDM
   C_TIEFE := 14.00;*VAR*Clamex Tiefe
   ESXY1 := 7;Easy Snap li hi
   ESXY2 := 6;Easy Snap li mi
   ESXY3 := 5;Easy Snap li vo
   ESXY4 := 1;Easy Snap re hi
   ESXY5 := 2;Easy Snap re mi
   ESXY6 := 3;Easy Snap re vo
   EX1 := 60.00;*VAR*Pos X
   EY1 := _RZ/2;*VAR*Pos Y
   EX2 := 0.00;*VAR*Pos X
   EY2 := _RZ/2;*VAR*Pos Y
   EX3 := 60.00;*VAR*Pos X
   EY3 := _RZ/2;*VAR*Pos Y
   EX4 := 60.00;*VAR*Pos X
   EY4 := _RZ/2;*VAR*Pos Y
   EX5 := 0.00;*VAR*Pos X
   EY5 := _RZ/2;*VAR*Pos Y
   EX6 := 60.00;*VAR*Pos X
   EY6 := _RZ/2;*VAR*Pos Y
   C1 := -1;*VAR*Clamex1
   C2 := 0;*VAR*Clamex2
   C3 := -1;*VAR*Clamex3
   C4 := -1;*VAR*Clamex4
   C5 := 0;*VAR*Clamex5
   C6 := -1;*VAR*Clamex6
   RIL := 0;*VAR*Richtlamelle
   C_Typ := 1;*VAR*Clamex Typ
   Tenso := 0;*VAR*Clamex Tenso ja nein
   T := 0;Tiefe fräsung
   Absenken := 0;*VAR*Ohne absenken zwische den Fräsungen
   Stl_Typ := 'P14_Of.stl';Clamex Typ
START
Fertigteil (500,500,19,0,0,0,0,0,'',0,0,0)
;Stinrseitig
WZF (CLAMEX_ID_H,_VE,_V,_VA,_SD,_ANF,'1')
IF (Art=1) & ((C_Typ=4)|(C_Typ=2))
T := _WzR - 10
ELSE
T := _WzR - C_Tiefe
END
IF Art = 0
IF Tenso = 0
WZB (Clamex_B_ID,_VE,_V,_VA,_SD,_ANF,'1')
IF C1=-1
;Linke Seite hi bohren
Bohrung(EX1,B_Pos,B_DM,-(_Rz/2),10,0,0,ESXY1,0,0,0,0)
END
IF C2=-1
;Hinten mi bohren
;Richtlamelle ohne Bohrung
IF Ril = 0
Bohrung(EX2,B_Pos,B_DM,-(_Rz/2),10,0,0,ESXY2,0,0,0,0)
END
END
IF C3=-1
;Hinten rechts bohren
Bohrung(EX3,B_Pos,B_DM,-(_Rz/2),10,0,0,ESXY3,0,0,0,0)
END
IF C4=-1
;Vorne links bohren
Bohrung(EX4,B_Pos,B_DM,-(_Rz/2),10,0,0,ESXY4,0,0,0,0)
END
IF C5=-1
;Vorne mitte bohren
;Richtlamelle ohne Bohrung
IF Ril = 0
Bohrung(EX5,B_Pos,B_DM,-(_Rz/2),10,0,0,ESXY5,0,0,0,0)
END
END
IF C6=-1
;Vorne rechts bohren
Bohrung(EX6,B_Pos,B_DM,-(_Rz/2),10,0,0,ESXY6,0,0,0,0)
END
;Ende Bohren
END
;Bild einfügen
IF C1= -1
;Links hinten
EbeneF (0,0,0,0,0,7,2)
ZSTL (EX1,0,-EY1,1973790,1,STL_Typ,7,0)
Ebene0()
END
IF C2= -1
;Hinten mitte
EbeneF (0,0,0,0,0,7,2)
ZSTL (EX2,0,-EY2,1973790,1,STL_Typ,6,0)
Ebene0()
END
IF C3= -1
;Hinten rechts
EbeneF (0,0,0,0,0,7,2)
ZSTL (EX3,0,-EY3,1973790,1,STL_Typ,5,0)
Ebene0()
END
IF C4= -1
;Links vorne
EbeneF (0,0,0,0,180,3,2)
ZSTL (EX4,0,-EY4,1973790,1,STL_Typ,5,0)
Ebene0()
END
IF C5= -1
;Rechts  mitte
EbeneF (0,0,0,0,180,3,2)
ZSTL (EX5 * -1,0,-EY5,1973790,1,STL_Typ,6,0)
Ebene0()
END
IF C6= -1
;Rechts vorne
EbeneF (0,0,0,0,180,3,2)
ZSTL (EX6,0,-EY6,1973790,1,STL_Typ,7,0)
Ebene0()
END
WZF (CLAMEX_ID_H,_VE,_V,_VA,_SD,_ANF,'1')
IF C1=-1
;Links hinten
SP (EX1,-70,-EY1,0,0,_ANF,0,0,0,7,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX1,-T,0,0,7,2)
G01 (EX1,-T,-1.4,0,7,2)
G01 (EX1,-T,2.8,0,7,2)
G01 (EX1,-T,-1.4,0,7,2)
G01 (EX1,-70,0,0,7,2)
IF Absenken = -1
IF C2=-1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V*5)
IF RIL= -1
G01 (EX2,-70,- EY2,0,6,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX2,-T,0,0,6,2)
G01 (EX2,-70,0,0,6,2)
C2 := 0
ELSE
G01 (EX2,-70,- EY2,0,6,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX2,-T,0,0,6,2)
G01 (EX2,-T,- 1.4,0,6,2)
G01 (EX2,-T,2.8,0,6,2)
G01 (EX2,-T,-1.4,0,6,2)
G01 (EX2,-70,0,0,6,2)
C2 := 0
END
END
IF C3=-1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V*5)
G01 (EX3,-70,- EY3,0,5,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX3,-T,0,0,5,2)
G01 (EX3,-T,- 1.4,0,5,2)
G01 (EX3,-T,2.8,0,5,2)
G01 (EX3,-T,-1.4,0,5,2)
G01 (EX3,-70,0,0,5,2)
C3 := 0
END
END
EP (0,_ANF,0)
END
IF C2=-1
;Hinte mitte
IF RIL= -1
SP (EX2,-70,-EY2,0,0,_ANF,0,0,0,6,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX2,-T,0,0,6,2)
G01 (EX2,-70,0,0,6,2)
ELSE
SP (EX2,-70,-EY2,0,0,_ANF,0,0,0,6,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX2,-T,0,0,6,2)
G01 (EX2,-T,-1.4,0,6,2)
G01 (EX2,-T,2.8,0,6,2)
G01 (EX2,-T,-1.4,0,6,2)
G01 (EX2,-70,0,0,6,2)
END
IF Absenken = -1
IF C3=-1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V*5)
G01 (EX3,-70,- EX3,0,5,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX3,-T,0,0,5,2)
G01 (EX3,-T,-1.4,0,5,2)
G01 (EX3,-T,2.8,0,5,2)
G01 (EX3,-T,-1.4,0,5,2)
G01 (EX3,-70,0,0,5,2)
C3 := 0
END
END
EP (0,_ANF,0)
END
IF C3=-1
;Rechts hinten
SP (EX3,-70,-EY3,0,0,_ANF,0,0,0,5,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX3,-T,0,0,5,2)
G01 (EX3,-T,-1.4,0,5,2)
G01 (EX3,-T,2.8,0,5,2)
G01 (EX3,-T,-1.4,0,5,2)
G01 (EX3,-70,0,0,5,2)
EP (0,_ANF,0)
END
IF C4=-1
;Links vorne
SP (EX4,-70,-EY4,0,0,_ANF,0,0,0,1,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX4,-T,0,0,1,2)
G01 (EX4,-T,-1.4,0,1,2)
G01 (EX4,-T,2.8,0,1,2)
G01 (EX4,-T,-1.4,0,1,2)
G01 (EX4,-70,0,0,1,2)
IF Absenken = -1
IF C5=-1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V*5)
G01 (EX5,-70,-EY5,0,2,0)
IF RIL = -1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX5,-T,0,0,2,2)
G01 (EX5,-70,0,0,2,2)
C5 := 0
ELSE
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX5,-T,0,0,2,2)
G01 (EX5,-T,- 1.4,0,2,2)
G01 (EX5,-T,2.8,0,2,2)
G01 (EX5,-T,-1.4,0,2,2)
G01 (EX5,-70,0,0,2,2)
C5 := 0
END
END
IF C6=-1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V*5)
G01 (EX6,-70,-EY6,0,3,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX6,-T,0,0,3,2)
G01 (EX6,-T,-1.4,0,3,2)
G01 (EX6,-T,2.8,0,3,2)
G01 (EX6,-T,-1.4,0,3,2)
G01 (EX6,-70,0,0,3,2)
C6 := 0
END
END
EP (0,_ANF,0)
END
IF C5=-1
;Vorne mitte
IF RIL = -1
SP (EX5,-70,-EY5,0,0,_ANF,0,0,0,2,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX5,-T,0,0,2,2)
G01 (EX5,-70,0,0,2,2)
ELSE
SP (EX5,-70,-EY5,0,0,_ANF,0,0,0,2,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX5,-T,0,0,2,2)
G01 (EX5,-T,-1.4,0,2,2)
G01 (EX5,-T,2.8,0,2,2)
G01 (EX5,-T,-1.4,0,2,2)
G01 (EX5,-70,0,0,2,2)
END
IF Absenken = -1
IF C6=-1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V*5)
G01 (EX6,-70,-EY6,0,3,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX6,-T,0,0,3,2)
G01 (EX6,-T,-1.4,0,3,2)
G01 (EX6,-T,2.8,0,3,2)
G01 (EX6,-T,-1.4,0,3,2)
G01 (EX6,-70,0,0,3,2)
C6 := 0
END
END
EP (0,_ANF,0)
END
IF C6=-1
SP (EX6,-70,-EY6,0,0,_ANF,0,0,0,3,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX6,-T,0,0,3,2)
G01 (EX6,-T,-1.4,0,3,2)
G01 (EX6,-T,2.8,0,3,2)
G01 (EX6,-T,-1.4,0,3,2)
G01 (EX6,-70,0,0,3,2)
EP (0,_ANF,0)
END
ELSE
;Flachseitig
IF C1= -1
;Hinten links
Ebene0()
ZRechteck (EX1-35.8,EY1+ 3.5,71.6,7,0,32896,7)
Ebene3()
ZSTL (EX1,0,-EY1,1973790,1,STL_Typ,5,0)
Ebene0()
END
IF C2= -1
;Hinten mitte
Ebene0()
ZRechteck (EX2-35.8,EY2+ 3.5,71.6,7,0,32896,6)
Ebene3()
ZSTL (EX2  *-1,0,-EY2,1973790,1,STL_Typ,6,0)
Ebene0()
END
IF C3= -1
;Hinten rechts
Ebene0()
ZRechteck (EX3+35.8,EY3+ 3.5,71.6,7,0,32896,5)
Ebene3()
ZSTL (EX3,0,-EY3,1973790,1,STL_Typ,7,0)
Ebene0()
END
IF C4= -1
;Vorne links
Ebene0()
ZRechteck (EX4-35.8,EY4 -  3.5,71.6,7,0,32896,1)
Ebene1()
ZSTL (EX4,0,- EY4,1973790,1,STL_Typ,7,0)
Ebene0()
END
IF C5= -1
;Vorne mitte
Ebene0()
ZRechteck (EX5-35.8,EY5 - 3.5,71.6,7,0,32896,2)
Ebene1()
ZSTL (EX5,0,- EY5,1973790,1,STL_Typ,6,0)
Ebene0()
END
IF C6= -1
;Vorne rechts
Ebene0()
ZRechteck (EX6 +35.8,EY6 - 3.5,71.6,7,0,32896,3)
Ebene1()
ZSTL (EX6,0,- EY6,1973790,1,STL_Typ,5,0)
Ebene0()
END
WZF (Clamex_ID,_VE,_V,_VA,_SD,_ANF,'1')
IF C1=-1
;Links hinten
Ebene3()
SP (EX1,-70,- EY1,0,0,_ANF,0,0,0,5,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX1,-T,- EY1,0,5,0)
G01 (EX1,-T,- (EY1 - 1.4),0,5,0)
G01 (EX1,-T,- (EY1 + 1.4),0,5,0)
G01 (EX1,-T,- (EY1),0,5,0)
G01 (EX1,-70,- (EY1),0,5,0)
C1 := 0
IF Absenken = -1
IF C2=-1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V*5)
IF RIL = -1
G01 ((EX2* -1),-70,- (EY2 ),0,6,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 ((EX2* -1),-T,- (EY2 ),0,6,0)
G01 ((EX2* -1),-70,- (EY2 ),0,6,0)
C2 := 0
ELSE
G01 ((EX2* -1),-70,- (EY2 ),0,6,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 ((EX2* -1),-T,- (EY2 ),0,6,0)
G01 ((EX2* -1),-T,- (EY2 -1.4),0,6,0)
G01 ((EX2* -1),-T,- (EY2+1.4),0,6,0)
G01 ((EX2* -1),-T,- (EY2 ),0,6,0)
G01 ((EX2* -1),-70,- (EY2 ),0,6,0)
C2 := 0
END
END
IF C3=-1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V*5)
G01 (EX3,-70,- (EY3),0,7,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX3,-T,- (EY3 ),0,7,0)
G01 (EX3,-T,- (EY3-1.4 ),0,7,0)
G01 (EX3,-T,- (EY3 +1.4),0,7,0)
G01 (EX3,-T,- (EY3 ),0,7,0)
G01 (EX3,-70,- (EY3 ),0,7,0)
C3 := 0
END
END
EP (0,_ANF,0)
Ebene0()
END
IF C2=-1
;Hinten mitte easy snap -2
Ebene3()
IF RIL = -1
SP ((EX2* -1),-70,- EY2,0,0,_ANF,0,0,0,6,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 ((EX2* -1),-T,- EY2,0,6,0)
G01 ((EX2* -1),-70,- (EY2),0,6,0)
ELSE
SP ((EX2* -1),-70,- EY2,0,0,_ANF,0,0,0,6,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 ((EX2* -1),-T,- EY2,0,6,0)
G01 ((EX2* -1),-T,- (EY2-1.4),0,6,0)
G01 ((EX2* -1),-T,- (EY2+1.4),0,6,0)
G01 ((EX2* -1),-T,- (EY2),0,6,0)
G01 ((EX2* -1),-70,- (EY2),0,6,0)
END
IF Absenken = -1
IF C3=-1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V*5)
G01 (EX3,-70,- (EX3),0,7,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX3,-T,- (EY3),0,7,0)
G01 (EX3,-T,- (EY3-1.4),0,7,0)
G01 (EX3,-T,- (EY3+1.4),0,7,0)
G01 (EX3,-T,- (EY3),0,7,0)
G01 (EX3,-70,- (EY3),0,7,0)
C3 := 0
END
END
EP (0,_ANF,0)
Ebene0()
END
IF C3=-1
;Hinten rechts
Ebene3()
SP (EX3,-70,- EY3,0,0,_ANF,0,0,0,7,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX3,-T,- EY3,0,7,0)
G01 (EX3,-T,- (EY3-1.4),0,7,0)
G01 (EX3,-T,- (EY3 + 1.4),0,7,0)
G01 (EX3,-T,- EY3,0,7,0)
G01 (EX3,-70,- EY3,0,7,0)
EP (0,_ANF,0)
END
IF C4=-1
;Links vorne
Ebene1()
SP (EX4,-70,- EY4,0,0,_ANF,0,0,0,7,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX4,-T,- EY4,0,7,0)
G01 (EX4,-T,- (EY4 - 1.4),0,7,0)
G01 (EX4,-T,- (EY4 + 1.4),0,7,0)
G01 (EX4,-T,- EY4,0,7,0)
G01 (EX4,-70,- EY4,0,7,0)
C4 := 0
IF Absenken = -1
IF C5=-1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V*5)
IF RIL = -1
G01 (EX5,-70,-EY5,0,6,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX5,-T,-EY5,0,6,0)
G01 (EX5,-70,-EY5,0,6,0)
C5 :=0
ELSE
G01 (EX5,-70,-EY5,0,6,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX5,-T,- (EY5),0,6,0)
G01 (EX5,-T,- (EY5 -1.4),0,6,0)
G01 (EX5,-T,- (EY5 + 1.4),0,6,0)
G01 (EX5,-T,-EY5,0,6,0)
G01 (EX5,-70,-EY5,0,6,0)
C5 := 0
END
END
IF C6=-1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V*5)
G01 (EX6,-70,-EY6,0,5,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX6,-T,-EY6,0,5,0)
G01 (EX6,-T,- (EY6 - 1.4),0,5,0)
G01 (EX6,-T,-(EY6 + 1.4),0,5,0)
G01 (EX6,-T,-EY6,0,5,0)
G01 (EX6,-70,-EY6,0,5,0)
C6 := 0
END
END
EP (0,_ANF,0)
Ebene0()
END
IF C5=-1
;Vorne mitte
Ebene1()
IF RIL = -1
SP (EX5,-70,- EY5,0,0,_ANF,0,0,0,6,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX5,-T,- EY5,0,6,0)
G01 (EX5,-70,- EY5,0,6,0)
ELSE
SP (EX5,-70,- EY5,0,0,_ANF,0,0,0,6,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX5,-T,- EY5,0,6,0)
G01 (EX5,-T,- (EY5 -1.4),0,6,0)
G01 (EX5,-T,- (EY5 +1.4),0,6,0)
G01 (EX5,-T,- EY5,0,6,0)
G01 (EX5,-70,- EY5,0,6,0)
END
IF Absenken = -1
IF C6=-1
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V*5)
G01 (EX6,-70,- EY6,0,5,0)
CALL _Tvorschub_v5 ( VAL VORSCHUB:=_V)
G01 (EX6,-T,- EY6,0,5,0)
G01 (EX6,-T,- (EY6 - 1.4),0,5,0)
G01 (EX6,-T,- (EY6 +1.4),0,5,0)
G01 (EX6,-T,- EY6,0,5,0)
G01 (EX6,-70,- EY6,0,5,0)
C6 := 0
END
END
EP (0,_ANF,0)
Ebene0()
END
IF C6=-1
;Rechts vorne
Ebene1()
SP (EX6,-70,- EY6,0,0,_ANF,0,0,0,5,0,0,0,_AT_MAXDEPTH,0,0,0,0,0,0,0,0,0)
G01 (EX6,-T,- EY6,0,5,0)
G01 (EX6,-T,- (EY6 -1.4),0,5,0)
G01 (EX6,-T,- (EY6 + 1.4),0,5,0)
G01 (EX6,-T,- EY6,0,5,0)
G01 (EX6,-70,- EY6,0,5,0)
EP (0,_ANF,0)
END
END
Ebene0()
