   Vers := 0;Versatz flächenbündig
START
Fertigteil (DX,DY,DZ,0,0,0,0,0,'',0,0,0)
; Cabineo  Holzher Schweiz AG   (B. Achermann)
;Spanner fraesen oder bohren
IF Typ=0
IF FL=0
Tiefe_S := Tiefe_1* -1
VerS := 0.0
END
IF FL=1
Tiefe_S := Tiefe_2* -1
Tiefe_FLa := Tiefe2_1 *-1
VerS := D_Cover_1
END
IF FL=2
Tiefe_S := Tiefe_3* -1
Tiefe_FLa := Tiefe2_2 *-1
VerS := D_Cover_2
END
IF FL=3
Tiefe_S := Tiefe_4* -1
VerS := 0.0
END
WZF (Ca_Tool,_VE,_V,_VA,_SD,_ANF,'1')
IF Ca_Tool = 501
;Links hinten
IF Y1_1 = 0
Bohrung (3.6,Y1,B_Dm,Tiefe_S,B_Typ,0,0,7,0,0,0,0)
Bohrung (3.6 +11.2,Y1,B_Dm,Tiefe_S,B_Typ,0,0,7,0,0,0,0)
