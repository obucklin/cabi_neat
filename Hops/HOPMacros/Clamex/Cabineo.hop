;5mm Löcher bohren
IF Typ=1
WZF (Ca_Tool_B,_VE,_V,_VA,_SD,_ANF,'1')
;Tiefe nach Cabineo Typ 8 / 12
IF Typ_B = 0
B_Tiefe := Tiefe1_1
ELSE
B_Tiefe := Tiefe1_2
END
;Typ0 und Typ3
IF (FL = 0) | (FL = 3)
R_BDM := 5.00
IF FL = 3
R_BDM := 5.5
END
END
IF (FL = 1)
R_BDM := 5.80
END
IF (FL = 2)
R_BDM := 7.05
END
;Links oben
IF Y1_1 = 0
Bohrung (SP_Dicke - R_BDM,Y1,5.00,B_Tiefe *-1,B_Typ1,0,0,7,0,0,0,0)
